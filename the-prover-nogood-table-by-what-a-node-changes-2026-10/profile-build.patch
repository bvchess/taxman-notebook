+        "count: nogoods inside the picks",
+        "count: branching nodes with picks query",
+        "propagate: trail length",
+        "propagate: watch entries visited",
+        "propagate: members read looking for a watch",
+        "propagate: nogoods examined whole",
+        "propagate: watch moves while examining",
+    ];
+    thread_local! {
+        pub static T: RefCell<[(u64, u64); 32]> = const { RefCell::new([(0, 0); 32]) };
+        pub static PREV: RefCell<[Vec<bool>; 2]> = const { RefCell::new([Vec::new(), Vec::new()]) };
+    }
+    pub fn add(i: usize, start: std::time::Instant) {
+        let ns = start.elapsed().as_nanos() as u64;
+        T.with(|t| {
+            let mut t = t.borrow_mut();
+            t[i].0 += ns;
+            t[i].1 += 1;
+        });
+    }
+    /// Counts how much the set `now` differs from the last one given in `slot` (0: source, 1: picks).
+    pub fn track(slot: usize, now: &[bool]) {
+        PREV.with(|p| {
+            let mut p = p.borrow_mut();
+            let prev = &mut p[slot];
+            if prev.len() != now.len() {
+                *prev = vec![false; now.len()];
+            }
+            let diff = prev.iter().zip(now).filter(|(a, b)| a != b).count();
+            count(20 + 2 * slot, diff as u64);
+            count(21 + 2 * slot, now.iter().filter(|&&b| b).count() as u64);
+            prev.copy_from_slice(now);
+        });
+    }
+    pub fn count(i: usize, k: u64) {
+        T.with(|t| t.borrow_mut()[i].1 += k);
+    }
+    pub fn report() {
+        T.with(|t| {
+            let t = t.borrow();
+            let nodes = t[14].1.max(1);
+            for (i, (ns, calls)) in t.iter().enumerate() {
+                if *calls > 0 {
+                    eprintln!(
+                        "prof {:<38} {:>10.3} s {:>12} calls {:>9.1} us/node {:>10.2} per node",
+                        NAMES[i],
+                        *ns as f64 / 1e9,
+                        calls,
+                        *ns as f64 / 1e3 / nodes as f64,
+                        *calls as f64 / nodes as f64
+                    );
+                }
+            }
+        });
+    }
+}
+
+/// Times `$e` as phase `$i` of the scratch profile (nothing without the feature `profile`).
+macro_rules! timed {
+    ($i:expr, $e:expr) => {{
+        #[cfg(feature = "profile")]
+        let t0 = std::time::Instant::now();
+        let r = $e;
+        #[cfg(feature = "profile")]
+        prof::add($i, t0);
+        r
+    }};
+}
+
+/// Counts `$k` under phase `$i` of the scratch profile.
+macro_rules! counted {
+    ($i:expr, $k:expr) => {{
+        #[cfg(feature = "profile")]
+        prof::count($i, $k as u64);
+    }};
+}
