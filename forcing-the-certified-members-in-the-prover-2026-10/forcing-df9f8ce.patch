+/// With `--fix-certified 1` every line says so, a game that was searched is `"proven"` as without it, and has the
+/// members forced (at most the members of U\*_{>=3}, which are some), the rounds that found them and the seconds; a
+/// game that was not searched has them all 0.  The same games without the flag have none of the fields.  A search of
+/// this kind never resumes another's checkpoint: checkpoints of the other kinds for another target are left alone, and
+/// would stop the run if it read them.
+#[test]
+fn fixing_the_certified_members_writes_its_fields() {
+    let games = ["--list", "191,216,432"];
+    let plain = lines_in("certified_plain", &games);
+    let dir = scratch("certified");
+    let checkpoints = dir.join("checkpoints");
+    std::fs::create_dir_all(&checkpoints).expect("create the checkpoints folder");
+    let decoys: Vec<PathBuf> =
+        ["", "_low", "_upper"].iter().map(|kind| checkpoints.join(format!("exact_216{kind}.ckpt"))).collect();
+    decoys.iter().for_each(|decoy| std::fs::write(decoy, "target 1\nnodes 1\nsecs 1\n").expect("write a decoy"));
+    let output = run_exact(&dir, &[&games[..], &["--fix-certified", "1"]].concat());
+    assert!(output.status.success(), "exact: {}", String::from_utf8_lossy(&output.stderr));
+    assert!(decoys.iter().all(|decoy| decoy.exists()), "a checkpoint of another kind was resumed or removed");
+    let lines = take_lines(&dir);
+    assert_eq!(lines.len(), 3, "a line for every game");
+    let mut searched = 0;
+    for (n, line) in &lines {
+        let plain_line = &plain[n];
+        assert_eq!(field_u64(plain_line, "fix_certified"), None, "n={n}: {plain_line}");
+        assert_eq!(field_u64(plain_line, "certify_rounds"), None, "n={n}: {plain_line}");
+        assert_eq!(field_u64(line, "fix_certified"), Some(1), "n={n}: {line}");
+        assert_eq!(field_u64(line, "fix_low"), Some(1), "n={n}: {line}");
+        assert_eq!(field_str(line, "search"), field_str(plain_line, "search"), "n={n}: {line}");
+        assert_eq!(field_u64(line, "score"), field_u64(plain_line, "score"), "n={n}: {line}");
+        let field = |key| field_u64(line, key).unwrap_or_else(|| panic!("n={n}: no {key}: {line}"));
+        let (certified, members, rounds) = (field("certified"), field("members"), field("certify_rounds"));
+        assert!(field_u64(line, "certify_secs").is_some(), "n={n}: no certify_secs: {line}");
+        let bound = field_u64(line, "fixed_bound").unwrap_or_else(|| panic!("n={n}: no fixed_bound: {line}"));
+        assert!(bound >= field_u64(line, "score").unwrap(), "n={n}: the bound at the forced roles is below the score");
+        if field_str(line, "search") == Some("proven") {
+            assert!(certified <= members && members > 0 && rounds >= 1, "n={n}: {line}");
+            searched += 1;
+        } else {
+            assert_eq!((certified, members, rounds), (0, 0, 0), "n={n}: {line}");
+        }
+    }
+    assert!(searched > 0, "no game was searched");
+}
