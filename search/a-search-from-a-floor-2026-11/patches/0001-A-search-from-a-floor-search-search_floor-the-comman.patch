+// ---------------------------------------------------------------------------------------------------------
+// floor
+
+/// `floor N SCORE [options]`: whether any game of N scores more than SCORE, by a search from the floor SCORE less
+/// `in_the_bag` (`solver::floor::floor`), with `--threads`, `--tactic` and the flags of a long search; it writes no
+/// results line.  It prints one line of what the search came to and, for a game found that scores more, its moves; one
+/// that a limit or a signal stopped keeps its checkpoint, and the same command resumes it.
+pub fn floor(args: &[String]) -> CliResult {
+    let usage = || CliError::Usage("usage: floor N SCORE [options]".into());
+    let args = Args::parse(args, &flags_with(&SEARCH_FLAGS), &SEARCH_SWITCHES)?;
+    let [n, score] = args.positional() else { return Err(usage()) };
+    let bad_n = || CliError::Usage(format!("N must be a game, from 1 up: {n:?}"));
+    let n = n.parse::<u32>().ok().filter(|&n| n >= 1).ok_or_else(bad_n)?;
+    let score: u64 = score.parse().map_err(|_| CliError::Usage(format!("SCORE must be a score: {score:?}")))?;
+    let mut opts = solver_options(&args)?;
+    search_options(&args, &mut opts)?;
+    let _lock = guard_checkpoints(&opts)?;
+    let result = solver::floor::floor(n, score, &opts).map_err(failed)?;
+    outln!("{}", result.summary_line());
+    if let Some(gain) = &result.gain {
+        outln!("  moves: {:?}", gain.moves);
+    }
+    if !result.completed {
+        outln!("{}", stopped_line(n, &opts));
+    }
+    Ok(())
+}
+
