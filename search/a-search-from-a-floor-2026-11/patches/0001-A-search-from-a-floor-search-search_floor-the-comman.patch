+/// The root's GF(2) bound, the bound of the search's first node, as a promotion sum.
+fn root_bound<const W: usize>(p: &Prepared<W>) -> u64 {
+    NodeBound::new(p, &crate::gf2::Gf2Graph::new(&p.model, &p.root, &p.candidates)).root()
