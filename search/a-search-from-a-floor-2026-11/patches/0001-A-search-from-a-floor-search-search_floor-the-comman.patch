+/// The search of `p`, whose P* is `opt`, from floors around P* on `threads` threads (the floor lemma (R5)): a floor
+/// below P* finds it, a floor at it or above completes having found nothing, and a floor at the root's bound or above
+/// completes at the first step.
+fn floors_around_the_optimum<const W: usize>(p: &Prepared<W>, opt: u64, threads: usize, what: &str) {
+    let cfg = config(threads);
+    for floor in [opt - 1, opt.saturating_sub(40), 0] {
+        let r = search_floor(p, &cfg, floor, false).unwrap();
+        let what = format!("{what}, floor {floor}");
+        assert!(r.completed && !r.floor_held, "{what}: it finds a set above the floor");
+        assert_eq!((r.sum, r.promotions.sum()), (opt, opt), "{what}");
+        assert!(p.can_promote(&r.promotions), "{what}");
+        assert!(r.start.is_empty() && r.found.is_some(), "{what}: the floor is the start");
+    }
+    let root = root_bound(p);
+    assert!(opt <= root, "{what}: the root's bound {root} is below P* {opt}");
+    for floor in [opt, opt + 1, opt + (root - opt) / 2, root, root + 1] {
+        let r = search_floor(p, &cfg, floor, false).unwrap();
+        let what = format!("{what}, floor {floor}");
+        assert!(r.completed && r.floor_held, "{what}: nothing is above it");
+        assert!(r.promotions.is_empty() && r.found.is_none() && r.start.is_empty(), "{what}");
+        assert_eq!(r.sum, floor, "{what}: the incumbent is the floor");
+        if floor >= root {
+            assert!(r.stats.nodes <= 1, "{what}: {} steps at the root's bound", r.stats.nodes);
+        }
+    }
+}
+
+/// The floor lemma (R5) on every game of the Java's to 400 that needs a search, on one thread: a floor below P* finds
+/// it, one at P* or above holds, and one at the root's bound or above ends the search at once.
+#[test]
+fn a_floor_below_the_optimum_finds_it_and_one_at_it_holds() {
+    for g in &searched_games(400) {
+        let p = prepare_golden::<8>(g, SearchTactics::default());
+        floors_around_the_optimum(&p, golden_sum(g), 1, &format!("n={}", g.n));
+    }
+}
