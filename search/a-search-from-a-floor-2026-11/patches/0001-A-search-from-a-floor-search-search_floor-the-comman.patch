+/// The search of `board` set up for the run of `opts`: to resume `checkpoint` if there is one, with the tactics it
+/// records, which must be the run's but for those a checkpoint does not bind, else afresh with the run's tactics.
+fn prepare_search<const W: usize>(
+    board: &Board<W>,
+    checkpoint: Option<&Path>,
+    opts: &SolveOptions,
+) -> Result<Prepared<W>, String> {
+    let Some(path) = checkpoint else { return board.prepare(opts.tactics.search) };
+    let mut p = board
+        .prepare_for_resume(path)
+        .map_err(|e| format!("cannot resume from {}: {e} (delete the file to start the game over)", path.display()))?;
+    // A checkpoint does not bind how the searchers keep their nogoods, nor how they branch: this run says.
+    p.tactics = p.tactics.with_unbound_of(&opts.tactics.search);
+    if p.tactics != opts.tactics.search {
+        return Err(different_tactics(path, p.tactics, opts.tactics));
+    }
+    Ok(p)
+}
