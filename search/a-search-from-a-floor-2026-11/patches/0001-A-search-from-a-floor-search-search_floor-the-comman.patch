+/// `floor N SCORE` says whether any game of N scores more than SCORE: at opt(N) the floor holds, and a point below it
+/// a game that scores opt(N) beats it, printed with its moves.  It writes no results line; a search stopped by a limit
+/// keeps its checkpoint, which `solve` and another floor refuse and the same command resumes.  Its bad command lines
+/// are usage errors, and a SCORE that the moves with no promotions beat is refused.
+#[test]
+fn floor_holds_at_the_optimum_and_is_beaten_below_it() {
+    let opt = Optimal::built_in().score(800).unwrap();
+    let (at, below) = (opt.to_string(), (opt - 1).to_string());
+    let run = taxman(&["floor", "800", &at, "--threads", "2", "--progress", "0"]);
+    assert_eq!(run.code, Some(0), "{}", run.stderr);
+    assert!(run.stdout.starts_with("n=800 "), "{}", run.stdout);
+    assert!(run.stdout.contains(&format!("held: no game scores more, so opt(n) <= {opt}")), "{}", run.stdout);
+    assert_eq!(run.stdout.lines().count(), 1, "{}", run.stdout);
+
+    let run = taxman(&["floor", "800", &below, "--threads", "2", "--progress", "0"]);
+    assert_eq!(run.code, Some(0), "{}", run.stderr);
+    assert!(run.stdout.contains(&format!("beaten: a game scores {opt}, which is opt(n)")), "{}", run.stdout);
+    let moves = run.stdout.lines().find_map(|line| line.strip_prefix("  moves: [")).expect("the moves");
+    let moves: Vec<u32> = moves.trim_end_matches(']').split(", ").map(|m| m.parse().unwrap()).collect();
+    assert_eq!(taxman::game::replay(800, &moves), Ok(opt));
+
+    // Stopped by a limit (one thread checks it after 1,024 steps; the floor at opt(800) takes more), resumed.
+    let dir = TempDir::new("floor");
+    let ckpt = dir.join("ckpt");
+    let limited = ["floor", "800", &at, "--threads", "1", "--progress", "0", "--checkpoint-dir", path(&ckpt)];
+    let run = taxman(&[&limited[..], &["--node-limit", "1"]].concat());
+    assert_eq!(run.code, Some(0), "{}", run.stderr);
+    assert!(run.stdout.contains("open: the search stopped before it finished"), "{}", run.stdout);
+    assert!(run.stdout.contains("stopped: the search for n=800 hit a limit"), "{}", run.stdout);
+    assert!(ckpt.join("n0800.ckpt").exists());
+    let other = taxman(&["floor", "800", &below, "--threads", "1", "--checkpoint-dir", path(&ckpt)]);
+    assert_eq!(other.code, Some(1), "{}", other.stdout);
+    assert!(other.stderr.contains("a search from the floor") && other.stderr.contains("not from the floor"));
+    let solve = taxman(&["solve", "800", "--force-search", "--threads", "1", "--checkpoint-dir", path(&ckpt)]);
+    assert_eq!(solve.code, Some(1), "{}", solve.stdout);
+    assert!(solve.stderr.contains("not from a start"), "{}", solve.stderr);
+    let run = taxman(&limited);
+    assert_eq!(run.code, Some(0), "{}", run.stderr);
+    assert!(run.stdout.contains("held: no game scores more") && !run.stdout.contains("stopped"), "{}", run.stdout);
+    assert!(!ckpt.join("n0800.ckpt").exists() && !ckpt.join("n0800.clock").exists(), "a finished floor cleans up");
+
+    assert_usage_error(&["floor"], "usage: floor N SCORE");
+    assert_usage_error(&["floor", "800"], "usage: floor N SCORE");
+    assert_usage_error(&["floor", "0", "5"], "N must be a game");
+    assert_usage_error(&["floor", "800", "many"], "SCORE must be a score");
+    assert_usage_error(&["floor", "800", &at, "--out", "x"], "unknown option --out");
+    let run = taxman(&["floor", "800", "1"]);
+    assert_eq!(run.code, Some(1), "{}", run.stdout);
+    assert!(run.stderr.contains("the moves with no promotions score"), "{}", run.stderr);
+}
