+//! A search from a floor (`taxman floor N SCORE`): does any game of n score more than SCORE?
+//!
+//! The board is set up as the per-game pipeline sets it up (its frames, [`Board::prepare`], or
+//! [`Board::prepare_for_resume`] when the game has a checkpoint), and the exact search runs from the floor SCORE less
+//! `in_the_bag`, a promotion sum, with no start, no seed, no ceiling and no finder ([`search::search_floor`]).  If it
+//! completes having found no promotion set heavier than the floor, no game of n scores more than SCORE, so opt(n) ≤
+//! SCORE (the floor lemma (R5), docs/theory/search-rules.md, with the exactness theorem, which makes the frame model's
+//! best promotion sum plus `in_the_bag` opt(n)).  A set it finds is a real game that scores more, and if the search
+//! completes, the last one it found is optimal (R5, part 2).
+//!
+//! A held floor is a bound and not a game, so nothing is written to a results file.  The search keeps its checkpoint
+//! and clock (`nNNNN.ckpt` and `nNNNN.clock`) in the checkpoint directory, as a game of `solve` does; its header
+//! records the floor, so it resumes only under the same SCORE, and neither a `solve` of the game nor another floor
+//! takes it.  A completed search deletes them.
+//!
+//! Every outcome is checked: the moves of a set found replay legally to `in_the_bag` plus its promotions, and where
+//! the table built into the binary has the game, a floor that held must be at least its score, and a set found no
+//! more than it, and equal to it once the search completed.
+
+use super::{clock, prepare_search, spill_dir, SolveOptions, MAX_N};
+use crate::accelerate::solution_for_promotions;
+use crate::bits::words_for;
+use crate::board::Board;
+use crate::engine::{EngineConfig, Spent};
+use crate::game::{replay, Optimal};
+use crate::gf2::Gf2Graph;
+use crate::numtheory::Tables;
+use crate::search::{self, NodeBound};
+use std::fs;
+use std::time::{Duration, Instant};
+
+/// A game that scores more than the floor's SCORE, found by the search.
+#[derive(Clone, Debug)]
+pub struct Gain {
+    pub score: u64,
+    pub moves: Vec<u32>,
+    pub promotions: Vec<u32>,
+}
+
+/// What a search from a floor came to ([`floor`]).
+#[derive(Clone, Debug)]
+pub struct FloorResult {
+    pub n: u32,
+    /// The score asked about: the search looks for a game that scores more.
+    pub score: u64,
+    /// What the moves with no promotions score; the floor of the search is `score − in_the_bag`.
+    pub in_the_bag: u64,
+    /// The root's GF(2) bound on the promotion sum ([`NodeBound::root`]); 0 on a board with no candidates.
+    pub root_bound: u64,
+    /// The search ran to its end; false when a limit or a signal stopped it, which keeps its checkpoint.
+    pub completed: bool,
+    /// The search completed and found nothing above the floor: no game of n scores more than `score`.
+    pub held: bool,
+    /// The best game found that scores more than `score`, if any: when the search completed, an optimal one.
+    pub gain: Option<Gain>,
+    /// The search's steps over all its runs.
+    pub nodes: u64,
+    /// The wall time of this invocation, setup included.
+    pub time: Duration,
+    /// What the search has spent over all its runs: its workers' CPU time, and the time it was active.
+    pub spent: Spent,
+}
+
+impl FloorResult {
+    /// The floor of the search, a promotion sum.
+    pub fn floor(&self) -> u64 {
+        self.score - self.in_the_bag
+    }
+
+    /// The line that says what the search came to, with its counts.
+    pub fn summary_line(&self) -> String {
+        let outcome = match (&self.gain, self.held, self.completed) {
+            (_, true, _) => format!("held: no game scores more, so opt(n) <= {}", self.score),
+            (Some(gain), _, true) => format!("beaten: a game scores {}, which is opt(n)", gain.score),
+            (Some(gain), _, false) => format!("beaten: a game scores {}, so opt(n) >= {}", gain.score, gain.score),
+            (None, _, _) => "open: the search stopped before it finished, with nothing above the floor".to_owned(),
+        };
+        format!(
+            "n={:<5} score={:<9} {outcome}  floor={} root_bound={} nodes={} {:.3} s  active={:.3} s  cpu={:.3} s",
+            self.n,
+            self.score,
+            self.floor(),
+            self.root_bound,
+            self.nodes,
+            self.time.as_secs_f64(),
+            self.spent.active.as_secs_f64(),
+            self.spent.cpu.as_secs_f64()
+        )
+    }
+}
+
+/// Searches game `n` from the floor `score − in_the_bag` with the options `opts` (the tactics, the threads, the
+/// checkpoints, the progress lines, the limits, the priority and the memory; the finder, the gate trial, the profile,
+/// the carried nogoods and the window play no part), resuming the game's checkpoint if there is one.
+///
+/// # Errors
+///
+/// If `n` is beyond the largest board, `score` is below what the moves with no promotions score (they beat it), the
+/// checkpoint is another search's, the search fails, or a check of the outcome fails (the module documentation).
+pub fn floor(n: u32, score: u64, opts: &SolveOptions) -> Result<FloorResult, String> {
+    let beyond = || format!("n={n} is beyond the largest supported board, n={MAX_N}");
+    type Run = fn(u32, u64, &SolveOptions) -> Result<FloorResult, String>;
+    let run: Run = crate::with_words!(words_for(n), W => floor_with_width::<W>, else return Err(beyond()));
+    run(n, score, opts).map_err(|e| format!("n={n}: {e}"))
+}
+
+fn floor_with_width<const W: usize>(n: u32, score: u64, opts: &SolveOptions) -> Result<FloorResult, String> {
+    let t0 = Instant::now();
+    let board = Board::<W>::new(Tables::new(n));
+    let in_the_bag = board.in_the_bag;
+    let Some(floor) = score.checked_sub(in_the_bag) else {
+        return Err(format!("the moves with no promotions score {in_the_bag}, more than {score}"));
+    };
+    let mut result = FloorResult {
+        n,
+        score,
+        in_the_bag,
+        root_bound: 0,
+        completed: true,
+        held: true,
+        gain: None,
+        nodes: 0,
+        time: Duration::ZERO,
+        spent: Spent::default(),
+    };
+    // With no candidates the moves with no promotions are the only ones, and they score no more than `score`.
+    if !board.is_trivial() {
+        let checkpoint = opts.checkpoint_file(n).filter(|path| path.exists());
+        let prepared = prepare_search(&board, checkpoint.as_deref(), opts)?;
+        let graph = Gf2Graph::new(&prepared.model, &prepared.root, &prepared.candidates);
+        result.root_bound = NodeBound::new(&prepared, &graph).root();
+        let earlier = clock::resume(opts, n);
+        let (spill_dir, _) = spill_dir(opts, n);
+        let cfg = EngineConfig {
+            threads: opts.threads,
+            queue_mem_cap: opts.queue_mem_cap,
+            spill_dir: Some(spill_dir.clone()),
+            checkpoint: opts.checkpoint_file(n).map(|path| (path, opts.checkpoint_interval)),
+            // A completed search has nothing to keep: its outcome is the bound or the game it prints.
+            keep_completed_checkpoint: false,
+            progress: opts.progress,
+            time_limit: opts.time_limit,
+            node_limit: opts.node_limit,
+            label: format!("n={n} floor={floor}"),
+            background: opts.background,
+            ..EngineConfig::default()
+        };
+        let found = search::search_floor(&prepared, &cfg, floor, checkpoint.is_some());
+        if opts.spill_dir.is_none() {
+            // The search's own, or the checkpoint directory's: removed only if the engine left nothing in it.
+            let _ = fs::remove_dir(&spill_dir);
+        }
+        let found = found.map_err(|e| format!("search failed: {e}"))?;
+        result.spent = earlier + Spent { cpu: found.counters.cpu, active: found.time, waiting: Duration::ZERO };
+        if found.completed {
+            clock::forget(opts, n);
+        } else {
+            clock::keep(opts, n, result.spent);
+        }
+        result.completed = found.completed;
+        result.held = found.floor_held;
+        result.nodes = found.stats.nodes;
+        if !found.floor_held && found.sum > floor {
+            let moves = solution_for_promotions::<W>(&board.tables, found.promotions);
+            result.gain = Some(Gain { score: in_the_bag + found.sum, moves, promotions: found.promotions.to_vec() });
+        }
+    }
+    result.time = t0.elapsed();
+    check(&result, Optimal::built_in())?;
+    Ok(result)
+}
+
+/// The checks of the outcome `result` (the module documentation), with `table` as the table of optimal moves.
+fn check(result: &FloorResult, table: &Optimal) -> Result<(), String> {
+    let n = result.n;
+    if let Some(gain) = &result.gain {
+        let replayed = replay(n, &gain.moves).map_err(|e| format!("the moves found do not replay: {e}"))?;
+        let promised = result.in_the_bag + gain.promotions.iter().map(|&p| u64::from(p)).sum::<u64>();
+        if replayed != promised || gain.score != promised {
+            return Err(format!("the moves found score {replayed}, not the {promised} that their promotions give"));
+        }
+        if gain.score <= result.score {
+            return Err(format!("the moves found score {}, no more than {}", gain.score, result.score));
+        }
+    }
+    let Some(opt) = table.score(n) else { return Ok(()) };
+    let contradiction = match &result.gain {
+        _ if result.held && opt > result.score => Some(format!("the floor held, but opt(n) is {opt}")),
+        Some(gain) if gain.score > opt => Some(format!("moves were found that score {}, more than opt(n)", gain.score)),
+        Some(gain) if result.completed && gain.score < opt => {
+            Some(format!("the search completed at {}, below opt(n)", gain.score))
+        }
+        _ => None,
+    };
+    match contradiction {
+        Some(what) => Err(format!("{what}, {opt} in the table built into this program")),
+        None => Ok(()),
+    }
+}
