+// ---------------------------------------------------------------------------------------------------------------
+// The test at a node of the frame solver's search (E2, the study's report, Section 7.3)
+
+/// One sampled node of a proof, a line of the file of `--nodes`: `ID BAND GAP BEST SUM CAP SIZE REST PROMOTED CANDS`.
+/// GAP is the node's bound less the incumbent, less one (the solver's gap: its bound less its need); BEST the
+/// incumbent's promotion sum; SUM the sum of the node's promotions; CAP the most promotions that a completion of it
+/// can add; SIZE the steps in the subtree of the child of the step sampled; REST the steps in the node's loop from that
+/// step on; PROMOTED and CANDS the numbers of the node's picks and of its candidates (`-` for none).  Anything of the
+/// candidates of the board that is neither is barred.
+struct SampledNode {
+    id: String,
+    band: String,
+    gap: u64,
+    best: u64,
+    cap: u32,
+    size: u64,
+    rest: u64,
+    promoted: Vec<u32>,
+    cands: Vec<u32>,
+}
+
+fn read_nodes(path: &str) -> Result<Vec<SampledNode>, String> {
+    let text = std::fs::read_to_string(path).map_err(|e| format!("{path}: {e}"))?;
+    let list = |s: &str| -> Result<Vec<u32>, String> {
+        if s == "-" {
+            return Ok(Vec::new());
+        }
+        s.split(',').map(|x| x.parse::<u32>().map_err(|e| format!("{x}: {e}"))).collect()
+    };
+    let num = |s: &str| s.trim_end_matches('+').parse::<u64>().map_err(|e| format!("{s}: {e}"));
+    let mut nodes = Vec::new();
+    for line in text.lines().filter(|line| !line.trim().is_empty()) {
+        let f: Vec<&str> = line.split_whitespace().collect();
+        if f.len() != 10 {
+            return Err(format!("a line of --nodes has 10 fields: {line:.60}"));
+        }
+        nodes.push(SampledNode {
+            id: f[0].into(),
+            band: f[1].into(),
+            gap: num(f[2])?,
+            best: num(f[3])?,
+            cap: num(f[5])? as u32,
+            size: num(f[6])?,
+            rest: num(f[7])?,
+            promoted: list(f[8])?,
+            cands: list(f[9])?,
+        });
+    }
+    Ok(nodes)
+}
+
+/// What the depth-first smooth test found at a node.
+struct NodeTest {
+    /// The bound of the node with its fixings and cap, as a score: what the frame solver's bound is when the cap is its.
+    root: u64,
+    /// Every set of the node above the incumbent has a smooth sub-instance that is not playable: the node is cut.
+    cut: bool,
+    /// The weight of the smooth-playable set above the incumbent that stopped the test, if one did.
+    leaf: Option<u64>,
+    /// The budget of solves ran out.
+    over_budget: bool,
+    solves: u64,
+    processed: u64,
+    /// The largest bound still open at the stop: the incumbent if the node was cut.
+    upper: u64,
+    seconds: f64,
+}
+
+/// The test at `node`: a depth-first branch and bound over the smooth conflicts, as E1's, from the node's picks and
+/// bars with the node's cap and the incumbent as the target, the child of the largest key first.  It stops when no
+/// node is open above the incumbent (the node is cut), at the first smooth-playable set above it (it is not), or when
+/// `budget` GF(2) solves are used.
+fn test_node<const W: usize>(w: &mut Worker<'_, W>, node: &SampledNode, budget: u64) -> NodeTest {
+    let clock = Instant::now();
+    let p = w.p;
+    let target = p.in_the_bag + node.best;
+    let promoted: Bits<W> = Bits::from_slice(&node.promoted);
+    let cands: Bits<W> = Bits::from_slice(&node.cands);
+    let bars: Vec<u32> = (p.ground - promoted - cands).iter().collect();
+    w.node_cap = Some((node.cap, node.promoted.len()));
+    w.solves = 0;
+    let (root, first) = w.process(&node.promoted, &bars, target);
+    let mut stack: Vec<(u64, Vec<u32>, Vec<u32>)> = Vec::new();
+    let (mut cut, mut leaf, mut over_budget, mut processed) = (false, None, false, 1);
+    let mut done = Some(first);
+    loop {
+        // What the node just processed leaves to do.
+        match done.take() {
+            None | Some(Outcome::Cut) => {}
+            Some(Outcome::Leaf(total, _)) => {
+                leaf = Some(total);
+                break;
+            }
+            Some(Outcome::Children(mut children, _, _)) => {
+                children.sort_by_key(|c| c.0);
+                stack.extend(children.into_iter().filter(|c| c.0 > target));
+            }
+        }
+        if w.solves >= budget {
+            over_budget = true;
+            break;
+        }
+        let Some((_, picks, bars)) = stack.pop() else {
+            cut = true;
+            break;
+        };
+        processed += 1;
+        done = Some(w.process(&picks, &bars, target).1);
+    }
+    let open = stack.iter().map(|c| c.0).max().unwrap_or(0);
+    let upper = if cut { target } else { open.max(leaf.unwrap_or(0)) };
+    NodeTest {
+        root,
+        cut,
+        leaf,
+        over_budget,
+        solves: w.solves,
+        processed,
+        upper,
+        seconds: clock.elapsed().as_secs_f64(),
+    }
+}
+
+/// The test at every node of the file `file`, `--threads` at a time, one JSON line each on stdout.
+fn run_nodes<'g, const W: usize>(args: &Args, file: &str, problem: &'g Problem<'g, W>) -> Result<(), String> {
+    let nodes = read_nodes(file)?;
+    for node in &nodes {
+        let all: Bits<W> = Bits::from_slice(&node.promoted) | Bits::from_slice(&node.cands);
+        if !all.is_subset(&problem.ground) {
+            return Err(format!("node {}: a number that is no candidate of the board", node.id));
+        }
+    }
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    let out = Mutex::new(std::io::stdout());
+    std::thread::scope(|scope| {
+        for t in 0..args.threads {
+            let (nodes, next, out) = (&nodes, &next, &out);
+            scope.spawn(move || {
+                let mut worker = Worker::new(problem, 100 + t as u64);
+                while let Some(node) = nodes.get(next.fetch_add(1, std::sync::atomic::Ordering::SeqCst)) {
+                    let r = test_node(&mut worker, node, args.budget);
+                    // The bound the frame solver took at the node: the incumbent and the gap, as a score.
+                    let solver = problem.in_the_bag + node.best + node.gap + 1;
+                    let line = format!(
+                        concat!(
+                            "{{\"id\":\"{}\",\"band\":{},\"gap\":{},\"size\":{},\"rest\":{},\"picks\":{},\"cap\":{},",
+                            "\"bound_solver\":{},\"bound_e1\":{},\"cut\":{},\"leaf\":{},\"over_budget\":{},",
+                            "\"solves\":{},\"processed\":{},\"upper\":{},\"target\":{},\"seconds\":{:.3}}}"
+                        ),
+                        node.id,
+                        node.band,
+                        node.gap + 1,
+                        node.size,
+                        node.rest,
+                        node.promoted.len(),
+                        node.cap,
+                        solver,
+                        r.root,
+                        r.cut,
+                        r.leaf.map_or("null".to_string(), |l| l.to_string()),
+                        r.over_budget,
+                        r.solves,
+                        r.processed,
+                        r.upper,
+                        problem.in_the_bag + node.best,
+                        r.seconds
+                    );
+                    let mut out = out.lock().unwrap();
+                    writeln!(out, "{line}").unwrap();
+                    out.flush().unwrap();
+                }
+            });
+        }
+    });
+    Ok(())
+}
