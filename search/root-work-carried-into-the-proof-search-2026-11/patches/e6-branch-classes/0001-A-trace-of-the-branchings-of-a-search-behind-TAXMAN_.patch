@@ -0,0 +1,155 @@
+//! A trace of the branchings of a search, for the study of which members a node's conflict holds and which one it
+//! branches on (experiment E6).  It observes the search and changes nothing of it, and it is off unless the environment
+//! variable [`ENV`] names a file prefix: each searcher of the search then writes the file `PREFIX.K.txt`, K its number,
+//! and the finder's searchers write none.  `PREFIX.cands` holds the search's candidates, the numbers a conflict can hold.
+//!
+//! One line a branching, a step of a node that chooses a branch (`Stepper::choose_branch`), written when the subtree of
+//! the child it makes has ended:
+//!
+//! ```text
+//! KIND FORCED PROMOTED GAP SIZE OUTCOME N K A
+//! ```
+//!
+//! * `KIND`: `C` if conflict branching chose the conflict (the gap at or above the gate), `D` if the search's own
+//!   conflict, `N` if the node has no conflict among its candidates and branches on its largest candidate.
+//! * `FORCED`: 1 if the child promotes the node's forced members and the node's loop ends with it, else 0.
+//! * `PROMOTED`: how many numbers the node has promoted, its depth in the tree of promotions.
+//! * `GAP`: the node's bound less its need, the gap that the gate reads.
+//! * `SIZE`: the steps in the child's subtree, 0 if the child was not explored; a `+` after it says the unit ended
+//!   (it was handed on or the run ended) before the subtree did, so that the count is short.
+//! * `OUTCOME`: `P` the promotion failed, `C` the child was cut at its check, `E` the child has no candidates, `X` the
+//!   child was explored.
+//! * `N`: the member branched on: promoted in the child and no longer a candidate of the node, which goes on without it.
+//! * `K`: the conflict's members among the node's candidates, comma separated (`-` if none).
+//! * `A`: what the child promotes, comma separated, when it is not `N` alone (several forced members), else `-`.
+
+use crate::bits::Bits;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+/// The environment variable that turns the trace on: the prefix of the files it writes.
+pub const ENV: &str = "TAXMAN_BRANCH_TRACE";
+
+/// Where the searchers of one search write their traces.
+#[derive(Debug)]
+pub struct BranchTrace {
+    prefix: PathBuf,
+    searchers: AtomicUsize,
+}
+
+impl BranchTrace {
+    /// The trace that [`ENV`] asks for, if it does.
+    pub fn from_env() -> Option<Self> {
+        let prefix = std::env::var_os(ENV).filter(|prefix| !prefix.is_empty())?;
+        Some(BranchTrace { prefix: PathBuf::from(prefix), searchers: AtomicUsize::new(0) })
+    }
+
+    /// Writes the search's candidates, the numbers a conflict can hold, to `PREFIX.cands`: one line, comma separated.
+    pub fn write_candidates(&self, candidates: impl Iterator<Item = u32>) {
+        let mut path = self.prefix.clone().into_os_string();
+        path.push(".cands");
+        let list: Vec<String> = candidates.map(|x| x.to_string()).collect();
+        std::fs::write(&path, list.join(",") + "\n").unwrap_or_else(|e| panic!("the branch trace {path:?}: {e}"));
+    }
+
+    /// The tracer of the next searcher, writing its own file.
+    pub(super) fn tracer<const W: usize>(&self) -> Tracer<W> {
+        let id = self.searchers.fetch_add(1, Ordering::Relaxed);
+        let mut path = self.prefix.clone().into_os_string();
+        path.push(format!(".{id}.txt"));
+        let file = File::create(&path).unwrap_or_else(|e| panic!("the branch trace {path:?}: {e}"));
+        Tracer { out: BufWriter::with_capacity(1 << 20, file), steps: 0, open: Vec::new(), last: None }
+    }
+}
+
+/// One branching: what the step chose, before its subtree is known.
+#[derive(Clone, Copy)]
+pub(super) struct Record<const W: usize> {
+    pub(super) kind: char,
+    pub(super) forced: bool,
+    pub(super) promoted: u32,
+    pub(super) gap: u64,
+    pub(super) outcome: char,
+    pub(super) n: u32,
+    pub(super) conflict: Bits<W>,
+    pub(super) added: Bits<W>,
+}
+
+/// One searcher's trace: its file, its steps, and the branchings whose children are being explored.
+pub(super) struct Tracer<const W: usize> {
+    out: BufWriter<File>,
+    /// The steps the searcher has taken, over all its units.
+    steps: u64,
+    /// By depth in the unit's stack, the branching whose child's subtree is being explored, and the step it was made at.
+    open: Vec<Option<(Record<W>, u64)>>,
+    /// The branching of the step in progress, set by the step.
+    last: Option<Record<W>>,
+}
+
+impl<const W: usize> Tracer<W> {
+    /// A step at `depth` begins: the subtree of the child that the node's last step made, if any, has ended.
+    pub(super) fn begin_step(&mut self, depth: usize) {
+        self.steps += 1;
+        if let Some((record, at)) = self.open.get_mut(depth).and_then(Option::take) {
+            let size = self.steps - at - 1;
+            self.write(&record, size, false);
+        }
+    }
+
+    /// The step at `depth` made a branching (set by [`branched`](Self::branched)) and ended, with a child pushed or not.
+    pub(super) fn end_step(&mut self, depth: usize, pushed: bool) {
+        let Some(record) = self.last.take() else { return };
+        if !pushed {
+            self.write(&record, 0, false);
+            return;
+        }
+        if self.open.len() <= depth {
+            self.open.resize(depth + 1, None);
+        }
+        self.open[depth] = Some((record, self.steps));
+    }
+
+    /// The step in progress chose a branch.
+    pub(super) fn branched(&mut self, record: Record<W>) {
+        self.last = Some(record);
+    }
+
+    /// What became of the child of the branching in progress.
+    pub(super) fn outcome(&mut self, outcome: char) {
+        if let Some(record) = &mut self.last {
+            record.outcome = outcome;
+        }
+    }
+
+    /// The unit ends, or its subtrees are handed on: the open branchings are written with the steps taken so far.
+    pub(super) fn finish_unit(&mut self) {
+        for slot in 0..self.open.len() {
+            if let Some((record, at)) = self.open[slot].take() {
+                let size = self.steps - at;
+                self.write(&record, size, true);
+            }
+        }
+        self.out.flush().expect("the branch trace");
+    }
+
+    fn write(&mut self, r: &Record<W>, size: u64, short: bool) {
+        let list = |set: &Bits<W>| {
+            if set.is_empty() {
+                "-".to_string()
+            } else {
+                set.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(",")
+            }
+        };
+        let (kind, forced, plus) = (r.kind, u8::from(r.forced), if short { "+" } else { "" });
+        let conflict = list(&r.conflict);
+        let added = if r.forced && r.added.len() > 1 { list(&r.added) } else { "-".into() };
+        writeln!(
+            self.out,
+            "{kind} {forced} {} {} {size}{plus} {} {} {conflict} {added}",
+            r.promoted, r.gap, r.outcome, r.n
+        )
+        .expect("the branch trace");
+    }
+}
