-            "hub branching: {} hub steps, {} search spaces made, {} of them with no game",
-            hub_branch::STEPS.load(std::sync::atomic::Ordering::Relaxed),
+            "hub branching: {} hub steps, {} search spaces made, {} of them with no game; children searched / with no \
+             game / steps taken: S {} / {} / {}, F {} / {} / {}",
+            t.steps,
             made.load(std::sync::atomic::Ordering::Relaxed),
-            dead.load(std::sync::atomic::Ordering::Relaxed)
