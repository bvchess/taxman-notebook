 solver/frame/src/search/mod.rs        | 14 ++++++++---
 solver/frame/src/search/searcher.rs   | 26 ++++++++++++-------
 3 files changed, 62 insertions(+), 14 deletions(-)

diff --git a/solver/frame/src/search/hub_branch.rs b/solver/frame/src/search/hub_branch.rs
index a044703..476138c 100644
--- a/solver/frame/src/search/hub_branch.rs
+++ b/solver/frame/src/search/hub_branch.rs
@@ -44,8 +44,40 @@ pub const SMOOTH: u32 = 23;
 /// moves, `F`), ascending.
 pub type Constraints = Vec<(u32, bool)>;
 
-/// Hub steps taken, over the searchers that have ended.
-pub static STEPS: AtomicU64 = AtomicU64::new(0);
+/// What a searcher's hub steps did, by side (0: `S`, the fibers give the hub away; 1: `F`, the smooth moves do).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct HubCounts {
+    pub steps: u64,
+    /// Children searched, and the steps they took.
+    pub runs: [u64; 2],
+    pub nodes: [u64; 2],
+    /// Children with no game: the promotions cannot be made in the space, no candidates, or (propagating) cut on sight.
+    pub dead: [u64; 2],
+}
+
+impl HubCounts {
+    fn add(&mut self, other: &HubCounts) {
+        self.steps += other.steps;
+        for side in 0..2 {
+            self.runs[side] += other.runs[side];
+            self.nodes[side] += other.nodes[side];
+            self.dead[side] += other.dead[side];
+        }
+    }
+}
+
+/// What the searchers that have ended did.
+static TOTALS: Mutex<HubCounts> = Mutex::new(HubCounts { steps: 0, runs: [0; 2], nodes: [0; 2], dead: [0; 2] });
+
+/// Adds a searcher's counts to the totals.
+pub fn total(counts: &HubCounts) {
+    TOTALS.lock().unwrap_or_else(PoisonError::into_inner).add(counts);
+}
+
+/// The totals so far.
+pub fn totals() -> HubCounts {
+    *TOTALS.lock().unwrap_or_else(PoisonError::into_inner)
+}
 
 /// What the searchers of a search share: the full model, and the search spaces made so far.
 pub struct Registry<const W: usize> {
