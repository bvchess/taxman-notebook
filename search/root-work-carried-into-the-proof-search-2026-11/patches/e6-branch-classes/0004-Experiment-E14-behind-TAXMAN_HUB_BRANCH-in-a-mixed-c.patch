--- /dev/null
+++ b/solver/frame/src/search/hub_branch.rs
@@ -0,0 +1,221 @@
+//! Experiment E14: hub-ownership branching in a mixed conflict.  Off unless the environment variable [`ENV`] is set, to
+//! the most hubs a path of the tree may branch on, or to that and the least gap a node must have, `DEPTH,GAP`; with a
+//! third number that is not 0, `DEPTH,GAP,1`, the rule only propagates: it branches on a hub where a child is cut on
+//! sight, and the node goes on in the other child, with the hub given away.
+//!
+//! A *hub* `a` is a smooth number (every prime at most [`SMOOTH`]) that some candidate `x = a·p` of the conflict, with a
+//! prime `p` above it, lists as its maximal factor `x/p`, and that smooth members of the conflict list as well.  The
+//! number `a` pays for at most one move, which is a *fiber* `a·p` (a prime above [`SMOOTH`]) or a *smooth* `a·q`, or
+//! none.  So every game is a game of one of two graphs, in each of which `a` pays for fewer moves:
+//!
+//! * `S(a)`: no fiber is paid by `a` (the edges from `a` to its fiber composites are left out);
+//! * `F(a)`: no smooth move is paid by `a`.
+//!
+//! A set that can be promoted in a graph with fewer edges can be promoted with all of them, so a set found in either
+//! is a game; and a game's schedule pays each move with a maximal factor that is in the pot, no two moves with the
+//! same one, so whoever `a` pays, its schedule is a schedule of `S(a)` (if a smooth move or none) or of `F(a)` (if a
+//! fiber).  Hence a node whose conflict is mixed branches into the node in the graph `S(a)` and the node in the graph
+//! `F(a)`, with the same promotions and candidates, and its loop ends: the two children cover every completion.  The
+//! children are searched by searchers of their own, over a search space of its own ([`SearchSpace`]: the model with
+//! the edges left out, the GF(2) graph, the nogood tables built from it), nested in the step; a work unit handed on
+//! while they run is a unit of the full graph, which is a superset of its games and so loses nothing.
+//!
+//! The children are in effect the bars of the conflict's fiber members, in one child: a fiber `a·p` that `a` cannot pay
+//! must have another factor, and the fibers of a hub that the sources list lose the hub at once, where one bar of a
+//! candidate is met by promoting a twin.
+
+use super::searcher::SearchSpace;
+use super::symmetry::Symmetries;
+use super::{Branching, Prepared, SearchTactics};
+use crate::bits::Bits;
+use crate::model::{FrameGraph, FrameSet};
+use crate::numtheory::sieve;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, PoisonError};
+
+/// The environment variable that turns the rule on.
+pub const ENV: &str = "TAXMAN_HUB_BRANCH";
+
+/// The largest prime of a smooth number.
+pub const SMOOTH: u32 = 23;
+
+/// What a search space is: its hubs, each with the side that loses it (`true`: the fibers, `S`; `false`: the smooth
+/// moves, `F`), ascending.
+pub type Constraints = Vec<(u32, bool)>;
+
+/// Hub steps taken, over the searchers that have ended.
+pub static STEPS: AtomicU64 = AtomicU64::new(0);
+
+/// What the searchers of a search share: the full model, and the search spaces made so far.
+pub struct Registry<const W: usize> {
+    model: FrameGraph,
+    root: FrameSet<W>,
+    candidates: Bits<W>,
+    n: u32,
+    tactics: SearchTactics,
+    greedy: Bits<W>,
+    max_total: u32,
+    symmetry: Option<Symmetries>,
+    branching: Arc<Branching>,
+    smooth: Vec<bool>,
+    spf: Vec<u32>,
+    spaces: Mutex<HashMap<Constraints, Option<&'static SearchSpace<'static, W>>>>,
+    /// Spaces made, and of those the ones with no game.
+    pub made: AtomicU64,
+    pub dead: AtomicU64,
+}
+
+/// The rule, in one search space: the registry, and the hubs this space has given away.
+pub struct HubRule<const W: usize> {
+    pub(super) registry: Arc<Registry<W>>,
+    pub(super) constraints: Constraints,
+    max_depth: usize,
+    min_gap: u64,
+    /// Whether the rule only propagates: it branches on a hub only where a child is cut on sight (the node then goes on
+    /// in the other, with the hub given away), and looks at up to three hubs for one.
+    pub(super) propagate: bool,
+}
+
+impl<const W: usize> HubRule<W> {
+    /// The rule that [`ENV`] asks for in the search of `prepared`, whose space is `space`.
+    pub fn from_env(prepared: &Prepared<W>, space: &SearchSpace<'_, W>) -> Option<Self> {
+        let setting = std::env::var(ENV).ok()?;
+        let mut parts = setting.split(',').map(|x| x.parse::<u64>().expect("the hub branching's depth and gap"));
+        let max_depth = parts.next()? as usize;
+        let min_gap = parts.next().unwrap_or(0);
+        let propagate = parts.next().unwrap_or(0) != 0;
+        let (spf, _) = sieve(prepared.n);
+        let smooth = (0..=prepared.n as usize).map(|x| x >= 2 && is_smooth(x as u32, &spf)).collect();
+        let registry = Registry {
+            model: (*prepared.model).clone(),
+            root: prepared.root,
+            candidates: prepared.candidates,
+            n: prepared.n,
+            tactics: prepared.tactics,
+            greedy: prepared.greedy,
+            max_total: prepared.max_total,
+            symmetry: space.symmetry.clone(),
+            branching: Arc::clone(&space.branching),
+            smooth,
+            spf,
+            spaces: Mutex::new(HashMap::new()),
+            made: AtomicU64::new(0),
+            dead: AtomicU64::new(0),
+        };
+        Some(HubRule { registry: Arc::new(registry), constraints: Vec::new(), max_depth, min_gap, propagate })
+    }
+
+    /// Whether a node whose bound is `gap` above its need may branch on a hub.
+    pub(super) fn applies(&self, gap: u64) -> bool {
+        self.constraints.len() < self.max_depth && gap >= self.min_gap
+    }
+
+    /// The hubs that the mixed conflict `k` contends, the best first: the smooth numbers that fibers of `k` list as their
+    /// maximal factor and smooth members of `k` list too, that are no promotion of the node and that this space has not
+    /// given away; by most smooth listers, then most fiber ones, then the largest.
+    pub(super) fn hubs(&self, k: &Bits<W>, promoted: &Bits<W>) -> Vec<u32> {
+        let r = &*self.registry;
+        // Per hub: its fibers in `k`, and its smooth listers in `k`.
+        let mut hubs: Vec<(u32, u32, u32)> = Vec::new();
+        for x in k.iter().filter(|&x| !r.smooth[x as usize]) {
+            let a = x / largest_prime(x, &r.spf);
+            if a >= 2 && r.smooth[a as usize] && !promoted.contains(a) && !self.constraints.iter().any(|c| c.0 == a) {
+                match hubs.iter_mut().find(|h| h.0 == a) {
+                    Some(h) => h.1 += 1,
+                    None => hubs.push((a, 1, 0)),
+                }
+            }
+        }
+        if hubs.is_empty() {
+            return Vec::new();
+        }
+        for y in k.iter().filter(|&y| r.smooth[y as usize]) {
+            let mut rest = y;
+            while rest > 1 {
+                let p = r.spf[rest as usize];
+                if let Some(h) = hubs.iter_mut().find(|h| h.0 == y / p) {
+                    h.2 += 1;
+                }
+                while rest % p == 0 {
+                    rest /= p;
+                }
+            }
+        }
+        hubs.retain(|h| h.2 > 0);
+        hubs.sort_unstable_by_key(|h| std::cmp::Reverse((h.2, h.1, h.0)));
+        hubs.into_iter().map(|h| h.0).collect()
+    }
+
+    /// The constraints of the child of this space that gives the fibers (`S`) or the smooth moves (`F`) of `hub` away.
+    pub(super) fn child(&self, hub: u32, fibers: bool) -> Constraints {
+        let mut key = self.constraints.clone();
+        key.push((hub, fibers));
+        key.sort_unstable();
+        key
+    }
+
+    /// The search space of `key`, made the first time anyone asks, or `None` if it has no game.
+    pub(super) fn space(&self, key: &Constraints) -> Option<&'static SearchSpace<'static, W>> {
+        let mut spaces = self.registry.spaces.lock().unwrap_or_else(PoisonError::into_inner);
+        if let Some(space) = spaces.get(key) {
+            return *space;
+        }
+        let space = self.registry.make(key, (self.max_depth, self.min_gap, self.propagate), &self.registry);
+        spaces.insert(key.clone(), space);
+        space
+    }
+}
+
+impl<const W: usize> Registry<W> {
+    /// The search space whose graph leaves out the edges of `key`.
+    fn make(
+        &self,
+        key: &Constraints,
+        (max_depth, min_gap, propagate): (usize, u64, bool),
+        me: &Arc<Registry<W>>,
+    ) -> Option<&'static SearchSpace<'static, W>> {
+        self.made.fetch_add(1, Ordering::Relaxed);
+        let smooth = &self.smooth;
+        let model =
+            self.model.without_edges(|y, x| key.iter().any(|&(hub, fibers)| y == hub && smooth[x as usize] != fibers));
+        let Some(root) = self.root.reduced_in(model.graph()) else {
+            self.dead.fetch_add(1, Ordering::Relaxed);
+            return None;
+        };
+        let prepared = Box::leak(Box::new(Prepared {
+            n: self.n,
+            model: Arc::new(model),
+            root,
+            candidates: self.candidates,
+            tactics: SearchTactics { symmetry: false, ..self.tactics },
+            greedy: self.greedy,
+            max_total: self.max_total,
+            timings: Default::default(),
+        }));
+        let hub = Some(HubRule { registry: Arc::clone(me), constraints: key.clone(), max_depth, min_gap, propagate });
+        let space = SearchSpace {
+            symmetry: self.symmetry.clone(),
+            branching: Arc::clone(&self.branching),
+            hub,
+            ..SearchSpace::new(prepared)
+        };
+        Some(Box::leak(Box::new(space)))
+    }
+}
+
+/// The largest prime factor of `x` (at least 2).
+fn largest_prime(mut x: u32, spf: &[u32]) -> u32 {
+    let mut largest = 1;
+    while x > 1 {
+        let p = spf[x as usize];
+        largest = largest.max(p);
+        x /= p;
+    }
+    largest
+}
+
+/// Whether every prime of `x` is at most [`SMOOTH`].
+fn is_smooth(x: u32, spf: &[u32]) -> bool {
+    largest_prime(x, spf) <= SMOOTH
+}
