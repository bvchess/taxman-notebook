+    /// The same lists without the pairs `(y, x)` (`y` pays for `x`) that `drop` says to leave out: a graph with fewer
+    /// edges, in which fewer sets can be promoted (experiment E14).
+    pub fn without_edges(&self, drop: impl Fn(u32, u32) -> bool) -> Self {
+        let mut fac = self.fac.clone();
+        for (x, list) in fac.iter_mut().enumerate() {
+            let kept: Vec<u16> = list[..usize::from(list[MAX_FACTORS]).min(MAX_FACTORS)]
+                .iter()
+                .copied()
+                .filter(|&y| !drop(u32::from(y), x as u32))
+                .collect();
+            *list = [0; MAX_FACTORS + 1];
+            list[..kept.len()].copy_from_slice(&kept);
+            list[MAX_FACTORS] = kept.len() as u16;
+        }
+        let mut comp_start = Vec::with_capacity(self.comp_start.len());
+        let mut comp = Vec::with_capacity(self.comp.len());
+        comp_start.push(0);
+        for y in 0..self.comp_start.len().saturating_sub(1) {
+            comp.extend(self.composites(y as u32).iter().copied().filter(|&x| !drop(y as u32, u32::from(x))));
+            comp_start.push(comp.len() as u32);
+        }
+        FactorProvider { fac, comp_start, comp }
+    }
