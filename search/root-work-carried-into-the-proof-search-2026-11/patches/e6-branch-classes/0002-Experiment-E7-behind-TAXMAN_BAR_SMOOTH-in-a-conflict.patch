@@ -0,0 +1,35 @@
+//! Experiment E7: in a conflict that holds both smooth and fiber members, the member that strong branching chooses to
+//! bar is a smooth one.  Off unless the environment variable [`ENV`] names the largest prime of a smooth number.
+//!
+//! Any member of a conflict is as good a branch as any other for exactness (every completion leaves one out), so the
+//! rule changes only the tree.  Strong branching still prices every member, so the forced members it finds are the same;
+//! only the choice among the members whose removal lowers the bound is restricted.
+
+use crate::bits::Bits;
+
+/// The environment variable that turns the rule on: the largest prime of a smooth number (23 for E7).
+pub const ENV: &str = "TAXMAN_BAR_SMOOTH";
+
+/// The numbers up to `max` whose primes are all at most the bound that [`ENV`] names, if it names one.
+pub fn smooth_set<const W: usize>(max: u32) -> Option<Bits<W>> {
+    let bound: u32 = std::env::var(ENV).ok()?.parse().expect("the smoothness bound of E7");
+    Some((2..=max).filter(|&x| is_smooth(x, bound)).collect())
+}
+
+fn is_smooth(mut x: u32, bound: u32) -> bool {
+    for p in 2..=bound {
+        while x % p == 0 {
+            x /= p;
+        }
+    }
+    x == 1
+}
+
+/// The members of the conflict `k` that the rule lets a node bar: the smooth ones if `k` holds both kinds, else all of
+/// them (and when the rule is off).
+pub fn barrable<const W: usize>(smooth: Option<&Bits<W>>, k: Bits<W>) -> Bits<W> {
+    match smooth {
+        Some(smooth) if k.intersects(smooth) && !k.is_subset(smooth) => k & *smooth,
+        _ => k,
+    }
+}
