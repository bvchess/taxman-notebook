+/// E9's list (`--window W`): the root's GF(2) bound with each candidate fixed the other way from its place in the
+/// heaviest set, solved from scratch: PB(bar x) for each member x of the heaviest set, and PB(pick y) for each
+/// candidate y outside it.  One JSON line on stdout for each whose bound lies in (known, known + W], and for each
+/// that the plain bound fixes already (its bound at most `known`), with its excess over `known`.  A member whose
+/// PB_s(bar x) is at most `known` is in every set that beats it; a candidate whose PB_s(pick y) is, in none.
+fn window<const W: usize>(p: &Problem<'_, W>, board: &Board<W>, known: u64, width: u64) -> Result<(), String> {
+    let clock = Instant::now();
+    let mut gf2 = Gf2Bound::new(p.graph);
+    gf2.reset(&Bits::EMPTY, &p.ground);
+    let root = gf2.evaluate(p.cap, None);
+    let pb = p.in_the_bag + root.value;
+    let mut lines = Vec::new();
+    let (mut fixed_in, mut fixed_out) = (0, 0);
+    for x in p.ground.iter() {
+        let member = root.chosen.contains(x);
+        let one: Bits<W> = Bits::EMPTY.with(x);
+        let bound = if member {
+            gf2.reset(&Bits::EMPTY, &(p.ground - one));
+            p.in_the_bag + gf2.evaluate(p.cap, None).value
+        } else {
+            gf2.reset(&one, &(p.ground - one));
+            p.in_the_bag + u64::from(x) + gf2.evaluate(p.cap, None).value
+        };
+        if bound <= known {
+            if member {
+                fixed_in += 1;
+            } else {
+                fixed_out += 1;
+            }
+        }
+        if bound <= known + width {
+            lines.push(format!(
+                "{{\"n\":{},\"x\":{x},\"member\":{member},\"bound\":{bound},\"over\":{}}}",
+                board.n(),
+                bound as i64 - known as i64
+            ));
+        }
+    }
+    for line in &lines {
+        println!("{line}");
+    }
+    eprintln!(
+        "n={}: PB {pb}, known {known}, {} candidates, {} in the heaviest set; the plain bound fixes {fixed_in} in and \
+         {fixed_out} out; {} within {width} above known; {:.1} s",
+        board.n(),
+        p.ground.len(),
+        root.chosen.len(),
+        lines.len() - fixed_in - fixed_out,
+        clock.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
