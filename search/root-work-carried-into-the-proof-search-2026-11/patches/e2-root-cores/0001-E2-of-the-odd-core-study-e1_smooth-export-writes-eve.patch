+/// Writes the smooth conflicts `found` (`--export`), the most often found first: `PATH` as a store of nogoods (one set
+/// of literals a line, in decimal), and `PATH.jsonl` with each one's layer, how often it was found, its core's members
+/// and its literals.
+fn write_found(path: &str, found: &Found) -> Result<(), String> {
+    let mut all: Vec<(&Vec<u32>, &(u64, usize, Vec<u32>))> = found.iter().collect();
+    all.sort_by(|a, b| b.1 .0.cmp(&a.1 .0).then_with(|| a.0.len().cmp(&b.0.len())).then_with(|| a.0.cmp(b.0)));
+    let (mut store, mut lines) = (String::new(), String::new());
+    for (literals, (count, layer, core)) in all {
+        let text: Vec<String> = literals.iter().map(|x| x.to_string()).collect();
+        store.push_str(&text.join(" "));
+        store.push('\n');
+        lines.push_str(&format!(
+            "{{\"layer\":{layer},\"found\":{count},\"core\":{core:?},\"literals\":{literals:?}}}\n"
+        ));
+    }
+    std::fs::write(path, store).map_err(|e| format!("{path}: {e}"))?;
+    std::fs::write(format!("{path}.jsonl"), lines).map_err(|e| format!("{path}.jsonl: {e}"))
+}
