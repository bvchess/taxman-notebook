@@ -0,0 +1,67 @@
+//! E2 of the odd-core study (lab/work/oddcore/e2/README.md): the nogoods of a store as the frame solver keeps them.
+//!
+//! ```text
+//! cargo run --release --example e2_validate -- N STORE OUT
+//! ```
+//!
+//! Reads the sets of the store STORE (one set a line, its members in decimal), validates them at the root of game N as
+//! a search with the tactic `carried_nogoods` does ([`CarriedNogoods::validated`]: a set is kept when all its members
+//! are candidates and a peel at the root finds a conflict within it, and what is kept is that conflict), writes the
+//! nogoods kept to OUT, one a line, and prints the counts as one JSON line.  With no cap: `--carried-dir` reads at most
+//! [`taxman::model::READ_CAP`] sets.
+
+use taxman::board::Board;
+use taxman::model::CarriedNogoods;
+use taxman::search::SearchTactics;
+
+fn run<const W: usize>(n: u32, store: &str, out: &str) -> Result<(), String> {
+    let board = Board::<W>::for_n(n);
+    let prepared = board.prepare(SearchTactics::default())?;
+    let text = std::fs::read_to_string(store).map_err(|e| format!("{store}: {e}"))?;
+    let sets = CarriedNogoods::<W>::parse(&text)?;
+    let clock = std::time::Instant::now();
+    let (kept, v) = CarriedNogoods::validated(&prepared.model, &prepared.root, &prepared.candidates, &sets);
+    let seconds = clock.elapsed().as_secs_f64();
+    let mut lines = String::new();
+    let mut sizes = 0usize;
+    for nogood in kept.sets() {
+        let members: Vec<String> = nogood.iter().map(|x| x.to_string()).collect();
+        sizes += members.len();
+        lines.push_str(&members.join(" "));
+        lines.push('\n');
+    }
+    std::fs::write(out, lines).map_err(|e| format!("{out}: {e}"))?;
+    let given_sizes: usize = sets.iter().map(Vec::len).sum();
+    println!(
+        "{{\"n\":{n},\"given\":{},\"not_candidates\":{},\"promotable\":{},\"kept\":{},\"shrunk\":{},\
+         \"given_mean_size\":{:.1},\"kept_mean_size\":{:.1},\"candidates\":{},\"seconds\":{seconds:.2}}}",
+        v.given,
+        v.not_candidates,
+        v.promotable,
+        v.kept,
+        v.shrunk,
+        given_sizes as f64 / v.given.max(1) as f64,
+        sizes as f64 / v.kept.max(1) as f64,
+        prepared.candidates.len()
+    );
+    Ok(())
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let [n, store, out] = args.as_slice() else {
+        eprintln!("usage: e2_validate N STORE OUT");
+        std::process::exit(2);
+    };
+    let n: u32 = match n.parse() {
+        Ok(n) => n,
+        Err(e) => {
+            eprintln!("e2_validate: N: {e}");
+            std::process::exit(2);
+        }
+    };
+    if let Err(e) = taxman::with_width!(n, W => run::<W>(n, store, out)) {
+        eprintln!("e2_validate: {e}");
+        std::process::exit(1);
+    }
+}
