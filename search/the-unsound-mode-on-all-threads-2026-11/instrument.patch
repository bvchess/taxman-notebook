+//! Instrumentation of the unsound mode for the diagnosis of B9 (never committed): where a round's time goes, and a
+//! game's time outside its rounds.  Every line goes to stderr, prefixed `B9`.
+
+use std::io::Write as _;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+/// The process's clock, from its first use.
+pub fn now() -> f64 {
+    static T0: OnceLock<Instant> = OnceLock::new();
+    T0.get_or_init(Instant::now).elapsed().as_secs_f64()
+}
+
+/// The process's minor page faults, user and system CPU seconds, and voluntary and involuntary context switches.
+#[derive(Clone, Copy, Default)]
+pub struct Usage {
+    pub minflt: u64,
+    pub utime: f64,
+    pub stime: f64,
+    pub vcsw: u64,
+    pub ivcsw: u64,
+}
+
+pub fn usage() -> Usage {
+    let mut u = Usage::default();
+    if let Ok(stat) = std::fs::read_to_string("/proc/self/stat") {
+        // After the command in parentheses: field 3 is the state.
+        if let Some(rest) = stat.rsplit_once(") ").map(|(_, rest)| rest) {
+            let f: Vec<&str> = rest.split_whitespace().collect();
+            // Fields from 3: minflt is 10, utime 14, stime 15.
+            let get = |i: usize| f.get(i - 3).and_then(|s| s.parse::<u64>().ok()).unwrap_or(0);
+            u.minflt = get(10);
+            u.utime = get(14) as f64 / 100.0;
+            u.stime = get(15) as f64 / 100.0;
+        }
+    }
+    if let Ok(status) = std::fs::read_to_string("/proc/self/status") {
+        for line in status.lines() {
+            if let Some(v) = line.strip_prefix("voluntary_ctxt_switches:") {
+                u.vcsw = v.trim().parse().unwrap_or(0);
+            }
+            if let Some(v) = line.strip_prefix("nonvoluntary_ctxt_switches:") {
+                u.ivcsw = v.trim().parse().unwrap_or(0);
+            }
+        }
+    }
+    u
+}
+
+/// The machine's TLB shootdowns so far, over every CPU (/proc/interrupts).
+pub fn tlb() -> u64 {
+    let Ok(text) = std::fs::read_to_string("/proc/interrupts") else { return 0 };
+    text.lines()
+        .find(|line| line.trim_start().starts_with("TLB:"))
+        .map(|line| line.split_whitespace().skip(1).filter_map(|s| s.parse::<u64>().ok()).sum())
+        .unwrap_or(0)
+}
+
+impl Usage {
+    pub fn since(&self, before: &Usage) -> String {
+        format!(
+            "minflt={} utime={:.2} stime={:.2} vcsw={} ivcsw={}",
+            self.minflt - before.minflt,
+            self.utime - before.utime,
+            self.stime - before.stime,
+            self.vcsw - before.vcsw,
+            self.ivcsw - before.ivcsw
+        )
+    }
+}
+
+/// Writes a line to stderr.
+pub fn say(line: &str) {
+    let _ = writeln!(std::io::stderr(), "B9 {line}");
+}
