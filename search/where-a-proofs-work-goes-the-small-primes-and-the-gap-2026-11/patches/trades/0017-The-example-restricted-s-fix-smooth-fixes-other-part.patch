+/// Which candidates `fix-smooth` fixes or bars as the reference set has them: the smooth part, or with `--rough` the
+/// candidates outside it (some prime of them above B), and with `--random K` only K of those, drawn at random with
+/// the seed `--seed` (default 1), the others left free.
+#[derive(Clone, Copy)]
+struct Part {
+    rough: bool,
+    random: Option<(usize, u64)>,
+}
+
 /// `fix-smooth N --smooth B`: see the module documentation.  One JSON line, with the moves of the answer if `show`.
+#[allow(clippy::too_many_arguments)]
 fn fix_smooth(
     n: u32,
     smooth: u32,
+    part: Part,
     from: u32,
     flips: &[u32],
     run: Run,
@@ -602,10 +616,20 @@ fn fix_smooth(
         let board = Board::<W>::for_n(n);
         (board.candidates().to_vec(), board.seed(moves).to_vec())
     });
-    let in_part = |y: u32| largest_prime(&t, y) <= smooth;
+    let mut chosen: Vec<u32> =
+        candidates.iter().copied().filter(|&y| (largest_prime(&t, y) <= smooth) != part.rough).collect();
+    if let Some((k, seed)) = part.random {
+        if k > chosen.len() {
+            return Err(format!("--random {k}: the part has only {} candidates", chosen.len()));
+        }
+        Rng(seed).shuffle(&mut chosen);
+        chosen.truncate(k);
+    }
+    chosen.sort_unstable();
+    let in_part = |y: u32| chosen.binary_search(&y).is_ok();
     for &x in flips {
         if !candidates.contains(&x) || !in_part(x) {
-            return Err(format!("{x} is no candidate of the smooth part"));
+            return Err(format!("{x} is no candidate of the part"));
         }
         match reference.iter().position(|&y| y == x) {
             Some(i) => _ = reference.remove(i),
@@ -619,10 +643,13 @@ fn fix_smooth(
     let shown = |score: Option<u64>| score.map_or_else(|| "null".to_owned(), |s| s.to_string());
     let moves = if show { format!(",\"moves\":{}", json_list(&answer.moves)) } else { String::new() };
     Ok(format!(
-        "{{\"n\":{n},\"smooth\":{smooth},\"from\":{from},\"flips\":{},\"smooth_part\":{},\"fixed\":{},\"barred\":{},\
-         \"free\":{},\"tactics\":\"{tactics}\",\"threads\":{},\"above\":{above},\"root_bound\":{},\"bound\":{},\
-         \"score\":{},\"opt\":{},\"equal\":{},\"completed\":{},\"nodes\":{},\"seconds\":{:.3},\"cpu\":{:.3},\
-         \"moves_left\":{},\"smooth_in\":{}{moves}}}",
+        "{{\"n\":{n},\"smooth\":{smooth},\"rough\":{},\"random\":{},\"seed\":{},\"from\":{from},\"flips\":{},\
+         \"smooth_part\":{},\"fixed\":{},\"barred\":{},\"free\":{},\"tactics\":\"{tactics}\",\"threads\":{},\
+         \"above\":{above},\"root_bound\":{},\"bound\":{},\"score\":{},\"opt\":{},\"equal\":{},\"completed\":{},\
+         \"nodes\":{},\"seconds\":{:.3},\"cpu\":{:.3},\"moves_left\":{},\"smooth_in\":{},\"barred_in\":{}{moves}}}",
+        part.rough,
+        part.random.map_or("null".to_owned(), |(k, _)| k.to_string()),
+        part.random.map_or("null".to_owned(), |(_, seed)| seed.to_string()),
         json_list(flips),
         fixed.len() + barred.len(),
         fixed.len(),
@@ -640,6 +667,7 @@ fn fix_smooth(
         answer.cpu.unwrap_or(0.0),
         json_list(&answer.left),
         json_list(&fixed),
+        json_list(&barred),
     ))
 }
 
@@ -1223,7 +1251,13 @@ fn main() {
             let smooth = value(&args, "--smooth").expect("--smooth B").parse().expect("a bound");
             let from = value(&args, "--from").map_or(n, |m| m.parse().expect("a game"));
             let show = args.iter().any(|a| a == "--show");
-            match fix_smooth(n, smooth, from, &numbers(&args, "--flip"), run, &tactics.description(), show) {
+            let part = Part {
+                rough: args.iter().any(|a| a == "--rough"),
+                random: value(&args, "--random").map(|k| {
