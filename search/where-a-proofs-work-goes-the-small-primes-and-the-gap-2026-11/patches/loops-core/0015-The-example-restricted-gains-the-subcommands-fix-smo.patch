+/// How `smooth-tree --exact` walks the tree: the least frontier it shares out (`--frontier`, default 64 a thread), and
+/// the number of its nodes walked, drawn at random with a seed (`--walk-sample K`, `--seed`), if not all.
+#[derive(Clone, Copy)]
+struct Exact {
+    frontier_min: usize,
+    sample: Option<(usize, u64)>,
+}
+
+/// What `smooth-tree` is asked: game `n`, the smooth part's bound `smooth`, the order its tree decides the part in
+/// (largest first, or with `ascending` smallest first), and either `samples` random paths (with `leaves`, each leaf
+/// reached searched so) or, with `exact`, the walk.
+struct Tree {
+    n: u32,
+    smooth: u32,
+    ascending: bool,
+    samples: usize,
+    seed: u64,
+    leaves: Option<Run>,
+    exact: Option<Exact>,
+}
+
+/// `smooth-tree N --smooth B`: see the module documentation.  With `exact`, one JSON line; else a JSON line a sample,
+/// then a summary line.
+fn smooth_tree(tree: &Tree, run: Run) -> Result<(), String> {
+    taxman::with_width!(tree.n, W => smooth_tree_at::<W>(tree, run))
+}
+
+fn smooth_tree_at<const W: usize>(tree: &Tree, run: Run) -> Result<(), String> {
+    let &Tree { n, smooth, ascending, samples, seed, leaves, exact } = tree;
+    let board = Board::<W>::for_n(n);
+    let prepared = board.prepare(run.tactics)?;
+    let graph = Gf2Graph::new(&prepared.model, &prepared.root, &prepared.candidates);
+    let above = run.above.or(Optimal::built_in().score(n)).ok_or("no committed score for n: give --above")?;
+    let mut part: Vec<u32> =
+        prepared.candidates.iter_desc().filter(|&y| largest_prime(&board.tables, y) <= smooth).collect();
+    if ascending {
+        part.reverse();
+    }
+    let part_set: Bits<W> = part.iter().copied().collect();
+    let in_the_bag = board.in_the_bag;
+    let started = Instant::now();
+    if let Some(exact) = exact {
+        let floor = above.checked_sub(in_the_bag).ok_or("the score to beat is below ΣU*")?;
+        let leaf_cfg =
+            EngineConfig { threads: 1, node_limit: run.node_limit, progress: None, ..EngineConfig::default() };
+        let walked = walk_all(
+            &prepared,
+            &graph,
+            &part,
+            floor,
+            &leaf_cfg,
+            run.threads,
+            exact.frontier_min,
+            exact.sample,
+            run.time_limit,
+        )?;
+        println!(
+            "{{\"exact\":true,\"n\":{n},\"smooth\":{smooth},\"ascending\":{ascending},\"smooth_part\":{},\
+             \"above\":{above},{},\"seconds\":{:.1}}}",
+            part.len(),
+            walked,
+            started.elapsed().as_secs_f64()
+        );
+        return Ok(());
+    }
+    let ids: Vec<usize> = (0..samples).collect();
+    let lines = run_all(&ids, run.threads, |&i| {
+        let mut rng = Rng(seed ^ (i as u64 + 1).wrapping_mul(0x9E37_79B9_7F4A_7C15));
+        let mut bound = NodeBound::new(&prepared, &graph);
+        // A node lives when some completion of it may score more than `above`.
+        let mut lives = |u: &TaxUnit<W>| -> bool {
+            bound.completions(u).is_some_and(|c| in_the_bag + u.promoted.sum() + c > above)
+        };
+        let root = TaxUnit { promoted: Bits::EMPTY, cands: prepared.candidates };
+        if !lives(&root) {
+            return format!("{{\"sample\":{i},\"depth\":0,\"leaf\":false,\"log10_weight\":0,\"log10_nodes\":0}}");
+        }
+        let (mut unit, mut weight, mut nodes, mut depth) = (root, 1.0f64, 1.0f64, 0);
+        for &x in &part {
+            let cands = unit.cands.without(x);
+            let children =
+                [TaxUnit { promoted: unit.promoted.with(x), cands }, TaxUnit { promoted: unit.promoted, cands }];
+            let alive: Vec<TaxUnit<W>> = children.into_iter().filter(|u| lives(u)).collect();
+            nodes += weight * alive.len() as f64;
+            if alive.is_empty() {
+                break;
+            }
+            weight *= alive.len() as f64;
+            unit = alive[rng.below(alive.len())];
+            depth += 1;
+        }
+        let leaf = depth == part.len();
+        let mut line = format!(
+            "{{\"sample\":{i},\"depth\":{depth},\"leaf\":{leaf},\"log10_weight\":{:.4},\"log10_nodes\":{:.4}",
+            weight.log10(),
+            nodes.log10()
+        );
+        if let (true, Some(leaf_run)) = (leaf, leaves) {
+            let fixed = unit.promoted;
+            let r = Restricted { n, holes: Vec::new(), barred: (part_set - fixed).to_vec(), fixed: fixed.to_vec() };
+            match solve(&r, Run { above: Some(above), ..leaf_run }) {
+                Ok(a) => line.push_str(&format!(
+                    ",\"bound\":{},\"score\":{},\"completed\":{},\"steps\":{},\"cpu\":{:.3}",
+                    a.bound.map_or("null".to_owned(), |b| b.to_string()),
+                    a.score.map_or("null".to_owned(), |s| s.to_string()),
+                    a.completed,
+                    a.nodes,
+                    a.cpu.unwrap_or(0.0)
+                )),
+                Err(e) => line.push_str(&format!(",\"error\":\"{e}\"")),
+            }
+            line.push_str(&format!(",\"smooth_in\":{}", json_list(&fixed.to_vec())));
+        }
+        line.push('}');
+        line
+    });
+    for line in &lines {
+        println!("{line}");
+    }
+    println!(
+        "{{\"summary\":true,\"n\":{n},\"smooth\":{smooth},\"smooth_part\":{},\"above\":{above},\"samples\":{samples},\
+         \"seconds\":{:.1}}}",
+        part.len(),
+        started.elapsed().as_secs_f64()
+    );
+    Ok(())
+}
+
+/// A walk of the tree of the smooth part from a node down, with the search's own incremental GF(2) bound
+/// ([`Gf2Bound`]), whose top level is the node being walked.  The tree is `smooth-tree`'s: the members of the part are
+/// decided in order, each promoted (where the frames allow it) or not, and a node lives while its promotion sum and its
+/// bound exceed `floor`.
+struct Walk<'a, const W: usize> {
+    prepared: &'a Prepared<W>,
+    graph: &'a Gf2Graph,
+    gf2: Gf2Bound<'a, W>,
+    part: &'a [u32],
+    floor: u64,
+    /// The depth (members of the part decided) at which the walk keeps a living node and goes no deeper: the part's
+    /// length for the leaves, less for a frontier to share out.
+    stop: usize,
+    nodes: u64,
+    reached: Vec<TaxUnit<W>>,
+    /// Every this many nodes, the bound is computed again from the root ([`NodeBound`]) and compared.
+    check_every: u64,
+    checked: u64,
+    differed: u64,
+}
+
+impl<'a, const W: usize> Walk<'a, W> {
+    fn new(prepared: &'a Prepared<W>, graph: &'a Gf2Graph, part: &'a [u32], floor: u64, stop: usize) -> Self {
+        let mut gf2 = Gf2Bound::new(graph);
+        gf2.set_warm_start(prepared.tactics.warm_start);
+        Walk {
+            prepared,
+            graph,
+            gf2,
+            part,
+            floor,
+            stop,
+            nodes: 0,
+            reached: Vec::new(),
+            check_every: 1000,
+            checked: 0,
+            differed: 0,
+        }
+    }
+
+    /// Walks the subtree of `unit`, a node of the tree at `depth`.
+    fn from(&mut self, unit: TaxUnit<W>, depth: usize) {
+        let model = &self.prepared.model;
+        let Some(state) = model.promote_all_using(&mut Scratch::new(), &self.prepared.root, &unit.promoted) else {
+            return;
+        };
+        self.gf2.reset(&unit.promoted, &unit.cands);
+        self.walk(&state, unit.promoted, unit.cands, depth);
+    }
+
+    /// The node of `promoted`, whose frames are `state`, with the candidates `cands` and the members of the part before
+    /// index `i` decided; the top level of the bound is the node's.  The node's loop promotes the next member in a
+    /// child and then goes on without it, as a search's node does, so the top level ends without the members decided.
+    fn walk(&mut self, state: &FrameSet<W>, promoted: Bits<W>, mut cands: Bits<W>, mut i: usize) {
+        loop {
+            self.nodes += 1;
+            let cap = max_additional(self.prepared.max_total, state, &promoted, &cands);
+            let value = self.gf2.evaluate(cap, None).value;
+            if self.nodes % self.check_every == 0 {
+                let unit = TaxUnit { promoted, cands };
+                self.checked += 1;
+                if NodeBound::new(self.prepared, self.graph).completions(&unit) != Some(value) {
+                    self.differed += 1;
+                }
+            }
+            if promoted.sum() + value <= self.floor {
+                return;
+            }
+            if i == self.stop {
+                self.reached.push(TaxUnit { promoted, cands });
+                return;
+            }
+            let x = self.part[i];
+            cands.remove(x);
+            if let Some(child) = self.prepared.model.promote(state, x) {
+                self.gf2.push_all(&Bits::EMPTY.with(x), &cands);
+                self.walk(&child, promoted.with(x), cands, i + 1);
+                self.gf2.pop();
+            }
+            self.gf2.remove_candidate(x);
+            i += 1;
+        }
+    }
+}
+
+/// What the walks of the tree of the smooth part found, and what the searches of its leaves did.
+#[derive(Default)]
+struct Walked {
+    nodes: u64,
+    leaves: u64,
+    leaf_steps: u64,
+    /// The most steps of one leaf's search, and the searches that a limit stopped.
+    leaf_most: u64,
+    unfinished: u64,
+    /// The promotion sums of the sets found above the floor (none, on a proven game with the floor at its optimum).
+    found: Vec<u64>,
+    tree_cpu: f64,
+    leaf_cpu: f64,
+    checked: u64,
+    differed: u64,
+}
+
+impl Walked {
+    fn add(&mut self, other: &Walked) {
+        self.nodes += other.nodes;
+        self.leaves += other.leaves;
+        self.leaf_steps += other.leaf_steps;
+        self.leaf_most = self.leaf_most.max(other.leaf_most);
+        self.unfinished += other.unfinished;
+        self.found.extend(&other.found);
+        self.tree_cpu += other.tree_cpu;
+        self.leaf_cpu += other.leaf_cpu;
+        self.checked += other.checked;
+        self.differed += other.differed;
+    }
+}
+
+/// The whole tree of the smooth part `part`, walked on `threads` threads from a frontier (the living nodes at the
+/// first depth, a multiple of 4, where there are at least `frontier_min`, or the leaves), and each leaf searched with
+/// `leaf_cfg` from an incumbent worth `floor`.  If every leaf's search finishes and none finds a set, no promotion set
+/// is worth more than `floor`: every promotion set holds an arrangement of the part, and a node is dropped only where
+/// its bound shows that none of its completions is worth more.  With `sample` (K, seed), only K nodes of the frontier,
+/// drawn at random, are walked, and the frontier's size over K times what they hold estimates the whole tree.  With
+/// `time_limit`, no node of the frontier is begun after it, and the estimate is over those walked.  Each subtree walked
+/// writes a JSON line on stderr.  The JSON fields of the walk.
+fn walk_all<const W: usize>(
+    prepared: &Prepared<W>,
+    graph: &Gf2Graph,
+    part: &[u32],
+    floor: u64,
+    leaf_cfg: &EngineConfig,
+    threads: usize,
+    frontier_min: usize,
+    sample: Option<(usize, u64)>,
+    time_limit: Option<Duration>,
+) -> Result<String, String> {
+    let root = TaxUnit { promoted: Bits::EMPTY, cands: prepared.candidates };
+    // The frontier's walk, on a thread with room for it: its depth, what it counted, and the frontier.
+    let walk_to = |&depth: &usize| {
+        let mut walk = Walk::new(prepared, graph, part, floor, depth);
+        walk.from(root, 0);
+        let counted = Walked { nodes: walk.nodes, checked: walk.checked, differed: walk.differed, ..Walked::default() };
+        (counted, walk.reached)
+    };
+    let mut depth = 0;
+    let (mut first, mut frontier) = run_all(&[depth], 1, &walk_to).pop().expect("the walk to the frontier");
+    while frontier.len() < frontier_min && depth < part.len() {
+        depth = (depth + 4).min(part.len());
+        (first, frontier) = run_all(&[depth], 1, &walk_to).pop().expect("the walk to the frontier");
+    }
+    // The nodes of the frontier walked: all of them, or the first K of a random order.
+    let mut walked = frontier.clone();
+    if let Some((k, seed)) = sample.filter(|&(k, _)| k < frontier.len()) {
+        let mut rng = Rng(seed);
+        for i in 0..k {
+            let j = i + rng.below(walked.len() - i);
+            walked.swap(i, j);
+        }
+        walked.truncate(k);
+    }
+    let space = SearchSpace::new(prepared);
+    let done = AtomicUsize::new(0);
+    let started = Instant::now();
+    let deadline = time_limit.map(|limit| started + limit);
+    let results = run_all(&walked, threads, |&unit| -> Result<Option<Walked>, String> {
+        if deadline.is_some_and(|deadline| Instant::now() >= deadline) {
+            return Ok(None);
+        }
+        let cpu = engine::thread_cpu();
+        let mut walk = Walk::new(prepared, graph, part, floor, part.len());
+        walk.from(unit, depth);
+        let mut w = Walked {
+            nodes: walk.nodes - 1, // the frontier's walk counted the unit
+            leaves: walk.reached.len() as u64,
+            tree_cpu: (engine::thread_cpu() - cpu).as_secs_f64(),
+            checked: walk.checked,
+            differed: walk.differed,
+            ..Walked::default()
+        };
+        for &leaf in &walk.reached {
+            let (found, finished, steps, seconds) = search_above(&space, leaf_cfg, leaf, floor)?;
+            w.leaf_steps += steps;
+            w.leaf_most = w.leaf_most.max(steps);
+            w.unfinished += u64::from(!finished);
+            w.leaf_cpu += seconds;
+            w.found.extend(found.map(|set| set.sum()));
+        }
+        let k = done.fetch_add(1, Ordering::Relaxed) + 1;
+        eprintln!(
+            "{{\"subtree\":{k},\"of\":{},\"nodes\":{},\"leaves\":{},\"tree_cpu\":{:.2},\"seconds\":{:.0}}}",
+            walked.len(),
+            w.nodes,
+            w.leaves,
+            w.tree_cpu,
+            started.elapsed().as_secs_f64()
+        );
+        Ok(Some(w))
+    });
+    let (mut all, mut finished) = (Walked::default(), 0u32);
+    for result in results {
+        if let Some(w) = result? {
+            all.add(&w);
+            finished += 1;
+        }
+    }
+    // The subtrees walked are those begun before the time limit, a prefix of a random order.
+    let scale = frontier.len() as f64 / f64::from(finished).max(1.0);
+    Ok(format!(
+        "\"frontier_depth\":{depth},\"frontier\":{},\"walked\":{},\"prefix_nodes\":{},\"est_nodes\":{:.0},\
+         \"est_leaves\":{:.0},\"est_tree_cpu\":{:.0},\"nodes\":{},\"leaves\":{},\"leaf_steps\":{},\"leaf_most\":{},\
+         \"unfinished\":{},\"found\":{},\"tree_cpu\":{:.1},\"leaf_cpu\":{:.1},\"checked\":{},\"differed\":{}",
+        frontier.len(),
+        finished,
+        first.nodes,
+        first.nodes as f64 + scale * all.nodes as f64,
+        scale * all.leaves as f64,
+        scale * all.tree_cpu,
+        all.nodes,
+        all.leaves,
+        all.leaf_steps,
+        all.leaf_most,
+        all.unfinished,
+        format!("[{}]", all.found.iter().map(u64::to_string).collect::<Vec<_>>().join(",")),
+        all.tree_cpu,
+        all.leaf_cpu,
+        all.checked + first.checked,
+        all.differed + first.differed,
+    ))
+}
+
+/// What `census` counts, from the trace of a search's refutations: each conflict a node goes on with, member by member,
+/// and the depth (promotions) of its node.
+struct Census {
+    /// The largest prime of each number of the board.
+    largest: Vec<u32>,
+    smooth: u32,
+    /// Per member: how many conflicts held it.
+    members: Mutex<std::collections::HashMap<u32, u64>>,
+    /// Per depth, in tens of promotions: the conflicts, their members, and those of the smooth part.
+    depths: Mutex<Vec<[u64; 3]>>,
+}
+
+/// The hook is the census itself, which outlives the search so that its counts can be read after it.
+impl taxman::search::trace::Refutations for &'static Census {
+    fn refuted(&self, promoted: &[u32], _chosen: &[u32], conflict: Option<&[u32]>) {
+        let Some(conflict) = conflict else { return };
+        let in_part = conflict.iter().filter(|&&y| self.largest[y as usize] <= self.smooth).count() as u64;
+        {
+            let mut depths = self.depths.lock().unwrap();
+            let d = promoted.len() / 10;
+            if depths.len() <= d {
+                depths.resize(d + 1, [0; 3]);
+            }
+            let row = &mut depths[d];
+            (row[0], row[1], row[2]) = (row[0] + 1, row[1] + conflict.len() as u64, row[2] + in_part);
+        }
+        let mut members = self.members.lock().unwrap();
+        for &y in conflict {
+            *members.entry(y).or_default() += 1;
+        }
+    }
+
+    fn learned(&self, _nogood: &[u32]) {}
+
+    fn failed(&self, _promoted: &[u32], _added: &[u32]) {}
+}
+
+/// `census N --smooth B`: see the module documentation.  One JSON line.
+fn census(n: u32, smooth: u32, run: Run) -> Result<String, String> {
+    let t = Tables::new(n);
+    let largest: Vec<u32> = (0..=n).map(|k| if k < 2 { 1 } else { largest_prime(&t, k) }).collect();
+    let hook: &'static Census =
+        Box::leak(Box::new(Census { largest, smooth, members: Mutex::default(), depths: Mutex::default() }));
+    taxman::search::trace::install(Box::new(hook))?;
+    let above = run.above.or(Optimal::built_in().score(n).map(|o| o - 1)).ok_or("no committed score: give --above")?;
+    let answer = solve(&Restricted { n, ..Restricted::default() }, Run { above: Some(above), ..run })?;
+    let members = hook.members.lock().unwrap();
+    let mut top: Vec<(u32, u64)> = members.iter().map(|(&y, &c)| (y, c)).collect();
+    top.sort_unstable_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
+    // Members' counts by the largest prime of the member.
+    let mut by_prime: std::collections::BTreeMap<u32, u64> = std::collections::BTreeMap::new();
+    for (&y, &c) in members.iter() {
+        *by_prime.entry(hook.largest[y as usize]).or_default() += c;
+    }
+    let depths = hook.depths.lock().unwrap();
+    let list = |pairs: &mut dyn Iterator<Item = (u32, u64)>| {
+        pairs.map(|(a, b)| format!("[{a},{b}]")).collect::<Vec<_>>().join(",")
+    };
+    Ok(format!(
+        "{{\"n\":{n},\"smooth\":{smooth},\"above\":{above},\"score\":{},\"completed\":{},\"nodes\":{},\
+         \"cpu\":{:.3},\"depths\":[{}],\"by_prime\":[{}],\"top\":[{}]}}",
+        answer.score.map_or("null".to_owned(), |s| s.to_string()),
+        answer.completed,
+        answer.nodes,
+        answer.cpu.unwrap_or(0.0),
+        depths.iter().map(|r| format!("[{},{},{}]", r[0], r[1], r[2])).collect::<Vec<_>>().join(","),
+        list(&mut by_prime.iter().map(|(&p, &c)| (p, c))),
+        list(&mut top.iter().take(60).copied()),
+    ))
+}
