+/// The GF(2) bound at the root of `prepared` on the promotion sum ([`NodeBound::root`]).
+fn root_bound_of<const W: usize>(prepared: &Prepared<W>) -> u64 {
+    let graph = Gf2Graph::new(&prepared.model, &prepared.root, &prepared.candidates);
+    NodeBound::new(prepared, &graph).root()
+}
