+/// `fix-smooth N --smooth B`: see the module documentation.  One JSON line, with the moves of the answer if `show`.
+fn fix_smooth(
+    n: u32,
+    smooth: u32,
+    from: u32,
+    flips: &[u32],
+    run: Run,
+    tactics: &str,
+    show: bool,
+) -> Result<String, String> {
+    let t = Tables::new(n);
+    let table = Optimal::built_in();
+    let opt = table.score(n);
+    let moves = table.moves(from).ok_or_else(|| format!("no committed moves for {from}"))?;
+    let (candidates, mut reference) = taxman::with_width!(n, W => {
+        let board = Board::<W>::for_n(n);
+        (board.candidates().to_vec(), board.seed(moves).to_vec())
+    });
+    let in_part = |y: u32| largest_prime(&t, y) <= smooth;
+    for &x in flips {
+        if !candidates.contains(&x) || !in_part(x) {
+            return Err(format!("{x} is no candidate of the smooth part"));
+        }
+        match reference.iter().position(|&y| y == x) {
+            Some(i) => _ = reference.remove(i),
+            None => reference.push(x),
+        }
+    }
+    let (free, fixed, barred) = split(&candidates, &reference, |y| !in_part(y));
+    let above = run.above.or(opt.map(|o| o - 1)).ok_or("no committed score for n: give --above")?;
+    let r = Restricted { n, holes: Vec::new(), barred: barred.clone(), fixed: fixed.clone() };
+    let answer = solve(&r, Run { above: Some(above), ..run })?;
+    let shown = |score: Option<u64>| score.map_or_else(|| "null".to_owned(), |s| s.to_string());
+    let moves = if show { format!(",\"moves\":{}", json_list(&answer.moves)) } else { String::new() };
+    Ok(format!(
+        "{{\"n\":{n},\"smooth\":{smooth},\"from\":{from},\"flips\":{},\"smooth_part\":{},\"fixed\":{},\"barred\":{},\
+         \"free\":{},\"tactics\":\"{tactics}\",\"threads\":{},\"above\":{above},\"root_bound\":{},\"bound\":{},\
+         \"score\":{},\"opt\":{},\"equal\":{},\"completed\":{},\"nodes\":{},\"seconds\":{:.3},\"cpu\":{:.3},\
+         \"moves_left\":{},\"smooth_in\":{}{moves}}}",
+        json_list(flips),
+        fixed.len() + barred.len(),
+        fixed.len(),
+        barred.len(),
+        free.len(),
+        run.threads,
+        shown(answer.root_bound),
+        shown(answer.bound),
+        shown(answer.score),
+        shown(opt),
+        opt.map_or("null".to_owned(), |o| (answer.score == Some(o)).to_string()),
+        answer.completed,
+        answer.nodes,
+        answer.seconds,
+        answer.cpu.unwrap_or(0.0),
+        json_list(&answer.left),
+        json_list(&fixed),
+    ))
+}
