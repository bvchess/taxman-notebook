+/// The search of the node `unit` of the search space `space` from an incumbent worth `floor` that holds no set, run
+/// by the engine as [`search::search`] runs it, with no start, ceiling or finder: the heaviest completion of the node
+/// whose promotion sum (the node's promotions with it) is above `floor`, `None` if the search found none, with whether
+/// it finished, its steps and its CPU seconds.  A node is cut only when its bound is below `best + 1` less its
+/// promotions, so a finished search that found none proves that no completion of `unit` is worth more than `floor`.
+fn search_above<const W: usize>(
+    space: &SearchSpace<'_, W>,
+    cfg: &EngineConfig,
+    unit: TaxUnit<W>,
+    floor: u64,
+) -> Result<(Option<Bits<W>>, bool, u64, f64), String> {
+    let start = Start::Fresh { units: vec![unit], best: floor, payload: payload_of(&Bits::<W>::EMPTY) };
+    let o = engine::run(cfg, start, b"restricted --above", |_| TaxSearcher::new(space))
+        .map_err(|e| format!("search: {e}"))?;
+    let found = (o.best > floor).then(|| set_of_payload::<W>(&o.payload));
+    if let Some(set) = found {
+        if set.sum() != o.best {
+            return Err(format!("the incumbent is worth {}, not the {} of its payload", o.best, set.sum()));
+        }
+    }
+    Ok((found, o.completed, o.stats.nodes, o.spent.cpu.as_secs_f64()))
+}
