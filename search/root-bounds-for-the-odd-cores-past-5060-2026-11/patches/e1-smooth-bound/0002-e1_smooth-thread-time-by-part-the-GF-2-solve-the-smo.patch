+/// Where a worker's time went, in seconds of its thread: the GF(2) solve of each node from scratch (reset and evaluate,
+/// with its weight split and forced members), the smooth sub-instances' peel and minimal cores, and the pricing of the
+/// literals (bounds without each, certified from the exchange graph or else solved).  With the counts of literals
+/// priced, of those the exchange graph did not certify, and the GF(2) bound's augmentations.
+#[derive(Clone, Copy, Default, Debug)]
+struct Times {
+    solve: f64,
+    smooth: f64,
+    price: f64,
+    priced: u64,
+    uncertified: u64,
+}
+
+impl Times {
+    fn add(&mut self, o: &Times) {
+        self.solve += o.solve;
+        self.smooth += o.smooth;
+        self.price += o.price;
+        self.priced += o.priced;
+        self.uncertified += o.uncertified;
+    }
+}
+
 struct Worker<'g, const W: usize> {
     p: &'g Problem<'g, W>,
     gf2: Gf2Bound<'g, W>,
     rng: Rng,
     prices: Vec<Option<u64>>,
+    times: Times,
 }
 
 impl<'g, const W: usize> Worker<'g, W> {
     fn new(p: &'g Problem<'g, W>, seed: u64) -> Self {
-        Worker { p, gf2: Gf2Bound::new(p.graph), rng: Rng(seed), prices: Vec::new() }
