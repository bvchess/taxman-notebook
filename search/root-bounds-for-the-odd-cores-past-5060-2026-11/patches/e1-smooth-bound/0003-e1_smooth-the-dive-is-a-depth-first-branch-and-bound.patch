+// ---------------------------------------------------------------------------------------------------------------
+// The fibers' hub demands (E11: PB_sh)
+//
+// In a layer, the *fiber* of a prime p > B is the set's members whose largest prime is p.  A member x = m·p (p ∤ m)
+// lists its *hub* m and its fiber factors x/q (q a prime of m), which p divides; a member with p² | x has no hub.  In a
+// payment scheme of a playable set each column pays one member.  Fiber p's members that pay with fiber factors form a
+// matching into the fiber factors they list, so at least d_p (the members less the largest such matching) pay with
+// their own hubs, each a distinct column, which then pays no smooth member.  Ordering the smooth members as the game
+// plays them, each pays a column that no earlier smooth member lists, so the smooth sub-instance without the hubs the
+// fibers pay is playable (it dismantles from the last member).  So a playable set has, in every layer, a choice for
+// each fiber of members paying with hubs, the others matched into fiber factors, the hubs distinct across fibers, that
+// leaves the smooth sub-instance playable without the chosen hubs.  A choice may be taken minimal (d_p members whose
+// complement is matchable, a basis's complement): a larger one contains one and only takes more hubs away.
+//
+// The test is a depth-first search over the fibers with demand, the fiber with fewest choices first, each fiber's
+// choices taking fewest of the hubs the smooth members list first, with the smooth sub-instance peeled after each step
+// that takes such a hub away: a step that stalls it is cut (taking more away keeps every core, so no completion
+// passes).  A layer with no passing choice is a conflict, whose literals are the free members of the fibers with demand
+// and the played numbers their members list, and the free members of every residual the search cut at and the played
+// numbers they list.  A set holding them all keeps those fibers' members with no longer lists (so no new choice), and
+// every choice of it restricted to those members contains a choice here, which a residual here, still a core, stalls.
+// So the conflict's literals cannot all be kept, and the branching on them is a partition, as for a smooth core.  A
+// layer whose search runs out of budget, and a fiber with too many choices to list, are passed over, which only
+// weakens the test.
+
+/// Counters of the hub test.
+#[derive(Clone, Copy, Default, Debug)]
+struct HubStats {
+    /// Smooth-playable heaviest sets tested, and those with a layer that fails.
+    checks: u64,
+    failed: u64,
+    /// Smooth sub-instances peeled by the choice searches, layers passed for want of budget, fibers passed over.
+    tests: u64,
+    budget: u64,
+    skipped: u64,
+}
+
+impl HubStats {
+    fn add(&mut self, o: &HubStats) {
+        self.checks += o.checks;
+        self.failed += o.failed;
+        self.tests += o.tests;
+        self.budget += o.budget;
+        self.skipped += o.skipped;
+    }
+}
+
+/// The most choices of members examined for one fiber before it is passed over.
+const OPTION_CAP: usize = 20_000;
+
+/// The size of a largest matching of the members `allowed` into the factors they list (`lists`, numbers).
+fn matching(lists: &[Vec<u32>], allowed: &[bool]) -> usize {
+    fn augment(u: usize, lists: &[Vec<u32>], owner: &mut HashMap<u32, usize>, seen: &mut HashSet<u32>) -> bool {
+        for &f in &lists[u] {
+            if !seen.insert(f) {
+                continue;
+            }
+            let free = match owner.get(&f).copied() {
+                None => true,
+                Some(v) => augment(v, lists, owner, seen),
+            };
+            if free {
+                owner.insert(f, u);
+                return true;
+            }
+        }
+        false
+    }
+    let mut owner = HashMap::new();
+    let mut size = 0;
+    for u in 0..lists.len() {
+        if allowed[u] && augment(u, lists, &mut owner, &mut HashSet::new()) {
+            size += 1;
+        }
+    }
+    size
+}
+
+/// Calls `f` with each `k`-subset of `0..n` (ascending indices) until it returns false.
+fn for_each_combination(n: usize, k: usize, mut f: impl FnMut(&[usize]) -> bool) {
+    if k > n {
+        return;
+    }
+    let mut c: Vec<usize> = (0..k).collect();
+    loop {
+        if !f(&c) {
+            return;
+        }
+        let Some(i) = (0..k).rev().find(|&i| c[i] < n - k + i) else { return };
+        c[i] += 1;
+        for j in i + 1..k {
+            c[j] = c[j - 1] + 1;
+        }
+    }
+}
+
+/// The choice search of one layer: the fibers' choices (hub numbers, and the local ids of those the smooth members
+/// list), the hubs taken, and the residuals it cut at.
+struct HubSearch<'a> {
+    inst: &'a Inst,
+    choices: &'a [Vec<(Vec<u32>, Vec<u32>)>],
+    dead: Vec<bool>,
+    used: HashSet<u32>,
+    alive: Vec<bool>,
+    count: Vec<u32>,
+    stack: Vec<u32>,
+    tests: u64,
+    budget: u64,
+    out_of_budget: bool,
+    cut_members: HashSet<u32>,
+}
+
+impl HubSearch<'_> {
+    /// Whether the fibers from `i` on have choices that, with those already made, keep the smooth members playable.
+    fn search(&mut self, i: usize) -> bool {
+        let choices = self.choices;
+        if i == choices.len() {
+            return true;
+        }
+        for (hubs, ids) in &choices[i] {
+            if self.out_of_budget {
+                return true;
+            }
+            if hubs.iter().any(|m| self.used.contains(m)) {
+                continue;
+            }
+            self.used.extend(hubs.iter().copied());
+            for &f in ids {
+                self.dead[f as usize] = true;
+            }
+            let mut ok = true;
+            if !ids.is_empty() {
+                self.tests += 1;
+                self.out_of_budget = self.tests > self.budget;
+                self.alive.clear();
+                self.alive.resize(self.inst.members.len(), true);
+                if residual(self.inst, &mut self.alive, &self.dead, &mut self.count, &mut self.stack) > 0 {
+                    ok = false;
+                    for (j, &a) in self.alive.iter().enumerate() {
+                        if a {
+                            self.cut_members.insert(self.inst.members[j]);
+                        }
+                    }
+                }
+            }
+            let found = ok && self.search(i + 1);
+            for &f in ids {
+                self.dead[f as usize] = false;
+            }
+            for m in hubs {
+                self.used.remove(m);
+            }
+            if found {
+                return true;
+            }
+        }
+        false
+    }
+}
+
+/// The layers of `h` (a smooth-playable set) whose fibers' hub demands leave no choice that keeps the smooth members
+/// playable, as conflicts (`size` is the number of fibers with demand); empty if every layer passes.
+fn hub_conflicts<const W: usize>(sb: &SmoothBoard, h: &Bits<W>, budget: u64, stats: &mut HubStats) -> Vec<Conflict> {
+    stats.checks += 1;
+    let mut fibers: BTreeMap<(u8, u32), Vec<u32>> = BTreeMap::new();
+    for x in h.iter() {
+        let p = sb.largest[x as usize];
+        if p > sb.bound {
+            fibers.entry((sb.layer[x as usize], p)).or_default().push(x);
+        }
+    }
+    let played = |x: u32| sb.max_factors[x as usize].iter().copied().filter(|&f| h.contains(f));
+    let layers: BTreeSet<u8> = fibers.keys().map(|&(k, _)| k).collect();
+    let mut out = Vec::new();
+    let mut inst = Inst::default();
+    for k in layers {
+        if (k as usize) < sb.by_layer.len() {
+            sb.instance(k as usize, h, &mut inst);
+        } else {
+            inst = Inst::default();
+        }
+        let id_of: HashMap<u32, u32> = inst.factors.iter().enumerate().map(|(i, &f)| (f, i as u32)).collect();
+        let mut choices: Vec<Vec<(Vec<u32>, Vec<u32>)>> = Vec::new();
+        let mut literals: Vec<u32> = Vec::new();
+        let mut infeasible = None;
+        for (&(_, p), members) in fibers.range((k, 0)..=(k, u32::MAX)) {
+            let lists: Vec<Vec<u32>> = (members.iter())
+                .map(|&x| sb.max_factors[x as usize].iter().copied().filter(|&f| f % p == 0 && !h.contains(f)).collect())
+                .collect();
+            let hub: Vec<Option<u32>> = members.iter().map(|&x| Some(x / p).filter(|&m| m % p != 0 && !h.contains(m))).collect();
+            let d = members.len() - matching(&lists, &vec![true; members.len()]);
+            if d == 0 {
+                continue;
+            }
+            let mut mine: Vec<u32> = members.iter().copied().filter(|&x| x <= sb.half).collect();
+            for &x in members {
+                mine.extend(played(x));
+            }
+            let payers: Vec<usize> = (0..members.len()).filter(|&i| hub[i].is_some()).collect();
+            let (mut options, mut examined) = (Vec::new(), 0usize);
+            for_each_combination(payers.len(), d, |combo| {
+                examined += 1;
+                if examined > OPTION_CAP {
+                    return false;
+                }
+                let mut allowed = vec![true; members.len()];
+                for &c in combo {
+                    allowed[payers[c]] = false;
+                }
+                if matching(&lists, &allowed) == members.len() - d {
+                    let hubs: Vec<u32> = combo.iter().map(|&c| hub[payers[c]].expect("a payer")).collect();
+                    let ids: Vec<u32> = hubs.iter().filter_map(|m| id_of.get(m).copied()).collect();
+                    options.push((hubs, ids));
+                }
+                true
+            });
+            if examined > OPTION_CAP {
+                stats.skipped += 1;
+                continue;
+            }
+            if options.is_empty() {
+                infeasible = Some(mine);
+                break;
+            }
+            options.sort_by_key(|(_, ids)| ids.len());
+            literals.extend(mine);
+            choices.push(options);
+        }
+        if let Some(mut lits) = infeasible {
+            lits.sort_unstable();
+            lits.dedup();
+            out.push(Conflict { layer: k as usize, size: 1, literals: lits, hub: true });
+            continue;
+        }
+        if choices.is_empty() {
+            continue;
+        }
+        choices.sort_by_key(|c| c.len());
+        let mut search = HubSearch {
+            inst: &inst,
+            choices: &choices,
+            dead: vec![false; inst.factors.len()],
+            used: HashSet::new(),
+            alive: Vec::new(),
+            count: Vec::new(),
+            stack: Vec::new(),
+            tests: 0,
+            budget,
+            out_of_budget: false,
+            cut_members: HashSet::new(),
+        };
+        let pass = search.search(0);
+        stats.tests += search.tests;
+        if search.out_of_budget {
+            stats.budget += 1;
+            continue;
+        }
+        if pass {
+            continue;
+        }
+        for &x in &search.cut_members {
+            if x <= sb.half {
+                literals.push(x);
+            }
+            literals.extend(played(x));
+        }
+        literals.sort_unstable();
+        literals.dedup();
+        out.push(Conflict { layer: k as usize, size: choices.len(), literals, hub: true });
+    }
+    out
+}
