+/// A fiber's choices of members paying with their hubs: none needed, too many to list, or the list (as the hubs each
+/// takes; empty if the fiber has demand and no choice).
+enum FiberChoices {
+    NoDemand,
+    TooMany,
+    Choices(Vec<Vec<u32>>),
+}
+
+/// A worker's fibers' choices, by prime, members and their played maximal factors, which fix them.
+type HubCache = HashMap<(u32, Vec<u32>, Vec<u32>), Rc<FiberChoices>>;
+
+/// The most fibers a worker's cache holds before it starts over.
+const CACHE_CAP: usize = 400_000;
+
+/// The choices of the fiber of `p` whose members in `h` are `members`: its demand d (the members less a largest
+/// matching into the fiber factors they list), and every d of the members with hubs whose others match.
+fn fiber_choices<const W: usize>(sb: &SmoothBoard, h: &Bits<W>, p: u32, members: &[u32]) -> FiberChoices {
+    let lists: Vec<Vec<u32>> = (members.iter())
+        .map(|&x| sb.max_factors[x as usize].iter().copied().filter(|&f| f % p == 0 && !h.contains(f)).collect())
+        .collect();
+    let hub: Vec<Option<u32>> = members.iter().map(|&x| Some(x / p).filter(|&m| m % p != 0 && !h.contains(m))).collect();
+    let d = members.len() - matching(&lists, &vec![true; members.len()]);
+    if d == 0 {
+        return FiberChoices::NoDemand;
+    }
+    let payers: Vec<usize> = (0..members.len()).filter(|&i| hub[i].is_some()).collect();
+    let (mut options, mut examined) = (Vec::new(), 0usize);
+    for_each_combination(payers.len(), d, |combo| {
+        examined += 1;
+        if examined > OPTION_CAP {
+            return false;
+        }
+        let mut allowed = vec![true; members.len()];
+        for &c in combo {
+            allowed[payers[c]] = false;
+        }
+        if matching(&lists, &allowed) == members.len() - d {
+            options.push(combo.iter().map(|&c| hub[payers[c]].expect("a payer")).collect::<Vec<u32>>());
+        }
+        true
+    });
+    if examined > OPTION_CAP {
+        FiberChoices::TooMany
+    } else {
+        FiberChoices::Choices(options)
+    }
+}
