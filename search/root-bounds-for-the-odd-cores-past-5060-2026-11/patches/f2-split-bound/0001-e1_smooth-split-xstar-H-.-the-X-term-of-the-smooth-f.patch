+// ---------------------------------------------------------------------------------------------------------------
+// The smooth/fiber split (experiment 1 of fable2-report.md, Sections 2.4 and 4)
+//
+// A *fiber* number has a prime above B.  The *hub* of a fiber number x is x / p, p its largest prime, when that is
+// B-smooth (1 for a prime).  The hubs are those of the fiber sources (of U*) and of the fiber candidates (the fiber
+// numbers of layer 3 and up, at most n/2).  The two parts of the board share no coordinate but the hubs: a smooth
+// number's maximal factors are smooth, and a fiber number x = m·p lists its hub m (or m itself, a fiber number, when m is
+// not smooth) and the multiples of p among its other maximal factors.  For a set X of hubs:
+//
+// * E(X) is the heaviest set of smooth candidates (layer 3 and up, at most n/2, outside X) that with the smooth sources
+//   is playable with the columns X deleted: in every layer the smooth members, each listing its maximal factors that
+//   are neither played nor in X, peel.  The branch and bound above finds it, on the smooth sub-board's own GF(2) bound:
+//   frames by layer (frame i has the smooth sources of layer i + 3 as moves and the smooth numbers of layer i + 2 up
+//   to n/2, less X, as factors) and the smooth candidates as elements.  Leaving X out of the factors deletes those
+//   coordinates (contracts their unit vectors) and bars the members of X that are candidates.
+// * F(X) is the GF(2) bound of the fiber part with the hubs outside X deleted: frames by layer with the fiber sources as
+//   moves, and the fiber numbers up to n/2 and the hubs in X as factors; the fiber candidates are the elements.
+//
+// The X-term is ΣU* + E(X) + F(X).  Layers 1 and 2 hold only sources from n = 187 on (q(n) and U*_2) and touch no
+// candidate, so they are left out of both parts' frames.  At X*, the hubs that the fiber rows of the optimal set S* pay
+// in a peel of S*, S*'s smooth part is a feasible point of E(X*): the peel's scheme pays each smooth row with a column
+// outside X*, and its list matrix in the peel's order is triangular on those columns, so the smooth rows peel without
+// X*.  So S*'s smooth part is a valid incumbent, and the search returns E(X*) exactly: the best leaf above it, or it.
+// Likewise S*'s fiber part is independent in F(X*), whose bound is so at least it; both are checked.
+
+/// The split's X-term at the hubs `args.xstar`: E(X) by the branch and bound, F(X) by one GF(2) solve, each against
+/// the optimum's own part.  One JSON line on stdout.
+fn run_split<const W: usize>(args: &Args) -> Result<(), String> {
+    let t0 = Instant::now();
+    let n = args.n;
+    let half = n / 2;
+    let board = Board::<W>::for_n(n);
+    let t = &board.tables;
+    let mut sb = SmoothBoard::new(t, args.smooth);
+    let optimal = Optimal::built_in();
+    let score = optimal.score(n).ok_or(format!("no optimum known for {n}"))?;
+    let moves = optimal.moves(n).ok_or(format!("no moves known for {n}"))?;
+
+    // S*'s sources are U* and its promotions are of layer 3 and up, so opt(n) = ΣU* + its smooth part + its fiber part.
+    let plain: BTreeSet<u32> = board.plain.iter().copied().collect();
+    let sources: BTreeSet<u32> = moves.iter().copied().filter(|&x| x > half).collect();
+    if sources != plain {
+        return Err("the optimum's sources are not U*".into());
+    }
+    let promotions: Vec<u32> = moves.iter().copied().filter(|&x| x <= half).collect();
+    if promotions.iter().any(|&x| t.omega(x) < 3) {
+        return Err("the optimum promotes a number below layer 3".into());
+    }
+    let (s_smooth, s_fiber): (Vec<u32>, Vec<u32>) = promotions.iter().partition(|&&x| sb.is_smooth(x));
+    let sum = |v: &[u32]| v.iter().map(|&x| u64::from(x)).sum::<u64>();
+    let (s_smooth_sum, s_fiber_sum) = (sum(&s_smooth), sum(&s_fiber));
+    if board.in_the_bag + s_smooth_sum + s_fiber_sum != score {
+        return Err("the optimum's moves do not sum to its score".into());
+    }
+
+    // The hubs, and X.
+    let cands: Vec<u32> = (2..=half).filter(|&x| t.omega(x) >= 3).collect();
+    let mut hubs = BTreeSet::new();
+    for &x in plain.iter().chain(&cands) {
+        if !sb.is_smooth(x) {
+            let m = x / sb.largest[x as usize];
+            if sb.is_smooth(m) {
+                hubs.insert(m);
+            }
+        }
+    }
+    let xs: BTreeSet<u32> = args.xstar.clone().unwrap_or_default().into_iter().collect();
+    if let Some(x) = xs.iter().find(|&x| !hubs.contains(x)) {
+        return Err(format!("{x} of --xstar is not a hub"));
+    }
+    for &x in &xs {
+        sb.dead[x as usize] = true;
+    }
+    let sb = sb;
+
+    // The two parts' frames, by layer: factors, then moves, for each layer k ≥ 3 of the moves.
+    let top = (2..=n).map(|x| t.omega(x)).max().unwrap_or(0);
+    let columns = |smooth: bool| -> Vec<Vec<u32>> {
+        let factor = |y: u32| if smooth { sb.is_smooth(y) && !xs.contains(&y) } else { !sb.is_smooth(y) || xs.contains(&y) };
+        let mut out = Vec::new();
+        for k in 3..=top {
+            out.push((2..=half).filter(|&y| t.omega(y) == k - 1 && factor(y)).collect());
+            out.push(plain.iter().copied().filter(|&s| t.omega(s) == k && sb.is_smooth(s) == smooth).collect());
+        }
+        out
+    };
+    let e_cands: Bits<W> = cands.iter().copied().filter(|&x| sb.is_smooth(x) && !xs.contains(&x)).collect();
+    let f_cands: Bits<W> = cands.iter().copied().filter(|&x| !sb.is_smooth(x)).collect();
+
+    // The root's parity bound, for the gap.
+    let prepared = board.prepare(SearchTactics::default())?;
+    let graph = Gf2Graph::new(&prepared.model, &prepared.root, &prepared.candidates);
+    let mut bound = Gf2Bound::<W>::new(&graph);
+    bound.reset(&Bits::EMPTY, &prepared.candidates);
+    let pb = board.in_the_bag + bound.evaluate(graph.len() as u32 + 1, None).value;
+    drop(bound);
+
+    // F(X): one solve.
+    let (f_model, f_root) = FrameGraph::build::<W>(t, &columns(false))?;
+    let f_graph = Gf2Graph::new(&f_model, &f_root, &f_cands);
+    let mut f_bound = Gf2Bound::<W>::new(&f_graph);
+    f_bound.reset(&Bits::EMPTY, &f_cands);
+    let f = f_bound.evaluate(f_graph.len() as u32 + 1, None).value;
+    drop(f_bound);
+    if f < s_fiber_sum {
+        return Err(format!("F(X) = {f} is below the optimum's fiber part, {s_fiber_sum}"));
+    }
+
+    // E(X): the branch and bound, from S*'s smooth part as the incumbent.
+    let (e_model, e_root) = FrameGraph::build::<W>(t, &columns(true))?;
+    let e_graph = Gf2Graph::new(&e_model, &e_root, &e_cands);
+    let base: Bits<W> = Bits::from_slice(&board.plain);
+    if let Some(x) = s_smooth.iter().find(|&&x| !e_cands.contains(x)) {
+        return Err(format!("the optimum promotes {x}, which X bars"));
+    }
+    if !smooth_conflicts(&sb, &(base | Bits::from_slice(&s_smooth)), 1, &mut Rng(1)).is_empty() {
+        return Err("the optimum's smooth part does not peel without X".into());
+    }
+    let problem = Problem {
+        graph: &e_graph,
+        sb: &sb,
+        base,
+        ground: e_cands,
+        in_the_bag: 0,
+        cap: e_graph.len() as u32 + 1,
+        orders: args.orders,
+        hubs: false,
+        hub_budget: args.hub_budget,
+    };
+    let mut w0 = Worker::new(&problem, 1);
+    let (e_root_bound, _) = w0.process(&[], &[], 0);
+    drop(w0);
+    if e_root_bound < s_smooth_sum {
+        return Err(format!("E's root bound {e_root_bound} is below the optimum's smooth part, {s_smooth_sum}"));
+    }
+    let setup = t0.elapsed().as_secs_f64();
+    let s = best_first(&problem, args, e_root_bound, s_smooth_sum, None, t0);
     let finished = !s.timed_out;
-    let upper = if finished { s.best } else { s.upper() };
-    let gap = pb - known;
-    let share = |v: u64| if gap == 0 { 1.0 } else { (pb - v) as f64 / gap as f64 };
-    let (lp, lb, lpromo) = s.best_leaf.clone().unwrap_or_default();
-    let branchings: u64 = s.layers.iter().sum();
