+/// max_X [E(X) + F(X)] against the X-term at X* (`start`: X*, E(X*) and a configuration attaining it; F(X*) is `f_star`),
+/// for at most `args.seconds` in all.  `board` is the optimum, the parity bound and ΣU*.  The JSON line.
+fn max_over_x<const W: usize>(
+    split: &Split<'_, W>,
+    args: &Args,
+    start: (&BTreeSet<u32>, u64, Vec<u32>),
+    f_star: u64,
+    board: (u64, u64, u64),
+    t0: Instant,
+) -> Result<String, String> {
+    let (xstar, e_star, c_star) = start;
+    let (opt, pb, in_the_bag) = board;
+    let t_search = Instant::now();
+    let all = split.hubs.clone();
+    let mut xsearch = XSearch {
+        split,
+        args,
+        t0,
+        deadline: args.seconds,
+        e: HashMap::new(),
+        f: HashMap::new(),
+        e_runs: 0,
+        e_stopped: 0,
+        e_nodes: 0,
+        f_runs: 0,
+        out_of_time: false,
+    };
+    xsearch.e.insert(xstar.iter().copied().collect(), Known::Exact(e_star, c_star));
+    xsearch.f.insert(xstar.iter().copied().collect(), Some(f_star));
+    let term_star = e_star + f_star;
+    let mut incumbent = term_star;
+    let mut best_x = xstar.clone();
+    let mut nodes: Vec<(BTreeSet<u32>, BTreeSet<u32>)> = vec![(BTreeSet::new(), BTreeSet::new())];
+    let mut heap: BinaryHeap<(u64, std::cmp::Reverse<usize>)> = BinaryHeap::from([(u64::MAX, std::cmp::Reverse(0))]);
+    let (mut processed, mut repushed, mut closed, mut branchings, mut root_bound) = (0u64, 0u64, 0u64, 0u64, None);
+    let mut unresolved: Vec<u64> = Vec::new();
+    while let Some(&(key, std::cmp::Reverse(i))) = heap.peek() {
+        if key <= incumbent || t0.elapsed().as_secs_f64() > args.seconds {
+            break;
+        }
+        heap.pop();
+        let (x_in, x_out) = nodes[i].clone();
+        let usable: BTreeSet<u32> = all.difference(&x_out).copied().collect();
+        let Some(f_up) = xsearch.f_of(&usable)? else { continue };
+        // E(X_in), or an upper bound on it if its search ran out of budget (then there is no configuration).
+        let answer = xsearch.e_of(&x_in, incumbent.saturating_sub(f_up))?;
+        if xsearch.out_of_time {
+            heap.push((key, std::cmp::Reverse(i)));
+            break;
+        }
+        let (e, config) = match answer {
+            EAnswer::Cut => continue,
+            EAnswer::Upper(u) => (u, None),
+            EAnswer::Exact(v, c) => (v, Some(c)),
+        };
+        let bound = e + f_up;
+        root_bound.get_or_insert(bound);
+        if bound <= incumbent {
+            continue;
+        }
+        if bound < key && heap.peek().is_some_and(|&(k, _)| k > bound) {
+            heap.push((bound, std::cmp::Reverse(i)));
+            repushed += 1;
+            continue;
+        }
+        processed += 1;
+        // The fibers' loss without each free hub, and the hubs C can do without, those the fibers lose most first.
+        let mut loss: Vec<(u64, u32)> = Vec::new();
+        for &h in usable.difference(&x_in) {
+            let mut y = usable.clone();
+            y.remove(&h);
+            let without = xsearch.f_of(&y)?.unwrap_or(0).min(f_up);
+            loss.push((f_up - without, h));
+        }
+        loss.sort_by_key(|&(l, h)| (std::cmp::Reverse(l), h));
+        let mut x = x_in.clone();
+        if let Some(config) = &config {
+            for &(_, h) in &loss {
+                x.insert(h);
+                if !split.playable(config, &x) {
+                    x.remove(&h);
+                }
+            }
+            if let Some(fx) = xsearch.f_of(&x)? {
+                if e + fx > incumbent {
+                    incumbent = e + fx;
+                    best_x = x.clone();
+                }
+                if fx == f_up {
+                    closed += 1;
+                    continue;
+                }
+            }
+        }
+        // Branch on the contended hub the fibers lose most without (with no configuration, on the free hub they lose
+        // most without).  A node with no free hub left and no configuration stays open, its bound unresolved.
+        let Some(&(l, h)) = loss.iter().find(|&&(_, h)| !x.contains(&h)) else {
+            unresolved.push(bound);
+            continue;
+        };
+        branchings += 1;
+        let mut x_in_child = x_in.clone();
+        x_in_child.insert(h);
+        nodes.push((x_in_child, x_out.clone()));
+        heap.push((bound, std::cmp::Reverse(nodes.len() - 1)));
+        let mut x_out_child = x_out;
+        x_out_child.insert(h);
+        nodes.push((x_in, x_out_child));
+        heap.push((bound - l, std::cmp::Reverse(nodes.len() - 1)));
+    }
+    let open: Vec<u64> =
+        heap.iter().map(|&(k, _)| k).chain(unresolved.iter().copied()).filter(|&k| k > incumbent).collect();
+    let finished = open.is_empty();
+    let upper = open.iter().copied().max().unwrap_or(incumbent).max(incumbent);
+    let gap = pb - opt;
+    let term_gap = in_the_bag + term_star - opt;
+    let added: Vec<u32> = best_x.difference(xstar).copied().collect();
+    let removed: Vec<u32> = xstar.difference(&best_x).copied().collect();
+    Ok(format!(
+        concat!(
+            "{{\"n\":{},\"B\":{},\"gap\":{},\"hubs\":{},\"X*\":{},\"term_gap\":{},\"root_bound_gap\":{},",
+            "\"finished\":{},\"max_gap\":{},\"max_gap_upper\":{},\"max_minus_term\":{},\"max_minus_term_upper\":{},",
+            "\"share_of_gap\":{:.4},\"share_of_gap_upper\":{:.4},\"best_x_added\":{:?},\"best_x_removed\":{:?},",
+            "\"E_runs\":{},\"E_stopped\":{},\"E_nodes\":{},\"E_cached\":{},\"F_solves\":{},\"hub_nodes\":{},",
+            "\"repushed\":{},\"closed\":{},\"branchings\":{},\"unresolved\":{},\"open\":{},\"threads\":{},",
+            "\"search_s\":{:.1},\"seconds\":{:.1}}}"
+        ),
+        args.n,
+        args.smooth,
+        gap,
+        all.len(),
+        xstar.len(),
+        term_gap,
+        root_bound.map_or("null".into(), |b: u64| (in_the_bag + b - opt).to_string()),
+        finished,
+        in_the_bag + incumbent - opt,
+        in_the_bag + upper - opt,
+        incumbent - term_star,
+        upper - term_star,
+        (incumbent - term_star) as f64 / gap.max(1) as f64,
+        (upper - term_star) as f64 / gap.max(1) as f64,
+        added,
+        removed,
+        xsearch.e_runs,
+        xsearch.e_stopped,
+        xsearch.e_nodes,
+        xsearch.e.len(),
+        xsearch.f_runs,
+        processed,
+        repushed,
+        closed,
+        branchings,
+        unresolved.len(),
+        open.len(),
+        args.threads,
+        t_search.elapsed().as_secs_f64(),
+        t0.elapsed().as_secs_f64()
+    ))
+}
