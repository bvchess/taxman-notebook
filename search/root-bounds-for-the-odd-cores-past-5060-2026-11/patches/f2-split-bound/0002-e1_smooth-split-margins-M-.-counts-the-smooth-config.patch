+/// The smooth configurations within the margins `args.margins` of E(X) = `e` (item 4 of the report's Section 4): one
+/// k-best enumeration at the largest margin, all smooth-playable sets above E(X) less it, whose counts at the smaller
+/// margins are final as soon as every open node's bound is below them.  The best-first order makes that early: a node's
+/// key bounds every set in it.  `e_nodes` is what finding E(X) took.  The JSON line.
+fn enumerate_near<const W: usize>(
+    split: &Split<'_, W>,
+    args: &Args,
+    xs: &BTreeSet<u32>,
+    e: u64,
+    e_nodes: u64,
+    t0: Instant,
+) -> Result<String, String> {
+    let most = *args.margins.iter().max().expect("a margin");
+    let t_enum = Instant::now();
+    let left = args.seconds - t0.elapsed().as_secs_f64();
+    let floor = e.saturating_sub(most);
+    let (_, s) = split.smooth(xs, floor.saturating_sub(1), true, args, left, t0)?.ok_or("the smooth sources do not peel")?;
+    if let Some(&w) = s.found.iter().find(|&&w| w > e) {
+        return Err(format!("the enumeration found a configuration of {w}, above E(X) = {e}"));
+    }
+    let upper = s.upper();
+    let counts: Vec<usize> = args.margins.iter().map(|&m| s.found.iter().filter(|&&w| w + m >= e).count()).collect();
+    let fin: Vec<bool> = args.margins.iter().map(|&m| !s.timed_out || upper + m < e).collect();
+    let mut bands = vec![0u64; (most / 25 + 1) as usize];
+    for &w in &s.found {
+        bands[((e - w) / 25) as usize] += 1;
+    }
+    Ok(format!(
+        concat!(
+            "{{\"n\":{},\"B\":{},\"X\":{},\"E\":{},\"E_nodes\":{},\"margins\":{:?},\"counts\":{:?},\"final\":{:?},",
+            "\"bands_of_25\":{:?},\"finished\":{},\"upper\":{},\"processed\":{},\"pushed\":{},\"open\":{},",
+            "\"max_depth\":{},\"thread_s\":{{\"solve\":{:.1},\"smooth\":{:.1},\"price\":{:.1}}},\"threads\":{},",
+            "\"enumeration_s\":{:.1},\"seconds\":{:.1}}}"
+        ),
+        args.n,
+        args.smooth,
+        xs.len(),
+        e,
+        e_nodes,
+        args.margins,
+        counts,
+        fin,
+        bands,
+        !s.timed_out,
+        upper,
+        s.processed,
+        s.pushed,
+        s.heap.len(),
+        s.max_depth,
+        s.times.solve,
+        s.times.smooth,
+        s.times.price,
+        args.threads,
+        t_enum.elapsed().as_secs_f64(),
+        t0.elapsed().as_secs_f64()
+    ))
+}
