+// ---------------------------------------------------------------------------------------------------------------
+// The largest X-term (item 2 of the report's Section 4)
+//
+// max_X [E(X) + F(X)] over all sets X of hubs, by a best-first branch and bound over hub sets.  A node forces the hubs
+// X_in into X and X_out out of it; the others are free.  E(X) never rises as X grows (deleting a column never makes a
+// set playable, nor independent) and F(X) never falls, so every X of the node has E(X) + F(X) ≤ E(X_in) + F(H − X_out),
+// H all the hubs: the node's bound.  Let C be a configuration that attains E(X_in).  The free hubs C can do without are
+// taken into X greedily, those whose loss lowers F(H − X_out) most first, as long as C still peels: that X has E(X) =
+// E(X_in), so E(X_in) + F(X) is an X-term, a lower bound on the maximum; and if F(X) = F(H − X_out) it attains the
+// node's bound, which closes the node.  Otherwise the node branches on a *contended* hub: a free hub that C needs (C
+// does not peel once it is deleted too: a smooth row of C that lists it stalls) and whose loss lowers F most (the
+// fibers' heaviest set uses it), into X in one child and out of it in the other.  The X-term at X* starts as the
+// incumbent.  E(X) and F(X) are cached by X, and E(X) is found against the incumbent: only whether it beats the
+// incumbent less F(H − X_out) matters, and if it does, its value and a configuration attaining it.  A search for E(X)
+// stopped by its budget (`--e-seconds`) leaves its upper bound in E's place and no configuration, and its node branches
+// on the free hub the fibers lose most without.
+
+/// What is known of E(X): its value and a configuration that attains it; that it is at most a value, the incumbent of a
+/// search that found no leaf above it; an upper bound left by a search stopped by its budget; or that the smooth
+/// sources do not peel without X.
+#[derive(Clone)]
+enum Known {
+    Exact(u64, Vec<u32>),
+    AtMost(u64),
+    Stopped(u64),
+    Infeasible,
+}
+
+/// What the search over hub sets learns of E(X) against a threshold.
+enum EAnswer {
+    /// E(X) is at most the threshold (or no set peels without X).
+    Cut,
+    /// The search for E(X) ran out of its budget: E(X) is at most this, above the threshold.
+    Upper(u64),
+    /// E(X), above the threshold, and a configuration attaining it.
+    Exact(u64, Vec<u32>),
+}
+
+/// The caches and counters of the search over hub sets.
+struct XSearch<'s, 'a, const W: usize> {
+    split: &'s Split<'a, W>,
+    args: &'s Args,
+    t0: Instant,
+    /// The time the search must end by, in seconds from `t0`.
+    deadline: f64,
+    e: HashMap<Vec<u32>, Known>,
+    f: HashMap<Vec<u32>, Option<u64>>,
+    /// Branch and bounds run for E, those stopped by their budget, and their nodes; F solves.
+    e_runs: u64,
+    e_stopped: u64,
+    e_nodes: u64,
+    f_runs: u64,
+    out_of_time: bool,
+}
+
+impl<const W: usize> XSearch<'_, '_, W> {
+    /// F(Y) for the usable hubs `y`; `None` if the fiber sources are dependent without the others.
+    fn f_of(&mut self, y: &BTreeSet<u32>) -> Result<Option<u64>, String> {
+        let key: Vec<u32> = y.iter().copied().collect();
+        if let Some(&v) = self.f.get(&key) {
+            return Ok(v);
+        }
+        self.f_runs += 1;
+        let v = self.split.fiber(y)?;
+        self.f.insert(key, v);
+        Ok(v)
+    }
+
+    /// What E(X) is against the threshold `above`, from the cache or a search of at most `--e-seconds`; `Cut` also when
+    /// the time of the whole search ran out (then `out_of_time`).
+    fn e_of(&mut self, x: &BTreeSet<u32>, above: u64) -> Result<EAnswer, String> {
+        let key: Vec<u32> = x.iter().copied().collect();
+        match self.e.get(&key) {
+            Some(Known::Exact(v, c)) => return Ok(if *v > above { EAnswer::Exact(*v, c.clone()) } else { EAnswer::Cut }),
+            Some(Known::AtMost(v) | Known::Stopped(v)) if *v <= above => return Ok(EAnswer::Cut),
+            Some(Known::Stopped(v)) => return Ok(EAnswer::Upper(*v)),
+            Some(Known::Infeasible) => return Ok(EAnswer::Cut),
+            _ => {}
+        }
+        let left = self.deadline - self.t0.elapsed().as_secs_f64();
+        if left <= 0.0 {
+            self.out_of_time = true;
+            return Ok(EAnswer::Cut);
+        }
+        let budget = left.min(self.args.e_seconds);
+        let Some((_, s)) = self.split.smooth(x, above, false, self.args, budget, self.t0)? else {
+            self.e.insert(key, Known::Infeasible);
+            return Ok(EAnswer::Cut);
+        };
+        self.e_runs += 1;
+        self.e_nodes += s.processed;
+        if s.timed_out {
+            if budget >= left {
+                self.out_of_time = true;
+                return Ok(EAnswer::Cut);
+            }
+            self.e_stopped += 1;
+            let upper = s.upper();
+            self.e.insert(key, Known::Stopped(upper));
+            return Ok(if upper > above { EAnswer::Upper(upper) } else { EAnswer::Cut });
+        }
+        match s.best_leaf {
+            Some((_, _, leaf)) => {
+                self.e.insert(key, Known::Exact(s.best, leaf.clone()));
+                Ok(EAnswer::Exact(s.best, leaf))
+            }
+            None => {
+                self.e.insert(key, Known::AtMost(above));
+                Ok(EAnswer::Cut)
+            }
+        }
+    }
+}
