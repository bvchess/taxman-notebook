+/// Whether in every frame of `columns` (factors, then moves, for each frame) the moves' vectors, their maximal factors
+/// among the frame's factors, are independent over GF(2), as [`Gf2Graph::new`] needs.
+fn moves_independent(t: &Tables, columns: &[Vec<u32>]) -> bool {
+    columns.chunks(2).all(|frame| {
+        let (factors, moves) = (&frame[0], &frame[1]);
+        let coord: HashMap<u32, usize> = factors.iter().enumerate().map(|(i, &y)| (y, i)).collect();
+        let words = factors.len().div_ceil(64).max(1);
+        let mut pivots: Vec<Option<Vec<u64>>> = vec![None; 64 * words];
+        moves.iter().all(|&m| {
+            let mut v = vec![0u64; words];
+            for f in &t.max_factors[m as usize] {
+                if let Some(&c) = coord.get(f) {
+                    v[c / 64] |= 1 << (c % 64);
+                }
+            }
+            loop {
+                let Some(p) = (0..words).find(|&i| v[i] != 0).map(|i| 64 * i + v[i].trailing_zeros() as usize) else {
+                    return false;
+                };
+                if let Some(row) = &pivots[p] {
+                    for (a, b) in v.iter_mut().zip(row) {
+                        *a ^= b;
+                    }
+                } else {
+                    pivots[p] = Some(v);
+                    return true;
+                }
+            }
+        })
+    })
+}
