+/// The split's two parts of one board, and what the searches for E(X) and F(X) need of it.
+struct Split<'a, const W: usize> {
+    board: &'a Board<W>,
+    /// The smooth board with no column deleted.
+    sb: SmoothBoard,
+    /// The candidates of both parts: the numbers of layer 3 and up, at most n/2.
+    cands: Vec<u32>,
+    hubs: BTreeSet<u32>,
+    /// The largest layer on the board.
+    top: u32,
+}
+
+impl<'a, const W: usize> Split<'a, W> {
+    fn new(board: &'a Board<W>, smooth: u32) -> Self {
+        let t = &board.tables;
+        let sb = SmoothBoard::new(t, smooth);
+        let cands: Vec<u32> = (2..=t.n / 2).filter(|&x| t.omega(x) >= 3).collect();
+        let mut hubs = BTreeSet::new();
+        for &x in board.plain.iter().chain(&cands) {
+            if !sb.is_smooth(x) {
+                let m = x / sb.largest[x as usize];
+                if sb.is_smooth(m) {
+                    hubs.insert(m);
+                }
+            }
+        }
+        let top = (2..=t.n).map(|x| t.omega(x)).max().unwrap_or(0);
+        Split { board, sb, cands, hubs, top }
+    }
+
+    /// One part's frames by layer, factors then moves for each layer k ≥ 3 of the moves: the smooth part's with the
+    /// hubs `xs` deleted, or the fiber part's with the hubs outside `xs` deleted.
+    fn columns(&self, smooth: bool, xs: &BTreeSet<u32>) -> Vec<Vec<u32>> {
+        let (t, sb) = (&self.board.tables, &self.sb);
+        let factor = |y: u32| if smooth { sb.is_smooth(y) && !xs.contains(&y) } else { !sb.is_smooth(y) || xs.contains(&y) };
+        let mut out = Vec::new();
+        for k in 3..=self.top {
+            out.push((2..=t.n / 2).filter(|&y| t.omega(y) == k - 1 && factor(y)).collect());
+            out.push(self.board.plain.iter().copied().filter(|&s| t.omega(s) == k && sb.is_smooth(s) == smooth).collect());
+        }
+        out
+    }
+
+    /// F(Y), the fiber part's GF(2) bound with the hubs outside `usable` deleted; `None` if the fiber sources are then
+    /// dependent (no set is independent).
+    fn fiber(&self, usable: &BTreeSet<u32>) -> Result<Option<u64>, String> {
+        let columns = self.columns(false, usable);
+        if !moves_independent(&self.board.tables, &columns) {
+            return Ok(None);
+        }
+        let cands: Bits<W> = self.cands.iter().copied().filter(|&x| !self.sb.is_smooth(x)).collect();
+        let (model, root) = FrameGraph::build::<W>(&self.board.tables, &columns)?;
+        let graph = Gf2Graph::new(&model, &root, &cands);
+        let mut bound = Gf2Bound::<W>::new(&graph);
+        bound.reset(&Bits::EMPTY, &cands);
+        Ok(Some(bound.evaluate(graph.len() as u32 + 1, None).value))
+    }
+
+    /// The smooth board with the hubs `xs` deleted from every list.
+    fn smooth_board(&self, xs: &BTreeSet<u32>) -> SmoothBoard {
+        let mut sb = self.sb.clone();
+        for &x in xs {
+            sb.dead[x as usize] = true;
+        }
+        sb
+    }
+
+    /// Whether the smooth sources with the promotions `config` peel with the hubs `xs` deleted.
+    fn playable(&self, config: &[u32], xs: &BTreeSet<u32>) -> bool {
+        smooth_playable(&self.smooth_board(xs), &(Bits::<W>::from_slice(&self.board.plain) | Bits::from_slice(config)))
+    }
+
+    /// The branch and bound on the smooth part with the hubs `xs` deleted, against the incumbent `best`, for at most
+    /// `seconds`: E(X) if a leaf beats it (else E(X) ≤ `best`), or with `enumerate` every smooth-playable set above
+    /// `best`.  The root bound and the search's end; `None` if the smooth sources do not peel without `xs`, so that no
+    /// set does (and a frame's moves may be dependent, which [`Gf2Graph::new`] refuses).
+    fn smooth(
+        &self,
+        xs: &BTreeSet<u32>,
+        best: u64,
+        enumerate: bool,
+        args: &Args,
+        seconds: f64,
+        t0: Instant,
+    ) -> Result<Option<(u64, Shared)>, String> {
+        if !self.playable(&[], xs) {
+            return Ok(None);
+        }
+        let sb = self.smooth_board(xs);
+        let cands: Bits<W> = self.cands.iter().copied().filter(|&x| sb.is_smooth(x) && !xs.contains(&x)).collect();
+        let (model, root) = FrameGraph::build::<W>(&self.board.tables, &self.columns(true, xs))?;
+        let graph = Gf2Graph::new(&model, &root, &cands);
+        let problem = Problem {
+            graph: &graph,
+            sb: &sb,
+            base: Bits::from_slice(&self.board.plain),
+            ground: cands,
+            in_the_bag: 0,
+            cap: graph.len() as u32 + 1,
+            orders: args.orders,
+            hubs: false,
+            hub_budget: args.hub_budget,
+            enumerate,
+        };
+        let mut w0 = Worker::new(&problem, 1);
+        let (root_bound, _) = w0.process(&[], &[], 0);
+        drop(w0);
+        Ok(Some((root_bound, best_first(&problem, args, root_bound, best, None, seconds, t0))))
+    }
+}
