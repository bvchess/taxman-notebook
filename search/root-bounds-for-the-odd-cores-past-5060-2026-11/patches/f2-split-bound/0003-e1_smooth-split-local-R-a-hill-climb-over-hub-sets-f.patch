+/// A hill climb over hub sets from X* (`start`, `f_star` and `board` as for [`max_over_x`]), for a lower bound on
+/// max_X [E(X) + F(X)] where the search over hub sets cannot finish.  Each round tries every set that differs from its
+/// centre in at most `args.local` hubs and was not tried before, the most promising first by the optimistic bound
+/// E(X)'s root bound + F(X), against the best X-term so far, and skips a set whose optimistic bound cannot beat it.  The
+/// next round starts from the best; the climb ends when a round finds nothing better.  Its best is then the largest
+/// X-term within the radius of its last centre, unless a search for E(X) ran out of its budget (`unresolved`).  The JSON
+/// line.
+fn hill_climb<const W: usize>(
+    split: &Split<'_, W>,
+    args: &Args,
+    start: (&BTreeSet<u32>, u64, Vec<u32>),
+    f_star: u64,
+    board: (u64, u64, u64),
+    t0: Instant,
+) -> Result<String, String> {
+    let (xstar, e_star, c_star) = start;
+    let (opt, pb, in_the_bag) = board;
+    let t_search = Instant::now();
+    let hubs: Vec<u32> = split.hubs.iter().copied().collect();
+    let mut xsearch = XSearch {
+        split,
+        args,
+        t0,
+        deadline: args.seconds,
+        e: HashMap::new(),
+        f: HashMap::new(),
+        e_runs: 0,
+        e_stopped: 0,
+        e_nodes: 0,
+        f_runs: 0,
+        out_of_time: false,
+    };
+    xsearch.e.insert(xstar.iter().copied().collect(), Known::Exact(e_star, c_star));
+    xsearch.f.insert(xstar.iter().copied().collect(), Some(f_star));
+    let term_star = e_star + f_star;
+    let (mut best, mut best_x) = (term_star, xstar.clone());
+    let mut seen: HashSet<Vec<u32>> = HashSet::from([xstar.iter().copied().collect()]);
+    let (mut rounds, mut tried, mut pruned, mut root_bounds) = (0u64, 0u64, 0u64, 0u64);
+    let mut unresolved: Vec<u64> = Vec::new();
+    let mut flips: Vec<Vec<usize>> = Vec::new();
+    for r in 1..=args.local {
+        for_each_combination(hubs.len(), r, |c| {
+            flips.push(c.to_vec());
+            true
+        });
+    }
+    let out_of_time = |xsearch: &XSearch<'_, '_, W>| xsearch.out_of_time || t0.elapsed().as_secs_f64() > args.seconds;
+    let mut complete = true;
+    'climb: loop {
+        rounds += 1;
+        let centre = best_x.clone();
+        let before = best;
+        // The sets of the round, with F(X) and their optimistic bounds.
+        let mut round: Vec<(u64, BTreeSet<u32>, u64)> = Vec::new();
+        for c in &flips {
+            if out_of_time(&xsearch) {
+                complete = false;
+                break 'climb;
+            }
+            let mut x = centre.clone();
+            for &i in c {
+                if !x.remove(&hubs[i]) {
+                    x.insert(hubs[i]);
+                }
+            }
+            if !seen.insert(x.iter().copied().collect()) {
+                continue;
+            }
+            let Some(f) = xsearch.f_of(&x)? else { continue };
+            root_bounds += 1;
+            let Some(e_root) = split.root_bound(true, &x)? else { continue };
+            if e_root + f <= best {
+                pruned += 1;
+                continue;
+            }
+            round.push((e_root + f, x, f));
+        }
+        round.sort_by(|a, b| b.0.cmp(&a.0));
+        for (optimistic, x, f) in round {
+            if optimistic <= best {
+                pruned += 1;
+                continue;
+            }
+            if out_of_time(&xsearch) {
+                complete = false;
+                break 'climb;
+            }
+            tried += 1;
+            match xsearch.e_of(&x, best.saturating_sub(f))? {
+                EAnswer::Exact(e, _) => {
+                    best = e + f;
+                    best_x = x;
+                }
+                EAnswer::Upper(u) => unresolved.push(u + f),
+                EAnswer::Cut => {}
+            }
+            if xsearch.out_of_time {
+                complete = false;
+                break 'climb;
+            }
+        }
+        if best == before {
+            break;
+        }
+    }
+    let gap = pb - opt;
+    let open: Vec<u64> = unresolved.iter().copied().filter(|&u| u > best).collect();
+    let added: Vec<u32> = best_x.difference(xstar).copied().collect();
+    let removed: Vec<u32> = xstar.difference(&best_x).copied().collect();
+    Ok(format!(
+        concat!(
+            "{{\"n\":{},\"B\":{},\"radius\":{},\"gap\":{},\"hubs\":{},\"X*\":{},\"term_gap\":{},\"complete\":{},",
+            "\"best_gap\":{},\"best_minus_term\":{},\"share_of_gap\":{:.4},\"unresolved\":{},\"unresolved_upper_gap\":{},",
+            "\"best_x_added\":{:?},\"best_x_removed\":{:?},\"rounds\":{},\"root_bounds\":{},\"pruned\":{},\"tried\":{},",
+            "\"E_runs\":{},\"E_stopped\":{},\"E_nodes\":{},\"F_solves\":{},\"threads\":{},\"search_s\":{:.1},\"seconds\":{:.1}}}"
+        ),
+        args.n,
+        args.smooth,
+        args.local,
+        gap,
+        hubs.len(),
+        xstar.len(),
+        in_the_bag + term_star - opt,
+        complete,
+        in_the_bag + best - opt,
+        best - term_star,
+        (best - term_star) as f64 / gap.max(1) as f64,
+        open.len(),
+        open.iter().max().map_or("null".into(), |&u| (in_the_bag + u - opt).to_string()),
+        added,
+        removed,
+        rounds,
+        root_bounds,
+        pruned,
+        tried,
+        xsearch.e_runs,
+        xsearch.e_stopped,
+        xsearch.e_nodes,
+        xsearch.f_runs,
+        args.threads,
+        t_search.elapsed().as_secs_f64(),
+        t0.elapsed().as_secs_f64()
+    ))
+}
+
