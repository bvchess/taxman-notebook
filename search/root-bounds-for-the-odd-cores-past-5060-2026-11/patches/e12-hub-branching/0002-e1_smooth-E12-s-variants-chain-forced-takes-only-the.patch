+/// The bound of the child S of the hubs `own_s` and `own_f` that picks `picks` and bars `bars`: the heaviest set of its
+/// instance, without forced members (`None` if no set exists there).
+fn probe<const W: usize>(
+    p: &Problem<W>,
+    st: &mut State,
+    own_s: &[u32],
+    own_f: &[u32],
+    picks: &[u32],
+    bars: &[u32],
+) -> Option<u64> {
+    let graph = instance_for(p, st, own_s, own_f)?;
+    let clock = Instant::now();
+    let pk: Bits<W> = Bits::from_slice(picks);
+    if graph.circuit(&pk).is_some() {
+        return None;
+    }
+    let mut gf2 = Gf2Bound::new(&graph);
+    gf2.reset(&pk, &(p.ground - pk - Bits::from_slice(bars)));
+    let value = gf2.evaluate(graph.len() as u32 + 1, None).value;
+    st.augmentations += gf2.stats().augmentations;
+    st.times.solve += clock.elapsed().as_secs_f64();
+    Some(p.in_the_bag + pk.sum() + value)
+}
