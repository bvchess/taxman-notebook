+impl<'a, const W: usize> Gf2Frames<'a, W> {
+    /// The frames of `state` (all winnable) and the vectors of the candidates `cands`.
+    pub fn new(model: &'a FrameGraph, state: &'a FrameSet<W>, cands: &Bits<W>) -> Self {
         let frames = state.frames();
         let max = frames.iter().flat_map(|f| f.factors.max().into_iter().chain(f.moves.max())).max().unwrap_or(0);
         let max = max.max(cands.max().unwrap_or(0));
+        let keep = &|_, _| false;
         let spaces: Vec<FrameSpace> = (frames.iter())
-            .map(|f| FrameSpace::new(model, &f.factors, &f.moves, max, drop).ok())
-            .collect::<Option<_>>()?;
-        let ranks: Vec<usize> = spaces.iter().map(|s| s.rank).collect();
-        let words = ranks.iter().copied().max().unwrap_or(0).div_ceil(64).max(1);
+            .map(|f| FrameSpace::new(model, &f.factors, &f.moves, max, keep).expect("a winnable frame"))
+            .collect();
+        let words = spaces.iter().map(|s| s.rank).max().unwrap_or(0).div_ceil(64).max(1);
+        let mut vectors = Vec::new();
+        for x in cands.iter() {
+            let h = model.home(x);
+            if h == 0 || h >= frames.len() || !frames[h].factors.contains(x) {
+                continue;
+            }
+            let out = spaces[h].project(spaces[h].unit(x), words);
+            let into = spaces[h - 1].project(spaces[h - 1].vector(model, x, keep), words);
+            vectors.push((x, out, into));
+        }
+        Gf2Frames { model, state, max, words, spaces, vectors }
+    }
+
+    /// The vectors on the two sides of the candidates in the instance where each mover `u` (a move, or a candidate
+    /// promoted) does not list the factors `q` with `drop(u, q)`: a set of moves that never pays `u` with `q` is
+    /// playable in that instance whenever it is playable, so every such promotion set is independent there too.
+    /// Candidates whose vector is zero on either side there (no promotable set holds them) are left out.  `None` if a
+    /// frame's moves are dependent there, so that no such set exists.  A frame is made again only where one of its
+    /// moves loses a factor, and a candidate's vector only in such a frame or where it loses a factor itself.
+    pub fn graph(&self, drop: Dropped) -> Option<Gf2Graph> {
+        let (model, frames, words) = (self.model, self.state.frames(), self.words);
+        let loses = |u: u32, factors: &Bits<W>| {
+            model.graph().factors(u).iter().any(|&q| drop(u, u32::from(q)) && factors.contains(u32::from(q)))
