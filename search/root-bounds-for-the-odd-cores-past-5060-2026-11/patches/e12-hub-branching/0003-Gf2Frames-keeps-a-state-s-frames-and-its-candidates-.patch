+        let mut again: Vec<Option<FrameSpace>> = Vec::with_capacity(frames.len());
+        for f in frames {
+            again.push(match f.moves.iter().any(|u| loses(u, &f.factors)) {
+                true => Some(FrameSpace::new(model, &f.factors, &f.moves, self.max, drop).ok()?),
+                false => None,
+            });
+        }
+        let ranks: Vec<usize> = self.spaces.iter().map(|s| s.rank).collect();
