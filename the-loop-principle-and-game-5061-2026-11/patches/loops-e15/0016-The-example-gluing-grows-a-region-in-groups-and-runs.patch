+/// The recorded set of N (`moves`, scoring `score`) with its cells on `region` replaced by those of a witness (the held
+/// sources less N, and the candidate cells `witness`), decided by the crate's peel on board N − 1, independently of the
+/// lemma, and replayed by the rules: one line, with what the lemma would give, ΣS − N + gain, beside opt(N − 1).
+fn glue(g: &Game, region: &[usize], moves: &[u32], witness: &[u32], gain: i64, score: u64, opt_before: u64) -> String {
+    let n = g.tables.n;
+    let in_region = |x: u32| {
+        region.iter().any(|&c| {
+            let col = &g.columns[c];
+            x % col.p == 0
+                && g.rows.bit.get((x / col.p) as usize).copied().flatten().is_some_and(|b| col.rows >> b & 1 == 1)
+        })
+    };
+    let mut glued: Vec<u32> = moves.iter().copied().filter(|&x| !in_region(x)).collect();
+    let fixed: Vec<u64> = region.iter().map(|&c| g.columns[c].before[0].mask).collect();
+    glued.extend(numbers(g, region, &fixed));
+    glued.extend(witness.iter().copied());
+    glued.sort_unstable();
+    let before = &g.tables_before;
+    let ok = playable(before, &glued);
+    let sum: u64 = glued.iter().map(|&x| u64::from(x)).sum();
+    let replayed = play_order(before, &glued).map(|order| replay(n - 1, &order));
+    format!(
+        "glued O ∪ W′ on board {}: {} members, playable by the peel {ok}, sum {sum}, replayed {replayed:?}, opt({}) = \
+         {opt_before}, ΣS − N + gain = {}",
+        n - 1,
+        glued.len(),
+        n - 1,
+        score as i64 - i64::from(n) + gain
+    )
+}
