+/// The question at one game and mode: the roles of the root, the target and the parity bound's weights.
+#[derive(Clone)]
+struct Question {
+    n: u32,
+    m: u32,
+    x: u32,
+    mode: Mode,
+    pstar: u64,
+    target: u64,
+    roles: Vec<Role>,
+    weights: Vec<i64>,
+}
+
+impl Question {
+    fn mode_name(&self) -> &'static str {
+        match self.mode {
+            Mode::Ghost => "ghost",
+            Mode::Plain => "plain",
+            Mode::Hole => "hole",
+        }
+    }
+
+    /// The prover of a thread: the parity bound on, x forced in it alone in the ghost mode.
+    fn prover<'b>(&self, board: &'b Board, budget: u64) -> Prover<'b> {
+        let prover = Prover::new(board, self.target, budget);
+        if self.mode == Mode::Ghost {
+            prover.with_parity_forcing(&[self.x], &self.weights)
+        } else {
+            prover.with_parity()
+        }
+    }
+
+    /// The root's bounds as promotions: the forced picks playable, the matching bound and the parity bound (None
+    /// where the forced picks cannot be matched or are dependent).
+    fn root(&self, board: &Board) -> (bool, Option<i64>, Option<i64>) {
+        let forced: Vec<bool> = self.roles.iter().map(|&r| r == Role::Pick).collect();
+        let base = (self.target - self.pstar) as i64;
+        let matching = MatchingBound::new(board).solve(board, &self.roles).map(|(v, _)| v as i64 - base);
+        let mut parity_roles = self.roles.clone();
+        if self.mode == Mode::Ghost {
+            parity_roles[self.x as usize] = Role::Pick;
+        }
+        let parity = match Meet::new(Parity::pair(board, &self.weights)).solve(&parity_roles) {
+            Outcome::Bound(b) => Some(b.value - base),
+            _ => None,
+        };
+        (board.playable(&forced), matching, parity)
+    }
+
+    /// The line of a search that came to `verdict`, with a set found checked again: its playability by the board's
+    /// peel, its weight, and its independence at both parities (with x in the ghost mode).
+    fn line(&self, board: &Board, verdict: &Verdict, nodes: u64, seconds: f64, threads: usize, more: &str) -> String {
+        let list = |set: &[u32]| set.iter().map(u32::to_string).collect::<Vec<_>>().join(",");
+        let (answer, found) = match verdict {
+            Verdict::Proven => ("no set beats P*", None),
+            Verdict::Beaten(set) => ("a set beats P*", Some(set.clone())),
+            Verdict::Budget | Verdict::Paused => ("stopped", None),
+        };
+        let found_text = match &found {
+            None => "null".to_owned(),
+            Some(set) => {
+                let mut pick = vec![false; self.m as usize + 1];
+                set.iter().for_each(|&c| pick[c as usize] = true);
+                let lower: Vec<u32> = set.iter().copied().filter(|&c| c <= self.m / 2).collect();
+                let weight: u64 = lower.iter().map(|&c| u64::from(c)).sum();
+                let mut check = vec![Role::Barred; self.m as usize + 1];
+                set.iter().for_each(|&c| check[c as usize] = Role::Pick);
+                if self.mode == Mode::Ghost {
+                    check[self.x as usize] = Role::Pick;
+                }
+                let independent =
+                    !matches!(Meet::new(Parity::pair(board, &self.weights)).solve(&check), Outcome::Infeasible);
+                format!(
+                    "{{\"promotions\":[{}],\"above_pstar\":{},\"holds_x\":{},\"playable_again\":{},\
+                     \"independent_at_both_parities\":{independent}}}",
+                    list(&lower),
+                    weight as i64 - self.pstar as i64,
+                    set.contains(&self.x),
+                    board.playable(&pick)
+                )
+            }
+        };
+        let (forced_playable, matching, parity) = self.root(board);
+        let shown = |v: Option<i64>| v.map_or("null".to_owned(), |v| v.to_string());
+        format!(
+            "{{\"n\":{},\"m\":{},\"x\":{},\"mode\":\"{}\",\"pstar\":{},\"forced_playable\":{forced_playable},\
+             \"root_matching\":{},\"root_parity\":{},\"answer\":\"{answer}\",\"nodes\":{nodes},\"threads\":{threads},\
+             {more}\"seconds\":{seconds:.3},\"found\":{found_text}}}",
+            self.n,
+            self.m,
+            self.x,
+            self.mode_name(),
+            self.pstar,
+            shown(matching),
+            shown(parity),
+        )
+    }
+}
