diff --git a/solver/frame/src/search/trace.rs b/solver/frame/src/search/trace.rs
new file mode 100644
index 0000000..f002282
--- /dev/null
+++ b/solver/frame/src/search/trace.rs
@@ -0,0 +1,37 @@
+//! A trace of a search's refutations, for experiments that study the proofs the search makes: each heaviest set of a
+//! node's bound that reaches the node's need and cannot be promoted, and each nogood a searcher learns.
+//!
+//! The trace is off unless a caller installs a [`Refutations`] hook ([`install`], once a process).  With none, each
+//! place that would report costs one load of a `OnceLock`, and the search does what it does without the trace: the hook
+//! only reads what the search hands it, so the search's tree is the same either way.
+
+use std::sync::OnceLock;
+
+/// What a search reports to an installed hook.  The calls come from every searcher thread, concurrently.
+pub trait Refutations: Send + Sync {
+    /// A node with the promotions `promoted` whose bound's heaviest set `chosen` (disjoint from `promoted`) reaches
+    /// the node's need and cannot be promoted from it: `promoted ∪ chosen` is refuted.  `conflict` is the conflict of
+    /// `chosen` that the node goes on with (relative to `promoted`, a subset of `chosen`), or `None` where a nogood all
+    /// of whose members are forced or promoted ended the node.  Sets ascending.
+    fn refuted(&self, promoted: &[u32], chosen: &[u32], conflict: Option<&[u32]>);
+
+    /// A nogood a searcher's table learned: a set of candidates that cannot be promoted from the search's root.
+    fn learned(&self, nogood: &[u32]);
+}
+
+static HOOK: OnceLock<Box<dyn Refutations>> = OnceLock::new();
+
+/// Installs `hook` for every search of the process from now on.
+///
+/// # Errors
+///
+/// If a hook was installed before.
+pub fn install(hook: Box<dyn Refutations>) -> Result<(), String> {
+    HOOK.set(hook).map_err(|_| "a refutations hook is installed already".to_owned())
+}
+
+/// The installed hook, if any.
+#[inline]
+pub(crate) fn hook() -> Option<&'static dyn Refutations> {
+    HOOK.get().map(|hook| hook.as_ref())
+}
