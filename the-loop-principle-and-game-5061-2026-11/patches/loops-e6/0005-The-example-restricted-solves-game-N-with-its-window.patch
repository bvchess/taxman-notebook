+/// The tactics of `--tactic NAME=VALUE`, and how a search runs by `--threads`, `--background` and `--time-limit`.
+fn run_of(args: &[String]) -> (Tactics, Run) {
+    let mut tactics = Tactics::default();
+    for (i, _) in args.iter().enumerate().filter(|(_, a)| *a == "--tactic") {
+        tactics.set(&args[i + 1]).unwrap_or_else(|e| panic!("{e}"));
+    }
+    let run = Run {
+        tactics: tactics.search,
+        threads: count(args, "--threads", 1),
+        background: args.iter().any(|a| a == "--background"),
+        time_limit: value(args, "--time-limit").map(|s| Duration::from_secs_f64(s.parse().expect("seconds"))),
+        progress: Some(Duration::from_secs(60)),
+    };
+    (tactics, run)
+}
