-                real.playable(&pick)
+                set.contains(&x),
+                board.playable(&pick)
             )
         }
     };
@@ -128,9 +137,11 @@ fn main() {
         Mode::Hole => "hole",
     };
     println!(
-        "{{\"n\":{n},\"m\":{m},\"x\":{x},\"private_factor\":{},\"mode\":\"{mode_name}\",\"pstar\":{pstar},\
-         \"answer\":\"{answer}\",\"nodes\":{},\"stats\":{:?},\"seconds\":{seconds:.3},\"found\":{found_text}}}",
-        if mode == Mode::Ghost { private.to_string() } else { "null".to_owned() },
+        "{{\"n\":{n},\"m\":{m},\"x\":{x},\"mode\":\"{mode_name}\",\"pstar\":{pstar},\
+         \"forced_playable\":{forced_playable},\"root_matching\":{},\"root_parity\":{},\"answer\":\"{answer}\",\
+         \"nodes\":{},\"stats\":{:?},\"seconds\":{seconds:.3},\"found\":{found_text}}}",
+        root_matching.map_or("null".to_owned(), |v| v.to_string()),
+        root_parity.map_or("null".to_owned(), |v| v.to_string()),
         prover.nodes,
         prover.stats,
