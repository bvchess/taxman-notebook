-        _ => opt_m,
+    // x barred from the picks (ghost and hole), and in the ghost mode forced in the parity solve with weight 0.
+    if mode != Mode::Plain {
+        roles[x as usize] = Role::Barred;
+    }
+    let target = if mode == Mode::Plain { opt_m } else { opt_m - u64::from(x) };
+    // The root, as the search sees it: the forced picks playable, its matching bound and its parity bound, as
+    // promotions above P*(m) (None where the forced picks cannot be matched or are dependent).
+    let forced: Vec<bool> = roles.iter().map(|&r| r == Role::Pick).collect();
+    let forced_playable = board.playable(&forced);
+    let base = target - pstar;
+    let root_matching = MatchingBound::new(&board).solve(&board, &roles).map(|(v, _)| v as i64 - base as i64);
+    let mut weights: Vec<i64> = (0..=i64::from(m)).collect();
+    let mut parity_roles = roles.clone();
+    if mode == Mode::Ghost {
+        weights[x as usize] = 0;
+        parity_roles[x as usize] = Role::Pick;
+    }
+    let root_parity = match Meet::new(Parity::pair(&board, &weights)).solve(&parity_roles) {
+        Outcome::Bound(b) => Some(b.value - base as i64),
+        _ => None,
     };
-    let board = if mode == Mode::Ghost { &ghosted } else { &real };
     let started = Instant::now();
-    let mut prover = Prover::new(board, target, u64::MAX).with_parity_of(&real);
+    let mut prover = Prover::new(&board, target, u64::MAX);
+    prover = if mode == Mode::Ghost { prover.with_parity_forcing(&[x], &weights) } else { prover.with_parity() };
     if let Some(limit) = time_limit {
         prover = prover.pause_at(started + limit);
     }
@@ -109,16 +113,21 @@ fn main() {
             // The checks on the true board.
             let mut pick = vec![false; m as usize + 1];
             set.iter().for_each(|&c| pick[c as usize] = true);
-            if mode == Mode::Ghost {
-                pick[x as usize] = false;
-            }
             let lower: Vec<u32> = set.iter().copied().filter(|&c| c <= m / 2).collect();
