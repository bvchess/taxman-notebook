+/// The classes of [`Games::class`].
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Class {
+    PlayableInM,
+    NotXbound,
+    XboundTransfers,
+    XboundNotTransferred,
+}
+
+/// How many sets fell in each [`Class`].
+#[derive(Default)]
+struct Classes {
+    playable_in_m: u64,
+    not_xbound: u64,
+    xbound_transfers: u64,
+    xbound_not_transferred: u64,
+}
+
+impl Classes {
+    fn add(&mut self, class: Class) {
+        match class {
+            Class::PlayableInM => self.playable_in_m += 1,
+            Class::NotXbound => self.not_xbound += 1,
+            Class::XboundTransfers => self.xbound_transfers += 1,
+            Class::XboundNotTransferred => self.xbound_not_transferred += 1,
+        }
+    }
+
+    fn json(&self) -> String {
+        format!(
+            "\"playable_in_m\":{},\"not_xbound\":{},\"xbound_transfers\":{},\"xbound_not_transferred\":{}",
+            self.playable_in_m, self.not_xbound, self.xbound_transfers, self.xbound_not_transferred
+        )
+    }
+}
+
 /// What the refuted sets showed (each distinct set counted once).
