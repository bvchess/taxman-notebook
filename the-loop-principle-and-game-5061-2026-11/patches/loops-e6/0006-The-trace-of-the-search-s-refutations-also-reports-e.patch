+    fn failed(&self, promoted: &[u32], added: &[u32]) {
+        let mut set: Vec<u32> = promoted.iter().chain(added).copied().collect();
+        set.sort_unstable();
+        {
+            let mut s = self.state.lock().unwrap();
+            s.failed_events += 1;
+            if !s.failed_seen.insert(digest(&set)) {
+                return;
+            }
+        }
+        let class = self.games.class(&set);
+        let mut s = self.state.lock().unwrap();
+        s.failed.add(class);
+        if class == Class::XboundNotTransferred && s.sampled_failed < self.sample_cap {
+            s.sampled_failed += 1;
+            s.samples.push(Sample {
+                kind: "failed-not-transferred",
+                promoted: promoted.to_vec(),
+                chosen: added.to_vec(),
+                conflict: Some(added.to_vec()),
+            });
+        }
+    }
