+    /// The class of `set`, a set the search found it cannot promote in Π_m: found playable with U\*(m) by the peel (a
+    /// disagreement, none expected), not x-bound (a core without x: it cannot be promoted in Π_N either), x-bound and
+    /// not promotable in Π_N (it transfers), or x-bound and promotable in Π_N (it does not).
+    fn class(&self, set: &[u32]) -> Class {
+        if !self.refused_m(set) {
+            Class::PlayableInM
+        } else if !self.base_plays(set) {
+            Class::NotXbound
+        } else if self.refused_n(set) {
+            Class::XboundTransfers
+        } else {
+            Class::XboundNotTransferred
+        }
+    }
