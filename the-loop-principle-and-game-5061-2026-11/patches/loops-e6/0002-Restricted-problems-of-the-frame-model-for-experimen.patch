+//! Restricted problems of the frame model, each solved by an exact standalone search, and the checks of them on small
+//! boards: a board with holes, Y = `1..=n` without some numbers (the holes theorem (X9), docs/theory/exactness.md,
+//! "Boards with holes"), and candidates barred (never promoted) or fixed (promoted at the root).
+//!
+//! ```text
+//! cargo run --release --example restricted -- solve N [--holes Z,...] [--bar B,...] [--fix F,...] [--in-ustar X,...]
+//!     [--threads K] [--background] [--time-limit S] [--tactic NAME=VALUE]... [--show]
+//! cargo run --release --example restricted -- check-holes LO HI [--sets K] [--threads K]
+//! cargo run --release --example restricted -- check-bars LO HI [--threads K]
+//! cargo run --release --example restricted -- check-chain N... [--threads K]
+//! ```
+//!
+//! `solve` sets the board up (`Tables::with_holes`, then the frames), restricts the root (`Prepared::restricted`) and
+//! searches with no seed and no ceiling, so no game before it is used; the moves its promotions make are refereed on
+//! the board with holes (`game::replay_with_holes`), and must score ΣU\* + the promotion sum.  The answer is the
+//! heaviest promotion set that respects the restriction, and its score ΣU\* + P\*: on a board with holes, the best
+//! score on Y exactly when some best game of Y plays all of U\*(Y) (X9); with numbers barred or fixed, the best score
+//! of the games that play all of U\* and respect them (the exactness theorem (X7)).  Either way the moves are a legal
+//! game, so the score is a lower bound on the best score.  A barred or fixed number must be a candidate of the root,
+//! and a restricted search needs `--tactic symmetry=off` (the prime-exchange theorem (R2) is proved of a root).
+//!
+//! The checks compare, on every board of a range, the frame model's answer with answers that share nothing with the
+//! frames or the search:
+//!
+//! * `check-holes`: every single hole of each board, and `--sets` random pairs and triples of holes (default 3), and
+//!   no hole at all (against the built-in table).  Against `brute::solve_by` with the maximal-factor rule (the best
+//!   score on Y; equal given U on Y), against the heaviest set L ⊆ Y ∩ {2, …, ⌊n/2⌋} with U\*(Y) ∪ L playable on Y,
+//!   found by a walk over the playable sets (`playable::playable` on the tables of Y: X9's statement, equal whatever U
+//!   says), against U\*(Y) made again by descending greedy over the sources of Y, and the moves refereed.  It also
+//!   counts the hole sets where the game's own rule, a proper divisor in the pot (`brute::solve`), scores otherwise.
+//! * `check-bars`: on boards with no holes, each candidate barred, each candidate fixed, and each pair of a barred and
+//!   a fixed candidate, against the heaviest L with U\* ∪ L playable that respects them (X7), found by the same walk;
+//!   and a number that is no candidate refused.
+//! * `check-chain`: on boards of the chain, the recorded promotion set fixed in whole must score opt(n), and each of
+//!   its members barred at most opt(n).
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+use taxman::accelerate::solution_for_promotions;
+use taxman::bits::Bits;
+use taxman::board::Board;
+use taxman::brute::{self, Rule};
+use taxman::engine::EngineConfig;
+use taxman::game::{replay_with_holes, Optimal};
+use taxman::numtheory::Tables;
+use taxman::playable::playable;
+use taxman::rng::Rng;
+use taxman::search::{self, SearchTactics};
+use taxman::tactics::Tactics;
+
+/// A restricted problem: game `n` on the board without `holes`, with `barred` never promoted and `fixed` promoted.
+#[derive(Clone, Debug, Default)]
+struct Restricted {
+    n: u32,
+    holes: Vec<u32>,
+    barred: Vec<u32>,
+    fixed: Vec<u32>,
+}
+
+/// How a search runs.
+#[derive(Clone, Copy)]
+struct Run {
+    tactics: SearchTactics,
+    threads: usize,
+    background: bool,
+    time_limit: Option<Duration>,
+    progress: Option<Duration>,
+}
+
+/// What [`solve`] found.
+struct Answer {
+    /// U\*, ascending, and its sum.
+    ustar: Vec<u32>,
+    in_the_bag: u64,
+    /// The heaviest promotion set that respects the restriction, ascending, fixed members included; `None` when no
+    /// promotion set holds the fixed numbers.
+    promotions: Option<Vec<u32>>,
+    /// What the moves of `promotions` score, refereed on the board.
+    score: Option<u64>,
+    moves: Vec<u32>,
+    /// The moves still legal after `moves`: none when the game is over.
+    left: Vec<u32>,
+    /// The search explored its whole tree.
+    completed: bool,
+    nodes: u64,
+    seconds: f64,
+    /// The frames of the search that hold nothing: a layer of only closed frames between two with freedoms (X9).
+    empty_frames: usize,
+}
+
+fn solve(r: &Restricted, run: Run) -> Result<Answer, String> {
+    taxman::with_width!(r.n, W => solve_at::<W>(r, run))
+}
+
+fn solve_at<const W: usize>(r: &Restricted, run: Run) -> Result<Answer, String> {
+    let started = Instant::now();
+    let board = Board::<W>::new(Tables::with_holes(r.n, &r.holes)?);
+    let mut ustar = board.plain.clone();
+    ustar.sort_unstable();
+    let empty_frames = board.frames.frames.iter().filter(|f| f.moves.is_empty() && f.factors.is_empty()).count();
+    let (barred, fixed): (Bits<W>, Bits<W>) = (r.barred.iter().copied().collect(), r.fixed.iter().copied().collect());
+    let restricted = !(barred.is_empty() && fixed.is_empty());
+    if board.is_trivial() && restricted {
+        return Err(format!("game {} has no candidates to bar or fix", r.n));
+    }
+    let (mut promotions, mut completed, mut nodes) = (Some(Bits::<W>::EMPTY), true, 0);
+    if !board.is_trivial() {
+        let prepared = board.prepare(run.tactics)?;
+        let prepared = if restricted { prepared.restricted(&barred, &fixed)? } else { Some(prepared) };
+        promotions = None;
+        if let Some(prepared) = prepared {
+            let cfg = EngineConfig {
+                threads: run.threads,
+                background: run.background,
+                time_limit: run.time_limit,
+                progress: run.progress,
+                label: format!("n={}", r.n),
+                ..EngineConfig::default()
+            };
+            let found = search::search(&prepared, &cfg, None, None, false).map_err(|e| format!("search: {e}"))?;
+            promotions = Some(found.promotions | fixed);
+            (completed, nodes) = (found.completed, found.stats.nodes);
+        }
+    }
+    let (mut score, mut moves, mut left) = (None, Vec::new(), Vec::new());
+    if let Some(set) = promotions {
+        moves = solution_for_promotions::<W>(&board.tables, set);
+        let (refereed, after) = replay_with_holes(r.n, &r.holes, &moves)?;
+        if refereed != board.in_the_bag + set.sum() {
+            return Err(format!(
+                "game {} {:?}: the moves score {refereed}, not ΣU* + the promotions = {} + {}",
+                r.n,
+                r.holes,
+                board.in_the_bag,
+                set.sum()
+            ));
+        }
+        (score, left) = (Some(refereed), after);
+    }
+    Ok(Answer {
+        ustar,
+        in_the_bag: board.in_the_bag,
+        promotions: promotions.map(|set| set.to_vec()),
+        score,
+        moves,
+        left,
+        completed,
+        nodes,
+        seconds: started.elapsed().as_secs_f64(),
+        empty_frames,
+    })
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// The oracles
+
+/// The heaviest set L of `pool` with `ustar ∪ fixed ∪ L` playable on the board of `t` (L holding `fixed`), as its
+/// sum, by a walk over the playable sets (a set that holds an unplayable set is unplayable); `None` if `ustar ∪ fixed`
+/// is unplayable.  Shares nothing with the frames or the search.
+fn heaviest(t: &Tables, ustar: &[u32], pool: &[u32], fixed: &[u32]) -> Option<u64> {
+    fn walk(t: &Tables, set: &mut Vec<u32>, pool: &[u32], from: usize, sum: u64, best: &mut u64) {
+        *best = (*best).max(sum);
+        for i in from..pool.len() {
+            set.push(pool[i]);
+            if playable(t, set) {
+                walk(t, set, pool, i + 1, sum + u64::from(pool[i]), best);
+            }
+            set.pop();
+        }
+    }
+    let mut set: Vec<u32> = ustar.iter().chain(fixed).copied().collect();
+    if !playable(t, &set) {
+        return None;
+    }
+    let mut best = 0;
+    walk(t, &mut set, pool, 0, fixed.iter().map(|&x| u64::from(x)).sum(), &mut best);
+    Some(best)
+}
+
+/// Descending greedy over the sources of the board of `t` (its numbers above n/2), each kept if it is playable with
+/// those kept: U\* by its definition (sources.md), ascending.
+fn greedy_ustar(t: &Tables) -> Vec<u32> {
+    let mut kept = Vec::new();
+    for s in (t.n / 2 + 1..=t.n).rev().filter(|&s| s >= 2 && t.on_board(s)) {
+        kept.push(s);
+        if !playable(t, &kept) {
+            kept.pop();
+        }
+    }
+    kept.sort_unstable();
+    kept
+}
+
+/// The numbers of the board of `t` up to n/2, from 2.
+fn lower_half(t: &Tables) -> Vec<u32> {
+    (2..=t.n / 2).filter(|&x| t.on_board(x)).collect()
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Running many cases
+
+/// `cases` run on `threads` threads, each by `check`, whose lines come back in the order of the cases.
+fn run_all<C: Sync>(cases: &[C], threads: usize, check: impl Fn(&C) -> String + Sync) -> Vec<String> {
+    let next = AtomicUsize::new(0);
+    let lines = Mutex::new(vec![String::new(); cases.len()]);
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| loop {
+                let i = next.fetch_add(1, Ordering::Relaxed);
+                if i >= cases.len() {
+                    break;
+                }
+                let line = check(&cases[i]);
+                lines.lock().unwrap()[i] = line;
+            });
+        }
+    });
+    lines.into_inner().unwrap()
+}
+
+/// A search of one small case: one thread, no progress lines.
+fn small(tactics: SearchTactics) -> Run {
+    Run { tactics, threads: 1, background: false, time_limit: None, progress: None }
+}
+
+/// The counts of a check, by name, in the order first met.
+#[derive(Default)]
+struct Counts(Vec<(String, u64)>);
+
+impl Counts {
+    fn add(&mut self, name: &str) {
+        match self.0.iter_mut().find(|(known, _)| known == name) {
+            Some((_, count)) => *count += 1,
+            None => self.0.push((name.to_owned(), 1)),
+        }
+    }
+
+    fn line(&self) -> String {
+        self.0.iter().map(|(name, count)| format!("{name} {count}")).collect::<Vec<_>>().join(", ")
+    }
+}
+
+/// Prints the lines of a check and its counts: each line is `tag rest`, and the tags are counted.
+fn report(lines: &[String]) {
+    let mut counts = Counts::default();
+    for line in lines {
+        println!("{line}");
+        for tag in line.split_whitespace().filter(|word| word.starts_with('#')) {
+            counts.add(tag);
+        }
+    }
+    println!("cases {}: {}", lines.len(), counts.line());
+}
+
+/// `check-holes LO HI`: see the module documentation.
+fn check_holes(lo: u32, hi: u32, sets: usize, threads: usize) {
+    let mut cases: Vec<(u32, Vec<u32>)> = Vec::new();
+    let mut rng = Rng(0x5EED_0F_4015);
+    for n in lo..=hi {
+        cases.push((n, Vec::new()));
+        cases.extend((1..=n).map(|z| (n, vec![z])));
+        for size in [2, 3] {
+            let mut drawn: Vec<Vec<u32>> = Vec::new();
+            for _ in 0..sets * 20 {
+                if drawn.len() == sets || n < size {
+                    break;
+                }
+                let mut holes: Vec<u32> = (0..size).map(|_| 1 + rng.below(n as usize) as u32).collect();
+                holes.sort_unstable();
+                holes.dedup();
+                if holes.len() == size as usize && !drawn.contains(&holes) {
+                    drawn.push(holes);
+                }
+            }
+            cases.extend(drawn.into_iter().map(|holes| (n, holes)));
+        }
+    }
+    let table = Optimal::built_in();
+    let lines = run_all(&cases, threads, |(n, holes)| {
+        let (n, r) = (*n, Restricted { n: *n, holes: holes.clone(), ..Restricted::default() });
+        let answer = match solve(&r, small(SearchTactics::default())) {
+            Ok(answer) => answer,
+            Err(e) => return format!("n={n} holes={holes:?} #error {e}"),
+        };
+        let t = Tables::with_holes(n, holes).expect("the holes were accepted");
+        let frame = answer.score.expect("a board with holes has a set: the empty one");
+        let x9 = answer.in_the_bag + heaviest(&t, &answer.ustar, &lower_half(&t), &[]).expect("U* is playable");
+        let best = brute::solve_by(n, holes, Rule::MaximalFactor).score;
+        let divisor = brute::solve(n, holes).score;
+        let mut tags = vec![if frame == x9 { "#x9-agrees" } else { "#x9-MISMATCH" }];
+        tags.push(if frame == best { "#best-agrees" } else { "#best-differs" });
+        tags.push(if greedy_ustar(&t) == answer.ustar { "#ustar-agrees" } else { "#ustar-MISMATCH" });
+        if !answer.left.is_empty() {
+            tags.push("#moves-left");
+        }
+        if divisor != best {
+            tags.push("#divisor-rule-differs");
+        }
+        if answer.empty_frames > 0 {
+            tags.push("#empty-frame");
+        }
+        if holes.is_empty() {
+            tags.push(if table.score(n) == Some(frame) { "#table-agrees" } else { "#table-MISMATCH" });
+        }
+        format!("n={n} holes={holes:?} frame={frame} x9={x9} best={best} divisor={divisor} {}", tags.join(" "))
+    });
+    report(&lines);
+}
+
+/// `check-bars LO HI`: see the module documentation.
+fn check_bars(lo: u32, hi: u32, threads: usize) {
+    let tactics = SearchTactics { symmetry: false, ..SearchTactics::default() };
+    let mut cases: Vec<Restricted> = Vec::new();
+    for n in lo..=hi {
+        let board = taxman::with_width!(n, W => Board::<W>::for_n(n).candidates().to_vec());
+        let one = |barred: Vec<u32>, fixed: Vec<u32>| Restricted { n, holes: Vec::new(), barred, fixed };
+        for &x in &board {
+            cases.push(one(vec![x], Vec::new()));
+            cases.push(one(Vec::new(), vec![x]));
+            cases.extend(board.iter().filter(|&&y| y != x).map(|&y| one(vec![x], vec![y])));
+        }
+        if let Some(y) = (2..=n / 2).find(|y| !board.contains(y)) {
+            cases.push(one(vec![y], Vec::new()));
+        }
+    }
+    let lines = run_all(&cases, threads, |r| {
+        let n = r.n;
+        let t = Tables::new(n);
+        let candidates = taxman::with_width!(n, W => Board::<W>::for_n(n).candidates().to_vec());
+        let what = format!("n={n} bar={:?} fix={:?}", r.barred, r.fixed);
+        let answer = match solve(r, small(tactics)) {
+            Ok(answer) => answer,
+            Err(e) if r.barred.iter().chain(&r.fixed).any(|x| !candidates.contains(x)) => {
+                return format!("{what} #refused-a-non-candidate ({e})");
+            }
+            Err(e) => return format!("{what} #error {e}"),
+        };
+        let pool: Vec<u32> = lower_half(&t).into_iter().filter(|x| !r.barred.contains(x) && !r.fixed.contains(x)).collect();
+        let oracle = heaviest(&t, &answer.ustar, &pool, &r.fixed).map(|sum| answer.in_the_bag + sum);
+        let tag = if answer.score == oracle { "#agrees" } else { "#MISMATCH" };
+        let shown = |score: Option<u64>| score.map_or_else(|| "none".to_owned(), |s| s.to_string());
+        format!("{what} frame={} oracle={} {tag}", shown(answer.score), shown(oracle))
+    });
+    report(&lines);
+}
+
+/// `check-chain N...`: see the module documentation.
+fn check_chain(games: &[u32], threads: usize) {
+    let tactics = SearchTactics { symmetry: false, ..SearchTactics::default() };
+    let run = Run { threads, ..small(tactics) };
+    let table = Optimal::built_in();
+    let mut lines = Vec::new();
+    for &n in games {
+        let opt = table.score(n).expect("a game of the table");
+        let recorded = taxman::with_width!(n, W => Board::<W>::for_n(n).seed(table.moves(n).unwrap()).to_vec());
+        let one = |barred: Vec<u32>, fixed: Vec<u32>| Restricted { n, holes: Vec::new(), barred, fixed };
+        let all = solve(&one(Vec::new(), recorded.clone()), run).expect("the recorded set fixed");
+        let tag = if all.score == Some(opt) { "#all-fixed-scores-opt" } else { "#all-fixed-MISMATCH" };
+        lines.push(format!("n={n} fix={recorded:?} score={:?} opt={opt} {tag}", all.score));
+        for &x in &recorded {
+            let barred = solve(&one(vec![x], Vec::new()), run).expect("a member of the recorded set barred");
+            let tag = if barred.score.is_some_and(|s| s <= opt) { "#barred-at-most-opt" } else { "#barred-ABOVE-OPT" };
+            let below = barred.score.map(|s| opt as i64 - s as i64);
+            lines.push(format!("n={n} bar=[{x}] score={:?} opt={opt} below={below:?} {tag}", barred.score));
+        }
+    }
+    report(&lines);
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// The command line
+
+/// The value of `--name`, if given.
+fn value<'a>(args: &'a [String], name: &str) -> Option<&'a str> {
+    args.iter().position(|a| a == name).map(|i| args.get(i + 1).expect("a flag's value").as_str())
+}
+
+/// The numbers of `--name A,B,...`, none if it is not given.
+fn numbers(args: &[String], name: &str) -> Vec<u32> {
+    value(args, name).map_or_else(Vec::new, |list| {
+        list.split(',').filter(|s| !s.is_empty()).map(|s| s.trim().parse().expect("a number")).collect()
+    })
+}
+
+fn count(args: &[String], name: &str, default: usize) -> usize {
+    value(args, name).map_or(default, |text| text.parse().expect("a count"))
+}
+
+fn json_list(items: &[u32]) -> String {
+    format!("[{}]", items.iter().map(u32::to_string).collect::<Vec<_>>().join(","))
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let positional = |i: usize| -> u32 { args[i].parse().expect("a number") };
+    match args.first().map(String::as_str) {
+        Some("solve") => {
+            let r = Restricted {
+                n: positional(1),
+                holes: numbers(&args, "--holes"),
+                barred: numbers(&args, "--bar"),
+                fixed: numbers(&args, "--fix"),
+            };
+            let mut tactics = Tactics::default();
+            for (i, _) in args.iter().enumerate().filter(|(_, a)| *a == "--tactic") {
+                tactics.set(&args[i + 1]).unwrap_or_else(|e| panic!("{e}"));
+            }
+            let run = Run {
+                tactics: tactics.search,
+                threads: count(&args, "--threads", 1),
+                background: args.iter().any(|a| a == "--background"),
+                time_limit: value(&args, "--time-limit").map(|s| Duration::from_secs_f64(s.parse().expect("seconds"))),
+                progress: Some(Duration::from_secs(60)),
+            };
+            let answer = match solve(&r, run) {
+                Ok(answer) => answer,
+                Err(e) => {
+                    eprintln!("error: {e}");
+                    std::process::exit(1);
+                }
+            };
+            let in_ustar: Vec<String> = numbers(&args, "--in-ustar")
+                .iter()
+                .map(|x| format!("\"{x}\":{}", answer.ustar.contains(x)))
+                .collect();
+            let promotions = answer.promotions.as_deref().map_or("null".to_owned(), json_list);
+            let score = answer.score.map_or("null".to_owned(), |s| s.to_string());
+            let promotion_sum = answer.promotions.as_ref().map_or(0, |set| set.iter().map(|&x| u64::from(x)).sum());
+            let shown = if args.iter().any(|a| a == "--show") {
+                format!(",\"moves\":{},\"ustar\":{}", json_list(&answer.moves), json_list(&answer.ustar))
+            } else {
+                String::new()
+            };
+            println!(
+                "{{\"n\":{},\"holes\":{},\"bar\":{},\"fix\":{},\"tactics\":\"{}\",\"threads\":{},\"in_the_bag\":{},\
+                 \"promotion_sum\":{promotion_sum},\"score\":{score},\"completed\":{},\"nodes\":{},\"seconds\":{:.3},\
+                 \"promotions\":{promotions},\"moves_left\":{},\"empty_frames\":{},\"in_ustar\":{{{}}}{shown}}}",
+                r.n,
+                json_list(&r.holes),
+                json_list(&r.barred),
+                json_list(&r.fixed),
+                tactics.description(),
+                run.threads,
+                answer.in_the_bag,
+                answer.completed,
+                answer.nodes,
+                answer.seconds,
+                json_list(&answer.left),
+                answer.empty_frames,
+                in_ustar.join(","),
+            );
+        }
+        Some("check-holes") => check_holes(positional(1), positional(2), count(&args, "--sets", 3), count(&args, "--threads", 1)),
+        Some("check-bars") => check_bars(positional(1), positional(2), count(&args, "--threads", 1)),
+        Some("check-chain") => {
