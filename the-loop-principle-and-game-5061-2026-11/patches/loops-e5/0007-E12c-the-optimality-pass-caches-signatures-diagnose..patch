Subject: [PATCH 7/9] E12c: the optimality pass caches signatures; diagnose.py
 works with the integer rays

---
 lab/work/loops/e12/diagnose.py   |  6 ++++--
 lab/work/loops/e12/window_law.py | 15 ++++++++++++---
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/lab/work/loops/e12/diagnose.py b/lab/work/loops/e12/diagnose.py
index d32e956..6e5fe01 100644
--- a/lab/work/loops/e12/diagnose.py
+++ b/lab/work/loops/e12/diagnose.py
@@ -9,6 +9,7 @@ import json
 import os
 import re
 import sys
+from fractions import Fraction
 
 HERE = os.path.dirname(os.path.abspath(__file__))
 sys.path.insert(0, HERE)
@@ -26,7 +27,7 @@ def main():
     n = w.n
     fixed_old = [n] + [x for x in w.sources if x != n]
     fixed_new = [x for x in w.sources if x != n]
-    nval = [c * ray[0] for ray in w.rays]
+    nval = [c * ray[0] for ray in w.irays]
     rowname = {i: k for k, i in w.rbit.items()}
 
     def rows_of(mask):
@@ -56,7 +57,8 @@ def main():
             sn = w.signatures(Wn)
             bad = [(r1, r2) for r1, r2 in sn if not w.dominated({(r1, r2)}, so)]
             minimal = [b for b in bad if not any(o != b and (o[0] | o[1]) & ~(b[0] | b[1]) == 0 for o in bad)]
-            print(f"   witness {w.label(Cn) or '-'} (slack {slack}): {len(bad)} undominated parts; smallest: "
+            print(f"   witness {w.label(Cn) or '-'} (slack {Fraction(slack, w.scale)}): {len(bad)} undominated parts; "
+                  f"smallest: "
                   + "; ".join(f"rows {rows_of(r1 | r2)} once {rows_of(r1)}" for r1, r2 in minimal[:4]))
 
 
diff --git a/lab/work/loops/e12/window_law.py b/lab/work/loops/e12/window_law.py
index d8bd357..d7ba9b5 100644
--- a/lab/work/loops/e12/window_law.py
+++ b/lab/work/loops/e12/window_law.py
@@ -331,12 +331,21 @@ def run(family, sources_fixed=True, table=None, local=None, not_held=()):
     excluded, really_open = [], []
     if open_:
         ups = [(C, W0, w.weight_at(W0)) for C, W0 in states]
+        sigs_old = {}
+
+        def sig_of(Z):
+            key = tuple(sorted(Z))
+            if key not in sigs_old:
+                sigs_old[key] = w.signatures(Z)
+            return sigs_old[key]
         for C, W0 in open_:
             w0 = w.weight_at(W0)
-            sig_old = w.signatures(W0)
+            sig_old = sig_of(W0)
             better = None
-            for Cp, Wp, wp in sorted(ups, key=lambda t: -min(t[2][i] - w0[i] for i in range(len(w.rays)))):
-                if all(wp[i] > w0[i] for i in range(len(w.rays))) and w.dominated(w.signatures(Wp), sig_old):
+            memo = {}
+            heavier = [t for t in ups if all(t[2][i] > w0[i] for i in range(len(w.rays)))]
+            for Cp, Wp, wp in sorted(heavier, key=lambda t: -min(t[2][i] - w0[i] for i in range(len(w.rays)))):
+                if w.dominated(sig_of(Wp), sig_old, memo):
                     better = Cp
                     break
             (excluded if better else really_open).append((C, better))
