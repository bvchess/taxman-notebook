@@ -0,0 +1,478 @@
+//! The odd cores of the window instance (an experiment of the loops study, E7): `windowcores C D OUT [THREADS]
+//! [--hubs-removable]`.  A port of the lab's `e7/window_cores.py` (the same search, rows from the top down), to reach
+//! larger windows; it uses nothing of the prover.
+//!
+//! The window instance for a cofactor c and depth d: d + 1 clean columns j = 0..d, each holding the rows 1..c; the
+//! cell (k, j) = k·P_j lists its column factors (k/q, j), one for each prime q dividing k, and its hub k, which every
+//! cell of row k lists.  A column factor is listed only by cells of its own column.  The members are the cells of the
+//! composite rows (a layer-2 member of a core makes the core's layer-2 part a core of two-factor members, which is
+//! never odd, by P11).  A column factor of a prime row is always in the pool; one of a composite row is in the pool
+//! unless its cell is a move; a hub is in the pool (with --hubs-removable it may also be left out).
+//!
+//! Enumerated: every pair (T, X) of disjoint sets of cells, T nonempty, X the moves outside T, kept to cells that a
+//! member of T lists, such that T is a core of the instance whose pool leaves out T and X (each factor a member of T
+//! lists is listed by another) and the lists of T are independent over GF(2): the odd cores.  Rows are decided from c
+//! down, all columns of a row at once, each cell in T, in X or neither; each core condition is checked when its
+//! factor's row is reached (for the prime factors, after their lowest lister's row), and at every step the lists of
+//! the members so far, with each factor not yet decided counted as in the pool, must be independent (deciding a
+//! factor later deletes its coordinate from every list, a projection, which keeps any dependency).  Columns are
+//! interchangeable: only assignments whose columns, read down the rows, are in nondecreasing order are kept.
+//!
+//! The nodes after the first rows are tasks, shared among the threads.  OUT gets a JSON line per odd core, with its
+//! task, and OUT.done the number of each finished task, so that a run stopped part way resumes: the lines of
+//! unfinished tasks are dropped and those tasks run again.
+
+use std::collections::HashSet;
+use std::fs::{File, OpenOptions};
+use std::io::{BufRead, BufReader, Write};
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::Mutex;
+use std::time::Instant;
+
+const T: u8 = 0;
+const X: u8 = 1;
+const O: u8 = 2;
+const NONE: u8 = 3;
+const W: usize = 4;
+type Vector = [u64; W];
+
+fn primes_of(mut k: u32) -> Vec<u32> {
+    let mut out = Vec::new();
+    let mut p = 2;
+    while p * p <= k {
+        if k % p == 0 {
+            out.push(p);
+            while k % p == 0 {
+                k /= p;
+            }
+        }
+        p += 1;
+    }
+    if k > 1 {
+        out.push(k);
+    }
+    out
+}
+
+fn omega(mut k: u32) -> u32 {
+    let (mut n, mut p) = (0, 2);
+    while p * p <= k {
+        while k % p == 0 {
+            k /= p;
+            n += 1;
+        }
+        p += 1;
+    }
+    n + u32::from(k > 1)
+}
+
+struct Window {
+    cols: usize,
+    removable: bool,
+    /// Composite rows, descending.
+    rows: Vec<u32>,
+    row_index: Vec<usize>,
+    composite: Vec<bool>,
+    factors: Vec<Vec<u32>>,
+    listers: Vec<Vec<u32>>,
+    /// For row index i: the primes whose lowest lister is rows[i].
+    prime_check: Vec<Vec<u32>>,
+    /// Bit of the column factor (f, j): fbit[f] + j; of hub k: hbit[k].
+    fbit: Vec<usize>,
+    hbit: Vec<usize>,
+}
+
+impl Window {
+    fn new(c: u32, d: u32, removable: bool) -> Self {
+        let cols = d as usize + 1;
+        let size = c as usize + 1;
+        let rows: Vec<u32> = (2..=c).rev().filter(|&k| omega(k) >= 2).collect();
+        let mut row_index = vec![usize::MAX; size];
+        rows.iter().enumerate().for_each(|(i, &k)| row_index[k as usize] = i);
+        let mut composite = vec![false; size];
+        rows.iter().for_each(|&k| composite[k as usize] = true);
+        let mut factors = vec![Vec::new(); size];
+        let mut listers = vec![Vec::new(); size];
+        for &k in &rows {
+            factors[k as usize] = primes_of(k).into_iter().map(|q| k / q).collect();
+            for &f in &factors[k as usize] {
+                listers[f as usize].push(k);
+            }
+        }
+        let mut prime_check = vec![Vec::new(); rows.len()];
+        for p in 2..=c {
+            if omega(p) == 1 && !listers[p as usize].is_empty() {
+                let lowest = *listers[p as usize].iter().min().unwrap();
+                prime_check[row_index[lowest as usize]].push(p);
+            }
+        }
+        let mut next = 0;
+        let mut fbit = vec![usize::MAX; size];
+        for f in 1..=c as usize {
+            if !listers[f].is_empty() {
+                fbit[f] = next;
+                next += cols;
+            }
+        }
+        let mut hbit = vec![usize::MAX; size];
+        for &k in rows.iter().rev() {
+            hbit[k as usize] = next;
+            next += 1;
+        }
+        assert!(next <= 64 * W, "too many coordinates: {next}");
+        Window { cols, removable, rows, row_index, composite, factors, listers, prime_check, fbit, hbit }
+    }
+}
+
+#[derive(Clone)]
+struct Search<'a> {
+    w: &'a Window,
+    /// state[row index * cols + column]
+    state: Vec<u8>,
+    hub_out: Vec<bool>,
+    equal: Vec<bool>,
+    nodes: u64,
+}
+
+fn set_bit(v: &mut Vector, b: usize) {
+    v[b / 64] |= 1 << (b % 64);
+}
+
+fn is_zero(v: &Vector) -> bool {
+    v.iter().all(|&x| x == 0)
+}
+
+fn top_bit(v: &Vector) -> usize {
+    for i in (0..W).rev() {
+        if v[i] != 0 {
+            return i * 64 + 63 - v[i].leading_zeros() as usize;
+        }
+    }
+    usize::MAX
+}
+
+fn independent(vectors: &[Vector]) -> bool {
+    let mut basis: Vec<(usize, Vector)> = Vec::with_capacity(vectors.len());
+    for v in vectors {
+        let mut v = *v;
+        loop {
+            if is_zero(&v) {
+                return false;
+            }
+            let p = top_bit(&v);
+            match basis.iter().find(|(q, _)| *q == p) {
+                Some((_, b)) => {
+                    for i in 0..W {
+                        v[i] ^= b[i];
+                    }
+                }
+                None => {
+                    basis.push((p, v));
+                    break;
+                }
+            }
+        }
+    }
+    true
+}
+
+/// A found odd core: its cells (row, column) in T and in X, the hubs left out, and whether T + X is independent.
+struct Found {
+    t: Vec<(u32, usize)>,
+    x: Vec<(u32, usize)>,
+    hubs_out: Vec<u32>,
+    t_plus_x_independent: bool,
+}
+
+impl<'a> Search<'a> {
+    fn new(w: &'a Window) -> Self {
+        Search {
+            w,
+            state: vec![NONE; w.rows.len() * w.cols],
+            hub_out: vec![false; w.rows.len()],
+            equal: vec![true; w.cols.saturating_sub(1)],
+            nodes: 0,
+        }
+    }
+
+    fn st(&self, k: u32, j: usize) -> u8 {
+        self.state[self.w.row_index[k as usize] * self.w.cols + j]
+    }
+
+    fn tcount(&self, f: u32, j: usize) -> usize {
+        self.w.listers[f as usize].iter().filter(|&&k| self.st(k, j) == T).count()
+    }
+
+    /// The list of (k, j); a factor whose row is undecided counts as in the pool.
+    fn vector(&self, k: u32, j: usize) -> Vector {
+        let w = self.w;
+        let mut v = [0u64; W];
+        for &f in &w.factors[k as usize] {
+            if !w.composite[f as usize] || matches!(self.st(f, j), O | NONE) {
+                set_bit(&mut v, w.fbit[f as usize] + j);
+            }
+        }
+        if !self.hub_out[w.row_index[k as usize]] {
+            set_bit(&mut v, w.hbit[k as usize]);
+        }
+        v
+    }
+
+    fn members(&self, upto: usize, want: u8) -> Vec<(u32, usize)> {
+        let w = self.w;
+        let mut out = Vec::new();
+        for i in 0..upto {
+            for j in 0..w.cols {
+                if self.state[i * w.cols + j] == want {
+                    out.push((w.rows[i], j));
+                }
+            }
+        }
+        out
+    }
+
+    fn choices(&self, i: usize) -> Vec<Vec<u8>> {
+        let w = self.w;
+        let k = w.rows[i];
+        let options: Vec<Vec<u8>> = (0..w.cols)
+            .map(|j| {
+                let cnt = self.tcount(k, j);
+                let mut o = vec![T];
+                if cnt >= 1 {
+                    o.push(X);
+                }
+                if cnt != 1 {
+                    o.push(O);
+                }
+                o
+            })
+            .collect();
+        let mut out = Vec::new();
+        let mut acc = Vec::with_capacity(w.cols);
+        fn rec(j: usize, options: &[Vec<u8>], equal: &[bool], acc: &mut Vec<u8>, out: &mut Vec<Vec<u8>>) {
+            if j == options.len() {
+                out.push(acc.clone());
+                return;
+            }
+            for &s in &options[j] {
+                if j > 0 && equal[j - 1] && s < acc[j - 1] {
+                    continue;
+                }
+                acc.push(s);
+                rec(j + 1, options, equal, acc, out);
+                acc.pop();
+            }
+        }
+        rec(0, &options, &self.equal, &mut acc, &mut out);
+        out
+    }
+
+    /// Applies `choice` (and the hub mode) at row i; true if the conditions checked there hold.
+    fn apply(&mut self, i: usize, choice: &[u8], removed: bool) -> bool {
+        let w = self.w;
+        for (j, &s) in choice.iter().enumerate() {
+            self.state[i * w.cols + j] = s;
+        }
+        self.hub_out[i] = removed;
+        for &p in &w.prime_check[i] {
+            if (0..w.cols).any(|j| self.tcount(p, j) == 1) {
+                return false;
+            }
+        }
+        let members = self.members(i + 1, T);
+        let vectors: Vec<Vector> = members.iter().map(|&(k, j)| self.vector(k, j)).collect();
+        independent(&vectors)
+    }
+
+    fn undo(&mut self, i: usize) {
+        let cols = self.w.cols;
+        self.state[i * cols..(i + 1) * cols].fill(NONE);
+        self.hub_out[i] = false;
+    }
+
+    /// The (choice, removed) pairs to try at row i.
+    fn moves(&self, i: usize) -> Vec<(Vec<u8>, bool)> {
+        let mut out = Vec::new();
+        for choice in self.choices(i) {
+            let nt = choice.iter().filter(|&&s| s == T).count();
+            if nt != 1 {
+                out.push((choice.clone(), false));
+            }
+            if self.w.removable && nt >= 1 {
+                out.push((choice, true));
+            }
+        }
+        out
+    }
+
+    fn descend(&mut self, i: usize, choice: &[u8]) -> Vec<bool> {
+        let saved = self.equal.clone();
+        for j in 0..self.w.cols.saturating_sub(1) {
+            self.equal[j] = self.equal[j] && choice[j] == choice[j + 1];
+        }
+        let _ = i;
+        saved
+    }
+
+    fn search(&mut self, i: usize, found: &mut Vec<Found>) {
+        self.nodes += 1;
+        if i == self.w.rows.len() {
+            let t = self.members(i, T);
+            if !t.is_empty() {
+                let x = self.members(i, X);
+                let vectors: Vec<Vector> = t.iter().chain(x.iter()).map(|&(k, j)| self.vector(k, j)).collect();
+                let hubs_out = (0..i).filter(|&r| self.hub_out[r]).map(|r| self.w.rows[r]).collect();
+                found.push(Found { t, x, hubs_out, t_plus_x_independent: independent(&vectors) });
+            }
+            return;
+        }
+        for (choice, removed) in self.moves(i) {
+            if self.apply(i, &choice, removed) {
+                let saved = self.descend(i, &choice);
+                self.search(i + 1, found);
+                self.equal = saved;
+            }
+            self.undo(i);
+        }
+    }
+
+    /// The nodes at row index `depth` (each with the choices made above it), in a fixed order.
+    fn tasks(&mut self, i: usize, depth: usize, path: &mut Vec<(Vec<u8>, bool)>, out: &mut Vec<Vec<(Vec<u8>, bool)>>) {
+        if i == depth || i == self.w.rows.len() {
+            out.push(path.clone());
+            return;
+        }
+        for (choice, removed) in self.moves(i) {
+            if self.apply(i, &choice, removed) {
+                let saved = self.descend(i, &choice);
+                path.push((choice.clone(), removed));
+                self.tasks(i + 1, depth, path, out);
+                path.pop();
+                self.equal = saved;
+            }
+            self.undo(i);
+        }
+    }
+}
+
+fn json(f: &Found, task: usize, c: u32, d: u32) -> String {
+    let cells = |v: &[(u32, usize)]| v.iter().map(|(k, j)| format!("[{k},{j}]")).collect::<Vec<_>>().join(",");
+    let hubs = f.hubs_out.iter().map(u32::to_string).collect::<Vec<_>>().join(",");
+    format!(
+        "{{\"c\":{c},\"d\":{d},\"task\":{task},\"T\":[{}],\"X\":[{}],\"hubs_out\":[{hubs}],\"T_plus_X_independent\":{}}}",
+        cells(&f.t),
+        cells(&f.x),
+        f.t_plus_x_independent
+    )
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let removable = args.iter().any(|a| a == "--hubs-removable");
+    let pos: Vec<&String> = args.iter().filter(|a| !a.starts_with("--")).collect();
+    let c: u32 = pos[0].parse().expect("C");
+    let d: u32 = pos[1].parse().expect("D");
+    let out_path = pos[2].clone();
+    let threads: usize = pos.get(3).map_or(8, |t| t.parse().expect("THREADS"));
+    let w = Window::new(c, d, removable);
+
+    // Tasks: the nodes a few rows down, enough to share among the threads.
+    let mut depth = 0;
+    let mut tasks = Vec::new();
+    while depth < w.rows.len() {
+        depth += 1;
+        tasks.clear();
+        Search::new(&w).tasks(0, depth, &mut Vec::new(), &mut tasks);
+        if tasks.len() >= 200 * threads {
+            break;
+        }
+    }
+
+    // Resume: keep the lines of finished tasks only.
+    let done_path = format!("{out_path}.done");
+    let done: HashSet<usize> = File::open(&done_path)
+        .map(|f| BufReader::new(f).lines().map_while(Result::ok).filter_map(|l| l.trim().parse().ok()).collect())
+        .unwrap_or_default();
+    let kept: Vec<String> = File::open(&out_path)
+        .map(|f| {
+            BufReader::new(f)
+                .lines()
+                .map_while(Result::ok)
+                .filter(|l| {
+                    let at = l.find("\"task\":").map(|a| a + 7);
+                    at.and_then(|a| l[a..].split(',').next()?.parse::<usize>().ok()).is_some_and(|t| done.contains(&t))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let mut out = File::create(&out_path).expect("OUT");
+    for l in &kept {
+        writeln!(out, "{l}").unwrap();
+    }
+    let out = Mutex::new(out);
+    let done_file = Mutex::new(OpenOptions::new().create(true).append(true).open(&done_path).expect("OUT.done"));
+    eprintln!(
+        "(c, d) = ({c}, {d}){}: {} composite rows x {} columns; {} tasks at depth {depth}, {} done before",
+        if removable { ", hubs removable" } else { "" },
+        w.rows.len(),
+        w.cols,
+        tasks.len(),
+        done.len()
+    );
+
+    let next = AtomicUsize::new(0);
+    let nodes = AtomicU64::new(0);
+    let cores = AtomicU64::new(kept.len() as u64);
+    let finished = AtomicUsize::new(done.len());
+    let t0 = Instant::now();
+    std::thread::scope(|s| {
+        for _ in 0..threads {
+            s.spawn(|| loop {
+                let at = next.fetch_add(1, Ordering::Relaxed);
+                if at >= tasks.len() {
+                    break;
+                }
+                if done.contains(&at) {
+                    continue;
+                }
+                let mut search = Search::new(&w);
+                let mut ok = true;
+                for (i, (choice, removed)) in tasks[at].iter().enumerate() {
+                    ok &= search.apply(i, choice, *removed);
+                    search.descend(i, choice);
+                }
+                assert!(ok, "task {at} no longer applies");
+                let mut found = Vec::new();
+                search.search(tasks[at].len(), &mut found);
+                {
+                    let mut o = out.lock().unwrap();
+                    for f in &found {
+                        writeln!(o, "{}", json(f, at, c, d)).unwrap();
+                    }
+                    o.flush().unwrap();
+                }
+                writeln!(done_file.lock().unwrap(), "{at}").unwrap();
+                nodes.fetch_add(search.nodes, Ordering::Relaxed);
+                cores.fetch_add(found.len() as u64, Ordering::Relaxed);
+                let n = finished.fetch_add(1, Ordering::Relaxed) + 1;
+                if n % (tasks.len() / 20).max(1) == 0 {
+                    eprintln!(
+                        "  {n}/{} tasks, {} nodes, {} odd cores, {:.0} s",
+                        tasks.len(),
+                        nodes.load(Ordering::Relaxed),
+                        cores.load(Ordering::Relaxed),
+                        t0.elapsed().as_secs_f64()
+                    );
+                }
+            });
+        }
+    });
+    println!(
+        "{{\"c\":{c},\"d\":{d},\"hubs_removable\":{removable},\"tasks\":{},\"nodes_this_run\":{},\"odd_cores\":{},\
+         \"secs\":{:.1}}}",
+        tasks.len(),
+        nodes.load(Ordering::Relaxed),
+        cores.load(Ordering::Relaxed),
+        t0.elapsed().as_secs_f64()
+    );
+}
