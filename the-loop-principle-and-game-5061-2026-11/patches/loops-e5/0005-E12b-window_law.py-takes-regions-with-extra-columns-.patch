+def extra_prime(rule, P):
+    kind, arg = rule
+    if kind == "le":
+        q = int(arg * P)
+        while not predict.is_prime(q):
+            q -= 1
+        return q
+    q = P
+    for _ in range(arg):
+        q += 1
+        while not predict.is_prime(q):
+            q += 1
+    return q
+
